#!/usr/bin/env zsh
# AIエージェント(claude/codex)の状態をpane単位で記録し,tmuxのwindowタブ色(@ai_state)に反映する
# tmux外で動くエージェントはsession_id単位(sid-*.state)で記録する(ai-bridgeの一覧用)
#
# 使い方:
#   ai-agent-state <agent> <event>            # claude/codexのhooksから呼ぶ(stdin: hook JSON)
#   ai-agent-state --focus-reset [window_id]  # tmuxのフックとai-bridgeから呼ぶ(doneをidleへ戻す)
#   ai-agent-state --reconcile-stuck          # ai-bridgeの描画ループから呼ぶ(取り残されたworking・blockedを倒す)
#
# イベントと状態の対応:
#   UserPromptSubmit / PreToolUse / PostToolUse / PostToolUseFailure -> working
#   PermissionRequest             -> blocked
#   Notification                  -> blocked (権限の確認を含む入力待ちの通知,matcherで対象を限定して登録する,作業中の時だけ)
#   Stop                          -> done (見ているペインならidle,サブエージェント等のAIの作業が裏で続いていればworking維持)
#   Interrupt                     -> done (見ているペインならidle,codexのEsc中断,中断したターンにはStopが来ない)
#   SessionStart                  -> idle (compact後は状態を変えない)
#   SessionEnd                    -> 状態クリア
set -eu

zmodload zsh/datetime
# 作業ログが大きくなったかを外部コマンドを使わずに調べる
zmodload -F zsh/stat b:zstat

if [[ -z ${AI_AGENTS_CONFIG_DIR_PATH:-} ]]; then
  print "$0: AI_AGENTS_CONFIG_DIR_PATH is not set"
  exit 1
fi

state_dir=$AI_AGENTS_CONFIG_DIR_PATH/state

# ターン終了時に,サブエージェント・チームメイト等のAIの作業がまだ裏で動いているか(stdin JSONのbackground_tasks)
# シェルのコマンド・監視・MCPのタスクはAIが結果を待っているだけなので含めない(sleepで待つ間をworkingにしないため)
__background_work_running() {
  print -r -- "$1" | jq -e '[.background_tasks[]? | select(.status == "running" and ((.type // "") | IN("shell", "monitor", "MCP task") | not))] | length > 0' >/dev/null 2>&1
}

# 状態ファイルの今の状態(tmux内は空白区切り,tmux外はタブ区切りで,どちらも先頭の欄,ファイルが無ければ空)
__current_state() {
  local state rest

  [[ -f $state_dir/$1.state ]] || return 0
  read -r state rest < "$state_dir/$1.state" || true
  print -r -- "$state"
}

# イベントから状態を決定する(Stopはstdin JSONのbackground_tasksを考慮,$3はペインIDかsid-<session_id>)
__resolve_state() {
  local event input key
  event=$1
  input=$2
  key=$3

  case $event in
    UserPromptSubmit | PreToolUse | PostToolUse | PostToolUseFailure)
      print working
      ;;
    PermissionRequest)
      print blocked
      ;;
    Notification)
      # 入力待ち通知はターン中(working)のみblockedにする
      # (ターン終了後にも入力待ち系の通知が発火しStop後のidle/doneを上書きしてしまうため)
      if [[ $(__current_state "$key") == working ]]; then
        print blocked
      fi
      ;;
    SessionStart)
      # 自動compact後にもSessionStartが発火する,その間も作業は継続しているため状態を変えない
      # (サブエージェント完了待ち等の無イベント区間でidle上書きが残留するのを防ぐ)
      if [[ $(print -r -- "$input" | jq -r '.source // empty' 2>/dev/null) != compact ]]; then
        print idle
      fi
      ;;
    Stop)
      # ターン終了時にAIの作業が裏で続いていればまだ作業中扱い
      if __background_work_running "$input"; then
        print working
      else
        __stop_state_for_pane "$key"
      fi
      ;;
    Interrupt)
      # codexはEscで中断したターンにStopを出さずInterruptを出すため,ここでターンを終える
      __stop_state_for_pane "$key"
      ;;
  esac
}

# ターン終了時の遷移先を返す(完了したpaneをユーザーが見ている(attached+カレントwindow+フォーカス中pane)なら確認済みとしてidle扱い)
# window粒度だと同一window内の別paneで動くサブエージェントの完了までidle扱いになるためpaneのフォーカスも条件に含める
# tmux外(sid-<session_id>)は見ているかを確かめようが無いのでいつもdone
__stop_state_for_pane() {
  local key
  key=$1

  if [[ $key == %* && $(tmux display-message -p -t "$key" '#{?#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}},1,0}' 2>/dev/null) == 1 ]]; then
    print idle
  else
    print done
  fi
}

# 状態ファイルへatomicに書き込む(内容: "<state> <agent> <pid>")
__write_state() {
  local pane_id state agent agent_pid tmp_file
  pane_id=$1
  state=$2
  agent=$3
  agent_pid=$4

  tmp_file=$(mktemp "$state_dir/.state.XXXXXX")
  print -r -- "$state $agent $agent_pid" > "$tmp_file"
  mv -f "$tmp_file" "$state_dir/$pane_id.state"
}

# ai-bridgeの作業ログ用に,指示・ツールの開始と完了(失敗を含む)・承認待ち・ターン終了(中断を含む)を1行ずつ追記する
# 一覧の下に「どのリポジトリで何をしているか」を出すための短い要約だけを残す(コマンドは説明があれば説明を使う)
# 形式: 時刻<TAB>種類(U=指示 P=開始 D=完了 F=失敗 W=承認待ち S=終了)<TAB>ツール<TAB>対象<TAB>補足<TAB>作業ディレクトリ
# 一覧にそのまま出すので,タブ・改行に限らず制御文字は空白にする(エスケープシーケンスで表示が崩れないように)
# 増え続けないよう,64KBを超えたら新しい200行だけを残す(今のターンの指示がそれより前にあれば,その行も残す)
__record_activity() {
  local activity_file event input kind line tmp_file
  local -a size
  activity_file=$1
  event=$2
  input=$3

  case $event in
    UserPromptSubmit) kind=U ;;
    PreToolUse) kind=P ;;
    PostToolUse) kind=D ;;
    # 失敗した時はPostToolUseが来ないため,失敗として残して実行中の表示を終わらせる
    PostToolUseFailure) kind=F ;;
    PermissionRequest) kind=W ;;
    Stop | Interrupt) kind=S ;;
    *) return 0 ;;
  esac

  line=$(print -r -- "$input" | jq -r --arg kind "$kind" --arg now "$EPOCHREALTIME" '
    def clip($n): if length > $n then .[0:$n] + "…" else . end;
    def flat: tostring | gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ");
    def text($v): if ($v | type) == "array" then ($v | map(tostring) | join(" ")) else ($v // "" | tostring) end;
    def files: [scan("\\*\\*\\* (?:Update|Add|Delete) File: ([^\\n]+)") | .[0]] | join(", ");
    def counts($l): "+\($l | map(select(startswith("+"))) | length) -\($l | map(select(startswith("-"))) | length)";
    (.tool_name // "") as $t
    | (.tool_input // {}) as $i
    | text($i.command // $i.cmd) as $cmd
    | (text($i.patch // $i.input) + "\n" + $cmd) as $patch
    | ($t == "Bash" or $t == "exec" or $t == "shell") as $shell
    | [
        $now, $kind, $t,
        ( if $kind == "U" then ([.prompt // "" | split("\n")[] | select(test("\\S"))][0] // "" | flat | clip(120))
          elif $kind == "S" then ""
          elif $shell then (($i.description // "") | flat) as $d | (if $d != "" then $d else ($cmd | flat | clip(100)) end)
          elif $t == "apply_patch" then ($patch | files | clip(120))
          elif $t == "Edit" or $t == "MultiEdit" or $t == "Write" or $t == "Read" then ($i.file_path // "")
          elif $t == "NotebookEdit" then ($i.notebook_path // "")
          elif $t == "Grep" or $t == "Glob" then ($i.pattern // "" | flat | clip(60))
          elif $t == "WebFetch" then ($i.url // "")
          elif $t == "WebSearch" then ($i.query // "" | flat | clip(80))
          elif $t == "Agent" or $t == "Task" then ($i.description // "" | flat | clip(80))
          elif $t == "Skill" then ($i.skill // "")
          elif $t == "AskUserQuestion" then ($i.questions[0].question // "" | flat | clip(100))
          elif $t == "TodoWrite" then ([$i.todos[]? | select(.status == "in_progress") | .activeForm // .content][0] // "" | flat | clip(100))
          elif ($t | startswith("mcp__")) then ([$i[]? | select(type == "string")][0] // "" | flat | clip(60))
          else "" end ),
        ( if $kind == "D" and ($t == "Edit" or $t == "MultiEdit" or $t == "Write") then
            [.tool_response.structuredPatch[]?.lines[]?] as $l
            | if ($l | length) > 0 then counts($l) elif $t == "Write" then "+\($i.content // "" | split("\n") | length) -0" else "" end
          elif $kind == "D" and $t == "apply_patch" then counts([$patch | split("\n")[] | select(test("^[+-]") and (test("^(\\+\\+\\+|---) ") | not))])
          elif $kind == "P" and $shell then ($cmd | flat | clip(160))
          elif $kind == "P" and ($t == "Agent" or $t == "Task") then ($i.subagent_type // "")
          else "" end ),
        (.cwd // "")
      ]
    | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\t")
  ' 2>/dev/null) || return 0
  [[ -n $line ]] || return 0
  # 指示やコマンドが入るので,状態ファイルと同じく本人だけが読めるようにして作る
  umask 077
  print -r -- "$line" >> "$activity_file"

  zstat -A size +size "$activity_file" 2>/dev/null || return 0
  if (( size[1] > 65536 )); then
    # 並んで動いた別のフックと一時ファイルを取り合わないよう,一時ファイルは毎回別の名前で作る
    tmp_file=$(mktemp "$state_dir/.activity.XXXXXX" 2>/dev/null) || return 0
    awk -F '\t' '
      { l[NR] = $0 }
      $2 == "U" && $4 !~ /^</ { u = NR }
      END {
        s = NR > 200 ? NR - 199 : 1
        if (u && u < s) print l[u]
        for (i = s; i <= NR; i++) print l[i]
      }
    ' "$activity_file" >| "$tmp_file" 2>/dev/null && mv -f "$tmp_file" "$activity_file" || rm -f "$tmp_file"
  fi
  return 0
}

# 判断待ちの項目(許可を待っているツール名)を記録し,判断待ち以外になったら消す(ai-bridgeが Input(Bash) のように添えて出す)
# 質問(AskUserQuestion)は許可の要らないツールのため,どのフックから判断待ちになっても分類できるよう出す直前のPreToolUseで記録する
# 通知から判断待ちになった時はツール名が無いので記録を変えず,記録が無ければ種類なしの Input になる
__record_wait() {
  local wait_file event state input tool
  wait_file=$1
  event=$2
  state=$3
  input=$4

  # PreToolUseは全てのツールで発火するため,質問を含む時だけjqでツール名を確かめる
  if [[ $event == PermissionRequest || ( $event == PreToolUse && $input == *AskUserQuestion* ) ]]; then
    tool=$(print -r -- "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)
    if [[ $event == PermissionRequest || $tool == AskUserQuestion ]]; then
      print -r -- "$tool" >| "$wait_file"
      return 0
    fi
  fi

  [[ $state == blocked ]] || rm -f "$wait_file"
}

# Codex hook入力からai-bridge用メタ情報をatomicに書き込む
# transcript形式は安定インターフェースではないため,token_countを取得できない場合は0へフォールバックする
__write_codex_meta() {
  local key input hook_meta transcript_path usage tmp_file
  key=$1
  input=$2

  hook_meta=$(print -r -- "$input" | jq -c '{model: (.model // "-"), transcript_path: (.transcript_path // null)}' 2>/dev/null) || return 0
  transcript_path=$(print -r -- "$hook_meta" | jq -r '.transcript_path // empty' 2>/dev/null)
  usage=$(
    if [[ -f $transcript_path ]]; then
      tail -r "$transcript_path" 2>/dev/null \
        | jq -Rrc '
            fromjson?
            | select(.type? == "event_msg" and .payload.type? == "token_count" and .payload.info? != null)
            | {
                cx_tok: (.payload.info.last_token_usage.input_tokens // 0),
                cx_window: (.payload.info.model_context_window // 0)
              }
          ' 2>/dev/null \
        | head -n 1
    fi
  )

  tmp_file=$(mktemp "$state_dir/.meta.XXXXXX" 2>/dev/null) || return 0
  if print -r -- "$hook_meta" | jq -c --argjson usage "${usage:-null}" '
    {
      model: .model,
      cx_tok: ($usage.cx_tok // 0),
      cx_pct: (
        if ($usage.cx_window // 0) > 0
        then ((($usage.cx_tok // 0) * 100 / $usage.cx_window) | floor)
        else 0
        end
      ),
      transcript_path: .transcript_path
    }
  ' > "$tmp_file" 2>/dev/null; then
    mv -f "$tmp_file" "$state_dir/$key.meta.json"
  else
    rm -f "$tmp_file"
  fi
}

# window内の全pane状態を集約する(優先度: blocked > done > idle)
# タブの色が見分けるのはblockedとdoneだけなので,作業中のpaneしか無いwindowもidleにする
__aggregate_window_state() {
  local target states state
  target=$1

  states=$(
    for pane_id in $(tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null); do
      [[ -f $state_dir/$pane_id.state ]] || continue
      cut -d' ' -f1 "$state_dir/$pane_id.state"
    done
  )

  for state in blocked done; do
    if [[ $states == *$state* ]]; then
      print $state
      return 0
    fi
  done

  print idle
}

# 集約した状態を対象windowの@ai_stateへ反映する
__apply_window_state() {
  local target
  target=$1

  tmux set-option -w -t "$target" @ai_state "$(__aggregate_window_state "$target")" 2>/dev/null || return 0
  tmux refresh-client -S >/dev/null 2>&1 || true
}

# tmux外エージェントの状態をatomicに書き込む(タブ区切り: state agent pid tty cwd)
__write_state_outside() {
  local key state agent agent_pid agent_tty cwd tmp_file
  key=$1
  state=$2
  agent=$3
  agent_pid=$4
  agent_tty=$5
  cwd=$6

  tmp_file=$(mktemp "$state_dir/.state.XXXXXX")
  printf '%s\t%s\t%s\t%s\t%s\n' "$state" "$agent" "$agent_pid" "$agent_tty" "$cwd" > "$tmp_file"
  mv -f "$tmp_file" "$state_dir/$key.state"
}

# フォーカスしたwindowのdoneをidleへ戻す(確認済み扱い,blockedは保持)
__focus_reset() {
  local window_id pane_id state agent agent_pid
  window_id=$1

  for pane_id in $(tmux list-panes -t "$window_id" -F '#{pane_id}' 2>/dev/null); do
    [[ -f $state_dir/$pane_id.state ]] || continue
    read -r state agent agent_pid < "$state_dir/$pane_id.state" || continue
    if [[ $state == done ]]; then
      __write_state "$pane_id" idle "$agent" "${agent_pid:-}"
    fi
  done

  __apply_window_state "$window_id"
}

# transcript末尾からターンの終了状況を判定する(codexのrolloutはターンの開始・完了・中断の出来事で判定する)
#   interrupted: 最後のメッセージがESC割り込みマーカー(codexはturn_aborted)
#                (マーカーはuserのtextとして記録される,ツールの結果に同じ文字列が入る時(transcriptを読んだ等)は中断ではない)
#   stopped:     Stopフック実行済みで終了(最後の有意なエントリがstop_hook_summary,codexはtask_complete)
#   active:      ターン進行中または新しいプロンプト受付後(codexはtask_started)
#   none:        判定不能(transcript無し・読み取り失敗)
__transcript_turn_status() {
  local transcript_path
  transcript_path=$1

  [[ -f $transcript_path ]] || { print none; return 0 }

  tail -n 25 "$transcript_path" 2>/dev/null | jq -rs '
    [ .[]
      | select(.type? == "user" or .type? == "assistant" or (.type? == "system" and .subtype? == "stop_hook_summary")
          or (.type? == "event_msg" and (.payload.type? | IN("task_started", "task_complete", "turn_aborted")))) ]
    | last
    | if . == null then "none"
      elif .type == "system" then "stopped"
      elif .type == "event_msg" then ({task_complete: "stopped", turn_aborted: "interrupted"}[.payload.type] // "active")
      elif .type == "user" and ((.message.content | type) == "array")
        and any(.message.content[]; .type? == "text" and ((.text // "") | startswith("[Request interrupted by user"))) then "interrupted"
      else "active" end
  ' 2>/dev/null || print none
}

# ターン終了後も裏で続くAIの作業の成果物(セッションのフォルダのsubagents等のjsonl)の最終更新からの経過秒を返す
# transcript本体はユーザーとのやり取りで更新され,裏の作業が止まっていても経過が戻るため見ない
# (セッションのフォルダにjsonlが無い時は,他に判断の材料が無いためtranscript本体で見る)
__session_last_activity_age() {
  local transcript_path newest
  local -a artifacts
  transcript_path=$1

  artifacts=("${transcript_path%.jsonl}"/**/*.jsonl(N))
  newest=$(ls -t "${(@)artifacts:-$transcript_path}" 2>/dev/null | head -n 1)
  [[ -n $newest ]] || { print 999999; return 0 }

  print $(( EPOCHSECONDS - $(stat -f %m "$newest" 2>/dev/null || print 0) ))
}

# ターン終了イベントを取りこぼしてworking・blockedのまま残った状態をdone/idleへ倒す
#   interrupted: ESC割り込み(終了イベントが届かないことがある)は即倒す
#                (質問・許可の確認をEscで閉じた時はどのフックも来ずblockedのまま残る)
#   stopped: Stopがbackground_tasks実行中でworkingを維持した後,タスクが孤児化して後続イベントが
#            来ないケースが対象で,実行中の背景タスクと区別するため裏の作業の成果物の更新が10分超止まったものだけ倒す
#            (聞き直し用に残して何もしていないサブエージェントも,これでターン終了後にdone/idleへ戻る)
#            (teammateは長いツール実行中にtranscript・成果物が数分無更新になるため,60秒では完了待ち中の
#            セッションを誤ってdone/idleへ倒してしまう)
#            (blockedは対象にしない,裏のサブエージェントが許可を待つ間も成果物は更新が止まるため)
__reconcile_stuck() {
  local state_file key state agent agent_pid agent_tty cwd transcript_path turn_status

  for state_file in "$state_dir"/%*.state(N) "$state_dir"/sid-*.state(N); do
    key=${${state_file:t}%.state}
    if [[ $key == %* ]]; then
      read -r state agent agent_pid < "$state_file" || continue
    else
      IFS=$'\t' read -r state agent agent_pid agent_tty cwd < "$state_file" || continue
    fi
    [[ $state == working || $state == blocked ]] || continue
    transcript_path=$(jq -r '.transcript_path // empty' "$state_dir/$key.meta.json" 2>/dev/null) || continue
    [[ -n $transcript_path ]] || continue

    turn_status=$(__transcript_turn_status "$transcript_path")
    if [[ $turn_status == interrupted ]] \
      || { [[ $state == working && $turn_status == stopped ]] && (( $(__session_last_activity_age "$transcript_path") > 600 )) }; then
      if [[ $key == %* ]]; then
        __write_state "$key" "$(__stop_state_for_pane "$key")" "$agent" "$agent_pid"
        __apply_window_state "$key"
      else
        __write_state_outside "$key" done "$agent" "$agent_pid" "$agent_tty" "$cwd"
      fi
    fi
  done
}

mkdir -p "$state_dir"

if [[ ${1:-} == --focus-reset ]]; then
  __focus_reset "${2:-$(tmux display-message -p '#{window_id}')}"
  exit 0
fi

if [[ ${1:-} == --reconcile-stuck ]]; then
  __reconcile_stuck
  exit 0
fi

if (( $# != 2 )); then
  print "$0: usage: ai-agent-state <agent> <event> | ai-agent-state --focus-reset [window_id] | ai-agent-state --reconcile-stuck" 1>&2
  exit 1
fi

input=$(cat 2>/dev/null || true)

# tmuxのpaneで動くエージェントはpane単位,paneの外で動くエージェントはsession_id単位で記録する(tmuxタブ反映なし)
if [[ -n ${TMUX_PANE:-} ]]; then
  key=$TMUX_PANE
else
  session_id=$(print -r -- "$input" | jq -r '.session_id // empty' 2>/dev/null || true)
  [[ -n $session_id ]] || exit 0
  key=sid-$session_id
fi

if [[ $2 == SessionEnd ]]; then
  rm -f "$state_dir/$key.state" "$state_dir/$key.meta.json" "$state_dir/$key.wait" "$state_dir/$key.activity"
  [[ $key != %* ]] || __apply_window_state "$key"
  exit 0
fi

if [[ $1 == codex ]]; then
  __write_codex_meta "$key" "$input"
fi

state=$(__resolve_state "$2" "$input" "$key")

# 状態を決めないイベント(未知のもの・作業中でない時の入力待ち通知・compact後のSessionStart)はここで終える
[[ -n $state ]] || exit 0
__record_wait "$state_dir/$key.wait" "$2" "$state" "$input"
# 状態が変わらない(作業中にツールが続く)時も残したいので,状態が変わったかを見る前に記録する
__record_activity "$state_dir/$key.activity" "$2" "$input"

# 状態が変わらないなら書き込みとtmux反映を省く(PreToolUseの高頻度発火対策)
[[ $(__current_state "$key") != "$state" ]] || exit 0

# エージェント本体のPID(hookはエージェントからシェル経由で起動されるため親の親)
agent_pid=$(ps -o ppid= -p $PPID 2>/dev/null | tr -d ' ')
if [[ $key == %* ]]; then
  __write_state "$key" "$state" "$1" "$agent_pid"
  __apply_window_state "$key"
else
  # tmux外は一覧での生存判定・表示用に,TTYと作業ディレクトリも記録する
  agent_tty=$(ps -o tty= -p "${agent_pid:-0}" 2>/dev/null | tr -d ' ')
  cwd=$(print -r -- "$input" | jq -r '.cwd // empty' 2>/dev/null || true)
  __write_state_outside "$key" "$state" "$1" "$agent_pid" "$agent_tty" "$cwd"
fi
