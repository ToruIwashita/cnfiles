#!/usr/bin/env zsh
# AIエージェント(claude/codex)の状態をpane単位で記録し,tmuxのwindowタブ色(@ai_state)に反映する
# tmux外で動くエージェントはsession_id単位(sid-*.state)で記録する(ai-agent-listの一覧用)
#
# 使い方:
#   ai-agent-state <agent> <event>            # claude/codexのhooksから呼ぶ(stdin: hook JSON)
#   ai-agent-state --focus-reset [window_id]  # tmuxのフックから呼ぶ(doneをidleへ戻す)
#   ai-agent-state --reconcile-stuck          # ai-agent-listの描画ループから呼ぶ(取り残されたworkingを倒す)
#
# イベントと状態の対応:
#   UserPromptSubmit / PreToolUse / PostToolUse -> working
#   PermissionRequest             -> blocked
#   Notification                  -> blocked (権限以外の入力待ち,matcherで対象を限定して登録する)
#   Stop                          -> done (background_tasks実行中はworking維持)
#   SessionStart                  -> idle
#   SessionEnd                    -> 状態クリア
set -eu

zmodload zsh/datetime

if [[ -z ${AI_AGENTS_CONFIG_DIR_PATH:-} ]]; then
  print "$0: AI_AGENTS_CONFIG_DIR_PATH is not set"
  exit 1
fi

state_dir=$AI_AGENTS_CONFIG_DIR_PATH/state

# イベントから状態を決定する(Stopはstdin JSONのbackground_tasksを考慮)
__resolve_state() {
  local event input
  event=$1
  input=$2

  case $event in
    UserPromptSubmit | PreToolUse | PostToolUse)
      print working
      ;;
    PermissionRequest)
      print blocked
      ;;
    Notification)
      # 入力待ち通知はターン中(working)のみblockedにする
      # (ターン終了後にも入力待ち系の通知が発火しStop後のidle/doneを上書きしてしまうため)
      if [[ -f $state_dir/$TMUX_PANE.state && $(cut -d' ' -f1 "$state_dir/$TMUX_PANE.state") == working ]]; then
        print blocked
      fi
      ;;
    SessionStart)
      print idle
      ;;
    Stop)
      # ターン終了時にバックグラウンドタスクが動いていればまだ作業中扱い
      if print -r -- "$input" | jq -e '[.background_tasks[]? | select(.status == "running")] | length > 0' >/dev/null 2>&1; then
        print working
      else
        __stop_state_for_pane "$TMUX_PANE"
      fi
      ;;
  esac
}

# ターン終了時の遷移先を返す(完了したwindowをユーザーが見ている(attached+カレント)なら確認済みとしてidle扱い)
__stop_state_for_pane() {
  local pane_id
  pane_id=$1

  if [[ $(tmux display-message -p -t "$pane_id" '#{?#{&&:#{window_active},#{session_attached}},1,0}' 2>/dev/null) == 1 ]]; then
    print idle
  else
    print done
  fi
}

# 状態ファイルへatomicに書き込む(内容: "<state> <agent> <pid>")
__write_state() {
  local pane_id state agent agent_pid tmp_file
  pane_id=$1
  state=$2
  agent=$3
  agent_pid=$4

  tmp_file=$(mktemp "$state_dir/.state.XXXXXX")
  print -r -- "$state $agent $agent_pid" > "$tmp_file"
  mv -f "$tmp_file" "$state_dir/$pane_id.state"
}

# window内の全pane状態を集約する(優先度: blocked > done > working > idle)
__aggregate_window_state() {
  local target states state
  target=$1

  states=$(
    for pane_id in $(tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null); do
      [[ -f $state_dir/$pane_id.state ]] || continue
      cut -d' ' -f1 "$state_dir/$pane_id.state"
    done
  )

  for state in blocked done working; do
    if [[ $states == *$state* ]]; then
      print $state
      return 0
    fi
  done

  print idle
}

# 集約した状態を対象windowの@ai_stateへ反映する
__apply_window_state() {
  local target
  target=$1

  tmux set-option -w -t "$target" @ai_state "$(__aggregate_window_state "$target")" 2>/dev/null || return 0
  tmux refresh-client -S >/dev/null 2>&1 || true
}

# tmux外エージェント用: イベントから状態を決定する(タブ反映が無いため可視判定なし)
__resolve_state_outside() {
  local event input state_file
  event=$1
  input=$2
  state_file=$3

  case $event in
    UserPromptSubmit | PreToolUse | PostToolUse)
      print working
      ;;
    PermissionRequest)
      print blocked
      ;;
    SessionStart)
      print idle
      ;;
    Notification)
      # 入力待ち通知はターン中(working)のみblockedにする
      if [[ -f $state_file && $(cut -f1 "$state_file") == working ]]; then
        print blocked
      fi
      ;;
    Stop)
      if print -r -- "$input" | jq -e '[.background_tasks[]? | select(.status == "running")] | length > 0' >/dev/null 2>&1; then
        print working
      else
        print done
      fi
      ;;
  esac
}

# tmux外エージェントの状態をatomicに書き込む(タブ区切り: state agent pid tty cwd)
__write_state_outside() {
  local key state agent agent_pid agent_tty cwd tmp_file
  key=$1
  state=$2
  agent=$3
  agent_pid=$4
  agent_tty=$5
  cwd=$6

  tmp_file=$(mktemp "$state_dir/.state.XXXXXX")
  printf '%s\t%s\t%s\t%s\t%s\n' "$state" "$agent" "$agent_pid" "$agent_tty" "$cwd" > "$tmp_file"
  mv -f "$tmp_file" "$state_dir/$key.state"
}

# フォーカスしたwindowのdoneをidleへ戻す(確認済み扱い,blockedは保持)
__focus_reset() {
  local window_id pane_id state agent agent_pid
  window_id=$1

  for pane_id in $(tmux list-panes -t "$window_id" -F '#{pane_id}' 2>/dev/null); do
    [[ -f $state_dir/$pane_id.state ]] || continue
    read -r state agent agent_pid < "$state_dir/$pane_id.state" || continue
    if [[ $state == done ]]; then
      __write_state "$pane_id" idle "$agent" "${agent_pid:-}"
    fi
  done

  __apply_window_state "$window_id"
}

# transcript末尾からターンの終了状況を判定する
#   interrupted: 最後のメッセージがESC割り込みマーカー
#   stopped:     Stopフック実行済みで終了(最後の有意なエントリがstop_hook_summary)
#   active:      ターン進行中または新しいプロンプト受付後
#   none:        判定不能(transcript無し・読み取り失敗)
__transcript_turn_status() {
  local transcript_path
  transcript_path=$1

  [[ -f $transcript_path ]] || { print none; return 0 }

  tail -n 25 "$transcript_path" 2>/dev/null | jq -rs '
    [ .[]
      | select(.type? == "user" or .type? == "assistant" or (.type? == "system" and .subtype? == "stop_hook_summary")) ]
    | last
    | if . == null then "none"
      elif .type == "system" then "stopped"
      elif .type == "user" and ((.message.content | tostring) | contains("[Request interrupted by user")) then "interrupted"
      else "active" end
  ' 2>/dev/null || print none
}

# セッション成果物(transcript本体とsubagents/journal等のjsonl)の最終更新からの経過秒を返す
__session_last_activity_age() {
  local transcript_path newest
  transcript_path=$1

  newest=$(ls -t "$transcript_path" "${transcript_path%.jsonl}"/**/*.jsonl(N) 2>/dev/null | head -n 1)
  [[ -n $newest ]] || { print 999999; return 0 }

  print $(( EPOCHSECONDS - $(stat -f %m "$newest" 2>/dev/null || print 0) ))
}

# ターン終了イベントを取りこぼしてworkingのまま残った状態をdone/idleへ倒す
#   interrupted: ESC割り込み(終了イベントが届かないことがある)は即倒す
#   stopped: Stopがbackground_tasks実行中でworkingを維持した後,タスクが孤児化して後続イベントが
#            来ないケースが対象で,実行中の背景タスクと区別するため成果物の更新が60秒超止まったものだけ倒す
__reconcile_stuck() {
  local state_file key state agent agent_pid agent_tty cwd transcript_path turn_status

  for state_file in "$state_dir"/%*.state(N); do
    key=${${state_file:t}%.state}
    read -r state agent agent_pid < "$state_file" || continue
    [[ $state == working ]] || continue
    transcript_path=$(jq -r '.transcript_path // empty' "$state_dir/$key.meta.json" 2>/dev/null) || continue
    [[ -n $transcript_path ]] || continue

    turn_status=$(__transcript_turn_status "$transcript_path")
    if [[ $turn_status == interrupted ]] \
      || { [[ $turn_status == stopped ]] && (( $(__session_last_activity_age "$transcript_path") > 60 )) }; then
      __write_state "$key" "$(__stop_state_for_pane "$key")" "$agent" "${agent_pid:-}"
      __apply_window_state "$key"
    fi
  done

  for state_file in "$state_dir"/sid-*.state(N); do
    key=${${state_file:t}%.state}
    IFS=$'\t' read -r state agent agent_pid agent_tty cwd < "$state_file" || continue
    [[ $state == working ]] || continue
    transcript_path=$(jq -r '.transcript_path // empty' "$state_dir/$key.meta.json" 2>/dev/null) || continue
    [[ -n $transcript_path ]] || continue

    turn_status=$(__transcript_turn_status "$transcript_path")
    if [[ $turn_status == interrupted ]] \
      || { [[ $turn_status == stopped ]] && (( $(__session_last_activity_age "$transcript_path") > 60 )) }; then
      __write_state_outside "$key" done "$agent" "${agent_pid:-}" "${agent_tty:-}" "${cwd:-}"
    fi
  done
}

mkdir -p "$state_dir"

if [[ ${1:-} == --focus-reset ]]; then
  __focus_reset "${2:-$(tmux display-message -p '#{window_id}')}"
  exit 0
fi

if [[ ${1:-} == --reconcile-stuck ]]; then
  __reconcile_stuck
  exit 0
fi

if (( $# != 2 )); then
  print "$0: usage: ai-agent-state <agent> <event> | ai-agent-state --focus-reset [window_id] | ai-agent-state --reconcile-stuck" 1>&2
  exit 1
fi

# tmux paneの外で動くエージェントはsession_id単位で記録する(tmuxタブ反映なし)
if [[ -z ${TMUX_PANE:-} ]]; then
  input=$(cat 2>/dev/null || true)
  session_id=$(print -r -- "$input" | jq -r '.session_id // empty' 2>/dev/null || true)
  [[ -n $session_id ]] || exit 0

  state_file=$state_dir/sid-$session_id.state

  if [[ $2 == SessionEnd ]]; then
    rm -f "$state_file" "$state_dir/sid-$session_id.meta.json"
    exit 0
  fi

  state=$(__resolve_state_outside "$2" "$input" "$state_file")
  [[ -n $state ]] || exit 0

  if [[ -f $state_file && $(cut -f1 "$state_file") == $state ]]; then
    exit 0
  fi

  # エージェント本体のPID(hookはエージェントからシェル経由で起動されるため親の親)と
  # TTY・作業ディレクトリを記録する(一覧での生存判定・表示用)
  agent_pid=$(ps -o ppid= -p $PPID 2>/dev/null | tr -d ' ')
  agent_tty=$(ps -o tty= -p "${agent_pid:-0}" 2>/dev/null | tr -d ' ')
  cwd=$(print -r -- "$input" | jq -r '.cwd // empty' 2>/dev/null || true)
  __write_state_outside "sid-$session_id" "$state" "$1" "${agent_pid:-}" "${agent_tty:-}" "${cwd:-}"
  exit 0
fi

input=$(cat 2>/dev/null || true)

if [[ $2 == SessionEnd ]]; then
  rm -f "$state_dir/$TMUX_PANE.state" "$state_dir/$TMUX_PANE.meta.json"
  __apply_window_state "$TMUX_PANE"
  exit 0
fi

state=$(__resolve_state "$2" "$input")

# 未知のイベントは無視する
[[ -n $state ]] || exit 0

# 状態が変わらないならtmux反映を省く(PreToolUseの高頻度発火対策)
if [[ -f $state_dir/$TMUX_PANE.state && $(cut -d' ' -f1 "$state_dir/$TMUX_PANE.state") == $state ]]; then
  exit 0
fi

# エージェント本体のPID(hookはエージェントからシェル経由で起動されるため親の親)
agent_pid=$(ps -o ppid= -p $PPID 2>/dev/null | tr -d ' ')
__write_state "$TMUX_PANE" "$state" "$1" "${agent_pid:-}"
__apply_window_state "$TMUX_PANE"
