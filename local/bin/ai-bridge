#!/usr/bin/env zsh
# AIエージェント(claude/codex)の状態一覧をwatch表示する(tmux内外を統合)
#
# 使い方:
#   ai-bridge           # 自動更新表示(1秒間隔, Escで終了)
#   ai-bridge --once    # 1回だけ出力して終了
#
# 表示対象:
#   tmux内のエージェント: <pane_id>.state (TARGET=セッション:window.pane)
#   tmux外のエージェント: sid-<session_id>.state (TARGET=tty, 制御端末なしはheadless)
set -eu

zmodload zsh/datetime
# 裏で一覧を組み立てる時の待ちと置き換えを,外部コマンドを起動せずに行う
zmodload zsh/zselect
zmodload -F zsh/files b:zf_mv
# 作業ログが変わったかを外部コマンドを起動せずに調べる
zmodload -F zsh/stat b:zstat

if [[ -z ${AI_AGENTS_CONFIG_DIR_PATH:-} ]]; then
  print "$0: AI_AGENTS_CONFIG_DIR_PATH is not set"
  exit 1
fi

state_dir=$AI_AGENTS_CONFIG_DIR_PATH/state

# 作業中の行を回し,判断待ちの行を脈打たせるコマ(描き直しは1秒10コマ)
spin=(⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷)
pulse=(● ◉ ◎ ○ ○ ◎ ◉ ●)
# 状態が変わった行を閃光で知らせるため,ペインごとの前回の状態・光らせ始めた時刻・一覧での行の位置を持つ
typeset -A row_state flash_at line_of
split_once=0
# 一覧の下の作業の見える化で使う,一覧に出ているAIのキー(並び順)・TARGET・優先度
agent_keys=()
typeset -A target_of agent_prio

# 一覧の並び順(上ほど対応が必要): blocked > done > working > idle
__priority_for() {
  case $1 in
    blocked) print 0 ;;
    done)    print 1 ;;
    working) print 2 ;;
    spare)   print 4 ;;
    *)       print 3 ;;
  esac
}

# 状態ラベル(ANSI色付き・パディング込みで幅を揃える)
# 判断待ちで待っている項目が分かる時は Input(Bash) のように添える(添えた最長の Input(Skill) に幅を合わせる)
__label_for() {
  local text color

  case $1 in
    blocked) text="● Input${2:+($2)}"; color='1;33' ;;
    done)    text='● Done';            color='1;31' ;;
    working) text='● Working';         color='32' ;;
    spare)   text='○ Spare';           color='90' ;;
    *)       text='● Idle';            color='90' ;;
  esac

  print -rn -- $'\e['"${color}m$(__pad "$text" 14)"$'\e[0m'
}

# 判断待ちの項目(ai-agent-stateが記録したツール名)を一覧用の短い名前にする
# 縮めると紛らわしいまれなツールは何も返さず,種類なしの Input にする
__wait_label() {
  case $1 in
    Bash | PowerShell)                          print -r -- Bash ;;
    Edit | Write | NotebookEdit | apply_patch)  print -r -- Edit ;;
    Read | Grep | Glob)                         print -r -- Read ;;
    WebFetch | WebSearch)                       print -r -- Web ;;
    mcp__*)                                     print -r -- MCP ;;
    Skill)                                      print -r -- Skill ;;
    ExitPlanMode)                               print -r -- Plan ;;
    AskUserQuestion)                            print -r -- Q ;;
  esac
}

# 表示幅ベースで切り詰め+右パディングする(全角文字を含む名前の列ズレ対策)
__pad() {
  local text width w
  text=$1
  width=$2

  w=${(m)#text}
  while (( w > width )); do
    text=${text[1,-2]}
    w=${(m)#text}
  done
  printf '%s%*s' "$text" $(( width - w )) ''
}

# トークン数を 61K / 1M 形式に
__fmt_tokens() {
  local t
  t=${1:-0}
  if   (( t >= 1000000 )); then printf '%dM' $(( t / 1000000 ))
  elif (( t >= 1000 ));    then printf '%dK' $(( t / 1000 ))
  else                          printf '%d' $t
  fi
}

# 最終更新からの経過時間を 8s / 15m / 2h 形式に
__fmt_last() {
  local rem
  # NOTE: (( rem = ... )) は結果0でexit 1となりset -eで死ぬため算術展開で代入する
  rem=$(( EPOCHSECONDS - $1 ))
  (( rem < 0 )) && rem=0
  if   (( rem < 60 ));   then print "${rem}s"
  elif (( rem < 3600 )); then print "$(( rem / 60 ))m"
  else                        print "$(( rem / 3600 ))h"
  fi
}

# 利用枠リセットまでの残り時間を 2d 5h / 5h 30m / 30m 形式に
__fmt_reset() {
  local rem d h m
  rem=$(( $1 - EPOCHSECONDS ))
  (( rem < 0 )) && rem=0
  d=$(( rem / 86400 ))
  h=$(( (rem % 86400) / 3600 ))
  m=$(( (rem % 3600) / 60 ))
  if   (( d > 0 )); then print "${d}d ${h}h"
  elif (( h > 0 )); then print "${h}h ${m}m"
  else                   print "${m}m"
  fi
}

# 使用率(0-100)から8マスのバーを生成する(claude-code-statuslineと同じ見た目に揃える)
__usage_bar() {
  local pct filled empty bar
  pct=${1:-0}
  filled=$(( pct * 8 / 100 ))
  (( filled > 8 )) && filled=8
  (( filled < 0 )) && filled=0
  empty=$(( 8 - filled ))
  bar=''

  repeat $filled; do bar+='▰'; done
  repeat $empty; do bar+='▱'; done
  print -rn -- "$bar"
}

# 使用率に応じたANSI色(緑<50 / 黄<80 / 赤>=80)
__usage_color() {
  if   (( ${1:-0} >= 80 )); then print -rn -- 31
  elif (( ${1:-0} >= 50 )); then print -rn -- 33
  else                           print -rn -- 32
  fi
}

# 利用枠1つ分のセグメントを組み立てる(window=5h/7d, values="使用率 リセットepoch")
# 枠を横並びにしても桁が揃うよう,リセット表記まで含めて固定幅(26列)にする
__format_window() {
  local window values pct reset reset_txt

  window=$1
  values=$2

  if [[ -z ${values:-} ]]; then
    printf '%26s' ''
    return 0
  fi

  pct=${values%% *}
  reset=${values#* }
  reset_txt=''
  [[ -n ${reset:-} ]] && reset_txt="($(__fmt_reset "$reset"))"

  printf '%-2s \e[%sm%s\e[0m %3d%% %-9s' \
    "$window" "$(__usage_color "$pct")" "$(__usage_bar "$pct")" "$pct" "$reset_txt"
}

# エージェント1行を組み立てる(5時間枠と週次枠を横並びにする)
__format_agent_line() {
  local label h5 d7 line

  label=$1
  h5=$2
  d7=$3

  line=$(printf '  %-7s %s %s' "$label" "$(__format_window 5h "$h5")" "$(__format_window 7d "$d7")")
  while [[ $line == *' ' ]]; do line=${line% }; done

  print -r -- "$line"
}

# claudeのmeta.jsonから枠ごとの候補を "<枠> <最終assistant時刻> <使用率> <リセットepoch>" 形式で列挙する
# statusLineが受け取るrate_limitsはセッションによって5時間枠だけ欠けることがあり,
# 最新1件に固定すると枠が出たり消えたりするため,アカウント単位で共通な値を枠ごとに独立して探す
# 各セッションの値はそのセッションの最終API応答時点のもので,待機中のセッションも古い値のまま書き直し続けるため
# meta.jsonやtranscriptの更新時刻では選べない(transcriptにはAPI応答なしでメタデータ行が足されることがある)
# 手動リセットでは同じ枠のまま使用率が下がるため最大値でも選べず,最後のassistantエントリが最も新しいセッションの値を採る
# transcriptの読み込みが重いため,両枠ぶんを1回の走査でまとめて出す
__claude_window_candidates() {
  local meta_file line transcript_path h5 d7 last_at
  local -a fields

  for meta_file in "$state_dir"/*.meta.json(N); do
    line=$(jq -r \
      'def w($p; $r): if .[$p] != null then "\(.[$p] | floor) \(.[$r] // 0)" else "" end;
       "\(.transcript_path // "")\t\(w("h5_pct"; "h5_reset"))\t\(w("d7_pct"; "d7_reset"))"' "$meta_file" 2>/dev/null) || continue
    fields=("${(@ps.\t.)line}")
    transcript_path=${fields[1]:-}
    h5=${fields[2]:-}
    d7=${fields[3]:-}
    [[ -n $h5 || -n $d7 ]] || continue

    # transcriptは数十MBになるため末尾だけを読む(UTCのISO8601は文字列順が時刻順になる)
    last_at=$(tail -c 262144 "$transcript_path" 2>/dev/null \
      | grep -F '"type":"assistant"' \
      | jq -Rr 'fromjson? | select(.type == "assistant") | .timestamp // empty' 2>/dev/null \
      | tail -n 1)
    [[ -n $h5 ]] && print -r -- "h5 ${last_at:-0} $h5"
    [[ -n $d7 ]] && print -r -- "d7 ${last_at:-0} $d7"
  done
  return 0
}

# 候補から指定枠の "使用率 リセットepoch" を返す
__claude_window() {
  local candidates window best reset pct

  candidates=$1
  window=$2

  best=$(print -r -- "$candidates" | grep "^$window " | cut -d' ' -f2- | sort -k1,1 | tail -n 1)
  [[ -n ${best:-} ]] || return 0

  reset=${best##* }
  pct=${${best#* }%% *}

  # リセット不明時も "使用率 " の形を保つ(呼び出し側が空白区切りで分解するため)
  if (( reset > 0 )); then
    print -r -- "$pct $reset"
  else
    print -r -- "$pct "
  fi
}

# claudeの5時間/週次利用枠
__usage_lines_claude() {
  local candidates h5 d7

  candidates=$(__claude_window_candidates)
  h5=$(__claude_window "$candidates" h5)
  d7=$(__claude_window "$candidates" d7)
  [[ -n ${h5:-} || -n ${d7:-} ]] || return 0

  __format_agent_line claude "$h5" "$d7"
}

# codexのrate_limitsスナップショットから指定ウィンドウの "使用率 リセットepoch" を返す
# 判定はcodex本体のTUIと同じく期待値の±5%を許容する
# (5時間と週次のどちらがprimary/secondaryに入るかはバックエンド応答次第で位置固定できない)
__codex_window() {
  local snapshot minutes lo hi
  snapshot=$1
  minutes=$2
  lo=$(( minutes * 95 / 100 ))
  hi=$(( minutes * 105 / 100 ))

  print -r -- "$snapshot" \
    | jq -r --argjson lo "$lo" --argjson hi "$hi" \
        '[.payload.rate_limits.primary, .payload.rate_limits.secondary]
         | map(select(. != null and (.window_minutes // 0) >= $lo and (.window_minutes // 0) <= $hi))
         | first
         | if . == null then empty else "\(.used_percent | floor) \(.resets_at // "")" end' 2>/dev/null || true
}

# codexの5時間/週次利用枠(codexはmeta.jsonを持たないためセッションのrolloutから採る)
# rolloutは開始日のディレクトリに残り続けるため,日付から辿ると長時間セッションを取り逃がす
# state DBのthreadsが最終更新順のrollout_pathを持つのでそれを使う(WAL反映のためimmutableは付けない)
# rolloutは20MB級になるがtoken_countは毎ターン出るのでtailで足りる
__usage_lines_codex() {
  local rollouts rollout snapshot h5 d7
  local -a state_dbs
  local -i seen=0

  # state DBはスキーマ更新でstate_5→state_6のように採番が上がるためglobで最新を採る
  state_dbs=("$HOME"/.codex/state_*.sqlite(N.om))
  (( ${#state_dbs} )) || return 0

  # 起動しただけで1ターンも回していないスレッドはtoken_countを持たず,候補が浅いと
  # それだけで埋まって行ごと消えるため多めに採る
  # WALはcodex稼働中も書かれ続け,busy_timeout未設定だと競合した瞬間に即失敗するので待たせる
  rollouts=$(sqlite3 -cmd '.timeout 1000' "file:${state_dbs[1]}?mode=ro" \
    'SELECT rollout_path FROM threads ORDER BY updated_at DESC LIMIT 20;' 2>/dev/null) || return 0
  [[ -n ${rollouts:-} ]] || return 0

  h5=''
  d7=''

  # 5時間枠と週次枠は同じrate_limits応答に同居するが応答によって片方だけ欠けることがあり,
  # 1スナップショットで打ち切ると枠が出たり消えたりするため枠ごとに独立して探す
  # 枠自体を持たないプランでは何件見ても埋まらないのでtoken_countを持つ3件で打ち切る
  while IFS= read -r rollout; do
    [[ -n ${rollout:-} && -f $rollout ]] || continue

    snapshot=$(tail -n 500 "$rollout" 2>/dev/null | grep '"type":"token_count"' | tail -n 1) || continue
    [[ -n ${snapshot:-} ]] || continue

    (( seen += 1 ))
    [[ -z ${h5:-} ]] && h5=$(__codex_window "$snapshot" 300)
    [[ -z ${d7:-} ]] && d7=$(__codex_window "$snapshot" 10080)
    [[ -n ${h5:-} && -n ${d7:-} ]] && break
    (( seen >= 3 )) && break
  done < <(print -r -- "$rollouts")

  [[ -n ${h5:-} || -n ${d7:-} ]] || return 0

  __format_agent_line codex "$h5" "$d7"
}

# agent view経由のプロセスなら task,そのうちタスクを持たない予備プロセスなら spare を返す(それ以外は何も返さない)
# agent viewはセッションを --bg-pty-host 付きで動かし,次の投入に備えて --bg-spare 付きの予備プロセスも先に起動しておく
# 予備プロセスはタスクを割り当てられるまで ~/.claude/jobs/<短縮ID>/state.json を持たない
__bg_kind() {
  local key agent pid tty cmd session_id

  key=$1
  agent=$2
  pid=$3
  tty=$4

  [[ $agent == claude && ( -z $tty || $tty == '??' ) && -n $pid ]] || return 0

  cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
  [[ $cmd == *--bg-pty-host* ]] || return 0

  session_id=${key#sid-}
  if [[ $cmd == *--bg-spare* && ! -f $HOME/.claude/jobs/${session_id[1,8]}/state.json ]]; then
    print -r -- spare
  else
    print -r -- task
  fi
}

# 一覧に出ているエージェント種別を返す(pane単位は空白区切り,tmux外はタブ区切り)
__active_agents() {
  local state_file state agent rest

  {
    for state_file in "$state_dir"/%*.state(N); do
      read -r state agent rest < "$state_file" || continue
      print -r -- "$agent"
    done

    for state_file in "$state_dir"/sid-*.state(N); do
      IFS=$'\t' read -r state agent rest < "$state_file" || continue
      print -r -- "$agent"
    done
  } | sort -u
}

# 利用枠を一覧に出ているエージェントの分だけ並べて返す
__usage_lines() {
  local agents
  local -a parts

  agents=$(__active_agents)
  parts=()

  [[ $'\n'$agents$'\n' == *$'\n'claude$'\n'* ]] && parts+=("${(@f)$(__usage_lines_claude)}")
  [[ $'\n'$agents$'\n' == *$'\n'codex$'\n'* ]] && parts+=("${(@f)$(__usage_lines_codex)}")
  parts=(${parts:#})

  (( ${#parts} )) || return 0
  print -rl -- "${parts[@]}"
}

# 現存しないpane・シェルに戻ったpane・死んだプロセスの状態ファイルを掃除する
__cleanup_stale() {
  local panes live state_file id cmd pid
  local -a tmp_files

  # 書き込みの途中で止められて残った一時ファイルを消す(書き込み中のものを消さないよう,5分以上経ったものだけ)
  tmp_files=("$state_dir"/.(state|meta|activity).*(N.mm+5))
  (( ! ${#tmp_files} )) || rm -f -- "${tmp_files[@]}"

  # tmuxサーバー停止中やソケット一時障害でpane一覧が取れないと,全paneを
  # 「消えたpane」と誤判定して状態ファイルを消し去るため掃除自体を打ち切る
  panes=$(tmux list-panes -a -F '#{pane_id} #{pane_current_command}' 2>/dev/null) || return 0
  [[ -n $panes ]] || return 0

  # カレントコマンドがシェルのpane(=エージェント終了後)は,SessionEndが
  # 発火しない異常終了でも掃除できるよう生存リストから除外する
  live=$(
    print -r -- "$panes" \
      | while read -r id cmd; do
          case $cmd in
            zsh | bash) ;;
            *) print -r -- "$id" ;;
          esac
        done
  )

  for state_file in "$state_dir"/%*.state(N); do
    id=${${state_file:t}%.state}
    if [[ $'\n'$live$'\n' != *$'\n'$id$'\n'* ]]; then
      rm -f "$state_file" "$state_dir/$id.meta.json" "$state_dir/$id.wait" "$state_dir/$id.activity"
    fi
  done

  for state_file in "$state_dir"/sid-*.state(N); do
    pid=$(cut -f3 "$state_file" 2>/dev/null || true)
    if [[ -z ${pid:-} ]] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$state_file" "${state_file%.state}.meta.json" "${state_file%.state}.wait" "${state_file%.state}.activity"
    fi
  done
}

# メタ情報の表示列を出力する(形式: "<model>\t<context>")
# contextは使用率で色分けし,色指定を幅に数えて列がずれないよう幅をそろえてから色で囲む
__meta_columns() {
  local meta_file values model cx_pct cx_tok
  local -a fields
  meta_file=$state_dir/$1.meta.json

  if [[ -f $meta_file ]]; then
    # 毎秒・行ごとに呼ばれるためjqは1回で全列を取る
    # モデル名の括弧付き補足("Opus 4.8 (1M context)"等)は列に収まらないため除去する
    values=$(jq -r '[((.model // "-") | split(" (")[0]), (.cx_pct // 0 | floor), (.cx_tok // 0)] | @tsv' "$meta_file" 2>/dev/null || true)
    fields=("${(@ps.\t.)values}")
    model=${fields[1]:--}
    cx_pct=${fields[2]:-0}
    cx_tok=${fields[3]:-0}
    printf '%s\t\e[%sm%-9s\e[0m' "$model" "$(__usage_color "$cx_pct")" "${cx_pct}% $(__fmt_tokens "$cx_tok")"
  else
    printf -- '-\t%-9s' -
  fi
}

# 1行分の表示を整形する(形式: "<priority>\t<mtime>\t<キー>\t<TARGET>\t<整形済み表示行>")
# キーはtmux内ならペインID,tmux外なら sid-<session_id> で,選べる(ジャンプできる)のはペインIDの行だけ
# 一覧の下の作業の見える化でAIを同じ名前で示すため,TARGETも添える(並びは状態で入れ替わるので行番号は使えない)
__format_row() {
  local target agent agent_pid state dir key mtime meta model ctx wait_label target_col open_mark
  target=$1
  agent=$2
  agent_pid=$3
  state=$4
  dir=$5
  key=$6
  mtime=$7

  meta=$(__meta_columns "$key")
  model=${meta%$'\t'*}
  ctx=${meta#*$'\t'}

  if [[ $state == blocked && -f $state_dir/$key.wait ]]; then
    wait_label=$(__wait_label "$(<"$state_dir/$key.wait")")
  fi

  # 下に開いている印(▼)は細い記号でも目に留まるよう,鮮やかな赤の太字にする
  # 色の指定が幅に数えられないよう,幅をそろえた後で色を付ける
  target_col=$(__pad "$target" 23)
  open_mark=$'\e[1;38;5;196m▼\e[0m'

  printf '%s\t%s\t%s\t%s\t%-7s %s %-7s %s %s %-12s %s %s\n' \
    "$(__priority_for "$state")" \
    "$mtime" \
    "$key" \
    "${target#▼ }" \
    "${${agent_pid:--}[1,7]}" \
    "${target_col/#▼/$open_mark}" \
    "${agent[1,7]}" \
    "$(__label_for "$state" "$wait_label")" \
    "$(__pad "$dir" 22)" \
    "${model[1,12]}" \
    "$ctx" \
    "$(__fmt_last "$mtime")"
}

# 全エージェントのデータ行を出力する
__emit_rows() {
  local line pane_id session win pane pane_path state agent
  local state_file key agent_pid agent_tty cwd mtime sep target bg_kind row_state home
  local -a parts

  # ターン終了イベントを取りこぼしてworkingのまま残った状態を倒す
  ai-agent-state --reconcile-stuck 2>/dev/null || true

  # 下に開いているAIの位置は一覧の隣になるため,入れ替わったペインがいる元の場所を印付きで出す
  home=''
  if [[ -n ${last_swap[2]:-} ]]; then
    home=$(tmux display -p -t "${last_swap[2]}" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)
  fi

  # tmux内(pane単位)
  sep=$'\t'
  tmux list-panes -a -F "#{pane_id}${sep}#{session_name}${sep}#{window_index}${sep}#{pane_index}${sep}#{pane_current_path}" 2>/dev/null \
    | while IFS= read -r line; do
        parts=("${(@ps.\t.)line}")
        pane_id=${parts[1]:-}
        session=${parts[2]:-}
        win=${parts[3]:-}
        pane=${parts[4]:-}
        pane_path=${parts[5]:-}
        [[ -n $pane_id && -f $state_dir/$pane_id.state ]] || continue
        read -r state agent agent_pid < "$state_dir/$pane_id.state" || continue
        mtime=$(stat -f %m "$state_dir/$pane_id.state" 2>/dev/null || print $EPOCHSECONDS)
        if [[ -n $home && $pane_id == "${last_swap[1]:-}" ]]; then
          target="▼ $home"
        else
          target="${session}:${win}.${pane}"
        fi

        __format_row "$target" "$agent" "${agent_pid:-}" "$state" "${pane_path:t}" "$pane_id" "$mtime"
      done

  # tmux外(session_id単位)
  for state_file in "$state_dir"/sid-*.state(N); do
    key=${${state_file:t}%.state}
    IFS=$'\t' read -r state agent agent_pid agent_tty cwd < "$state_file" || continue
    mtime=$(stat -f %m "$state_file" 2>/dev/null || print $EPOCHSECONDS)
    bg_kind=$(__bg_kind "$key" "$agent" "${agent_pid:-}" "${agent_tty:-}")

    # agent view経由のプロセスはattach等にそのまま使える短縮IDを出す
    # 制御端末を持たないヘッドレス実行(cron等)はpsのttyが??になるため表示名に置き換える
    if [[ $bg_kind == spare ]]; then
      target=agents:spare
    elif [[ $bg_kind == task ]]; then
      target=agents:${${key#sid-}[1,8]}
    elif [[ -z ${agent_tty:-} || $agent_tty == '??' ]]; then
      target=headless
    else
      target=$agent_tty
    fi

    # 予備プロセスはタスクを持たないので,通常のセッションのIdleと紛れないよう専用の状態で出す
    if [[ $bg_kind == spare ]]; then
      row_state=spare
    else
      row_state=$state
    fi

    __format_row "$target" "$agent" "${agent_pid:-}" "$row_state" "${cwd:t}" "$key" "$mtime"
  done
}

# ヘッダ+ソート済み一覧を出力する
__render() {
  local usage

  # 利用枠は一覧に出るエージェントで絞るため,先に古い状態ファイルを掃除する
  __cleanup_stale
  usage=$(__usage_lines)

  if (( ${selectable:-0} )); then
    printf 'AI Bridge  %s  (C-n/C-p:select, C-s:open, C-k:open-below, C-l:open-dir, Enter: jump, q:close, C-g:clear, Esc:quit)\n' "$(strftime '%H:%M:%S' $EPOCHSECONDS)"
  else
    printf 'AI Bridge  %s  (Esc: quit)\n' "$(strftime '%H:%M:%S' $EPOCHSECONDS)"
  fi
  if (( $#usage )); then
    print
    print -r -- "$usage"
    print
  fi
  # 選択できる時はデータ行の頭に番号(数字キーで選ぶ)が付くので,見出しも同じだけずらす
  printf '%*s%-7s %-23s %-7s %-14s %-22s %-12s %-9s %s\n' $(( ${selectable:-0} ? 2 : 0 )) '' PID TARGET AGENT STATUS DIR MODEL CONTEXT LAST
  # 同じ状態の中では直近に状態が変わったものを上に出す(データ行は優先度・キー・TARGETを先頭に残す)
  __emit_rows | sort -t$'\t' -k1,1n -k2,2nr | cut -f1,3-
}

# 選んだペインへ移り,そのセッションを表示しているiTerm2のウィンドウも前面に出す
__jump() {
  local pane_id session client_tty

  pane_id=$1

  session=$(tmux display -p -t "$pane_id" '#{session_name}' 2>/dev/null) || return 0
  tmux select-window -t "$pane_id" 2>/dev/null || return 0
  tmux select-pane -t "$pane_id" 2>/dev/null || return 0

  # 同じセッションを複数のウィンドウで表示している場合は最後に操作したものを使う
  client_tty=$(
    tmux list-clients -F "#{client_activity}"$'\t'"#{client_tty}"$'\t'"#{client_session}" 2>/dev/null \
      | awk -F '\t' -v s="$session" '$3 == s' \
      | sort -t$'\t' -k1,1nr \
      | head -n 1 \
      | cut -f2
  )

  # どのウィンドウにも表示されていないセッションは,このai-bridgeのウィンドウに出す
  if [[ -z $client_tty ]]; then
    tmux switch-client -t "$pane_id" 2>/dev/null || true
    return 0
  fi

  # iTerm2が起動していない時に tell で起動させてしまわないよう,起動中の時だけ操作する
  osascript \
    -e 'on run argv' \
    -e 'if application "iTerm2" is not running then return' \
    -e 'tell application "iTerm2"' \
    -e 'repeat with w in windows' \
    -e 'repeat with t in tabs of w' \
    -e 'repeat with s in sessions of t' \
    -e 'if tty of s is (item 1 of argv) then' \
    -e 'select w' \
    -e 'select t' \
    -e 'select s' \
    -e 'activate' \
    -e 'return' \
    -e 'end if' \
    -e 'end repeat' \
    -e 'end repeat' \
    -e 'end repeat' \
    -e 'end tell' \
    -e 'end run' \
    "$client_tty" >/dev/null 2>&1 || true
}

# 選んだペインの作業ディレクトリ(DIR)で,このai-bridgeのセッションに新しいウィンドウを開いて移る
# 一覧へ戻った時に閉じられるよう,開いたペインを dir_panes に残す
__open_dir_window() {
  local dir pane

  dir=$(tmux display -p -t "$1" '#{pane_current_path}' 2>/dev/null) || return 0
  # -c はtmuxのフォーマットとして展開されるため,パスの # は ## にして文字どおりに渡す
  pane=$(tmux new-window -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 0
  dir_panes+=("$pane")
}

# ウィンドウを移ってから一覧へ戻った時に呼び,C-lで開いたウィンドウのうちシェル1つに戻っているものを全部閉じる
# 何か実行中だったりペインを分けていれば巻き込まないよう残し,次に戻った時にもう一度見る
__close_dir_window() {
  local pane info panes cmd
  local -a kept

  for pane in "${dir_panes[@]}"; do
    # 既に閉じられたウィンドウは追うのをやめる
    info=$(tmux display -p -t "$pane" '#{window_panes} #{pane_current_command}' 2>/dev/null) || continue
    read -r panes cmd <<< "$info"
    if [[ $panes == 1 && ( $cmd == zsh || $cmd == bash ) ]]; then
      tmux kill-window -t "$pane" 2>/dev/null || true
    else
      kept+=("$pane")
    fi
  done
  dir_panes=("${kept[@]}")
}

# このai-bridgeのペインの真下にある,同じウィンドウのペインIDを返す(無ければ何も返さない)
__pane_below() {
  local self_geometry
  integer top height left width

  [[ -n ${TMUX_PANE:-} ]] || return 0
  self_geometry=$(tmux display -p -t "$TMUX_PANE" '#{pane_top} #{pane_height} #{pane_left} #{pane_width}' 2>/dev/null) || return 0
  read -r top height left width <<< "$self_geometry"

  # 真下のペインは上端が「自分の上端+高さ+境界線1行」で,横方向に自分と重なる
  tmux list-panes -t "$TMUX_PANE" -F '#{pane_id} #{pane_top} #{pane_left} #{pane_width}' 2>/dev/null \
    | awk -v t=$(( top + height + 1 )) -v l=$left -v w=$width '$2 == t && $3 < l + w && $3 + $4 > l { print $1; exit }'
}

# 選んだペインを,このウィンドウのai-bridgeの真下のペインと入れ替えて表示する(フォーカスはai-bridgeに残す)
# ペインIDはペインと一緒に移動するため,入れ替えた2つを last_swap に残しておけば同じ2つを入れ替え直して戻せる
# 真下にペインが無ければ仮のペインを作って入れ替え,AIが元いた場所の配置を崩さないよう仮のペインをそこへ置く
# 仮のペインが他のウィンドウに溜まらないよう,入れ替えは常に1組だけにする(表示中の別のAIは先に元の場所へ戻す)
__open_below() {
  local pane_id below target placeholder height
  integer fit

  pane_id=$1

  [[ $(__pane_below) != "$pane_id" ]] || return 0
  (( ! ${#last_swap} )) || __undo_swap

  below=$(__pane_below)
  # 開いた時に一覧の高さを中身に合わせるので,閉じた時に戻せるよう開く前の高さを残す
  height=$(tmux display -p -t "$TMUX_PANE" '#{pane_height}' 2>/dev/null || true)
  # tmuxはペインを縮める時,カーソルより下の行を消し切ると残りを上の行から消して表示が上にずれるため,
  # 一覧の高さを変える前にカーソルを左上へ移して下の行から消させる
  # (描き終えた後も左上に置くと,読み込みの合間に打ったキーのエコーが見出しに重なるので,ここでだけ移す)
  printf '\e[H'
  if [[ -n $below ]]; then
    target=$below
    # 一覧と下のAIで分け合う高さは,下のペインの分と間の境界線1行を足したもの
    fit=$(__fit_height $(( height + 1 + $(tmux display -p -t "$below" '#{pane_height}' 2>/dev/null || print 0) )))
  else
    fit=$(__fit_height $height)
    # 一度縮めてから合わせ直すと一覧も下のAIも続けて2回大きさが変わり,その度に描き直しになるため,
    # 仮のペインは最初から合わせた後の大きさで作る
    placeholder=$(tmux split-window -d -v -l $(( height - fit - 1 )) -t "$TMUX_PANE" -P -F '#{pane_id}' 2>/dev/null) || return 0
    target=$placeholder
  fi

  if ! tmux swap-pane -d -s "$pane_id" -t "$target" 2>/dev/null; then
    [[ -z ${placeholder:-} ]] || tmux kill-pane -t "$placeholder" 2>/dev/null || true
    return 0
  fi

  last_swap=("$pane_id" "$target" "${placeholder:-}" "$height")
  tmux resize-pane -t "$TMUX_PANE" -y $fit 2>/dev/null || true
  __data_changed
  size_stale=1
  __draw
}

# 下にAIを開いた時の一覧の高さ(見切れないよう中身の行数にする)
# 下のAIに半分以上を残すため,一覧と下のAIで分け合う高さ($1)から境界線1行を除いた半分までにし,
# 入りきらない分は … +N more の表示に任せる
__fit_height() {
  integer half

  half=$(( ($1 - 1) / 2 ))
  print -r -- $(( ${#lines} < half ? ${#lines} : half ))
}

# このウィンドウのai-bridgeの真下のペインへフォーカスを移す
__focus_below() {
  local below

  below=$(__pane_below)
  [[ -n $below ]] || return 0

  tmux select-pane -t "$below" 2>/dev/null || true
}

# 選んだペインを真下に開いてそこへ移る(既に下に開いていれば __open_below は何もしないので,移るだけになる)
# 開いて移った時点で見たとみなして完了をidleへ戻す(ウィンドウを移らないのでtmuxのフックでは戻らず,
# 未選択のC-kで同じ行が選ばれ続けるため)
__open_and_focus_below() {
  __open_below "$1"
  __focus_below
  ai-agent-state --focus-reset "$(tmux display -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)" 2>/dev/null || true
  __data_changed
}

# 直前の入れ替えを元に戻す(どちらかのペインが閉じていれば入れ替えは失敗するので何もしない)
# 仮のペインはai-bridgeの下へ戻ってくるので閉じて元の配置に戻すが,そこで何か実行していれば巻き込まないよう残す
__undo_swap() {
  local placeholder

  (( ${#last_swap} )) || return 0

  # 一覧を開く前の高さへ縮める時も表示が上にずれないよう,先にカーソルを左上へ移す(__open_below と同じ理由)
  printf '\e[H'
  tmux swap-pane -d -s "${last_swap[1]}" -t "${last_swap[2]}" 2>/dev/null || true

  placeholder=${last_swap[3]:-}
  if [[ -n $placeholder ]]; then
    case $(tmux display -p -t "$placeholder" '#{pane_current_command}' 2>/dev/null || true) in
      zsh | bash) tmux kill-pane -t "$placeholder" 2>/dev/null || true ;;
    esac
  elif (( ${last_swap[4]:-0} > 0 )); then
    # 元からあった下のペインと入れ替えた時は,一覧の高さも開く前に戻す(仮のペインは閉じれば元の高さに戻る)
    tmux resize-pane -t "$TMUX_PANE" -y "${last_swap[4]}" 2>/dev/null || true
  fi

  last_swap=()
  __data_changed
  size_stale=1
  __draw
}

# 下に開いた・閉じた・完了を待機へ戻した等,手元で一覧の中身を変えた時に呼ぶ
# 裏の組み立てを待たずにその場で組み立て直させ,裏にも下に開いたAIを伝える
# 変える前に裏で組み立て始めた一覧を取り込んで表示が戻らないよう,世代(gen)を上げて古い一覧を捨てさせる
__data_changed() {
  (( ++gen ))
  print -r -- "$gen ${last_swap[1]:-} ${last_swap[2]:-}" >| "$ctl_file"
  need_render=1
}

# 一覧の組み立て(約0.2秒)が1秒10コマの描き直しを止めないよう,裏で1秒ごとに組み立ててファイルに置く
# 1行目に通し番号と組み立てた時の世代を添え,置き換えは一度に行う(描き手が書きかけを読まないように)
# 描き手が強制終了されても裏に残り続けないよう,描き手がいなくなったら止まる
__render_loop() {
  local g a b
  integer seq=0

  trap - EXIT INT TERM HUP WINCH
  while kill -0 $$ 2>/dev/null; do
    if ! read -r g a b < "$ctl_file"; then
      g=0 a='' b=''
    fi
    if [[ -n $a ]]; then
      last_swap=("$a" "$b")
    else
      last_swap=()
    fi
    { print -r -- "$(( ++seq )) $g"; __render } >| "$render_file.tmp" 2>/dev/null || true
    zf_mv -f "$render_file.tmp" "$render_file" 2>/dev/null || true
    zselect -t 100 || true
  done
}

# 描画結果から優先度・キー・TARGETの列を外して lines に,選択できるペインIDを並び順に jump_ids に入れる
# 一覧の下の作業の見える化のため,一覧に出ているAIのキーを並び順に agent_keys に,TARGETと優先度を target_of / agent_prio に入れる
# 表示範囲をずらせるよう,データ行の開始位置を first_row に,選択中の行の位置を selected_line に入れる(無ければ0)
# 未選択のC-kで開く先として,判断待ち,無ければ完了のうち一番上のペインIDを attention_id に入れる
# 選択できる時は数字キーで選べるよう,選択できる行の頭に1〜9の番号を付ける
# 選択中のペインがあれば目立たせ,一覧から消えていれば選択を外す
# 状態が変わった行と新しく出た行は閃光で知らせる(最初に一覧を出した時は全て新しいので光らせない)
__split_rendered() {
  local line priority id target input_id done_id num input_priority done_priority
  local -A states

  lines=()
  line_of=()
  jump_ids=()
  agent_keys=()
  target_of=()
  agent_prio=()
  first_row=0
  selected_line=0
  input_id=''
  done_id=''
  input_priority=$(__priority_for blocked)
  done_priority=$(__priority_for done)

  for line in "${rendered[@]}"; do
    if [[ $line == *$'\t'* ]]; then
      (( first_row )) || first_row=$(( ${#lines} + 1 ))
      priority=${line%%$'\t'*}
      line=${line#*$'\t'}
      id=${line%%$'\t'*}
      line=${line#*$'\t'}
      target=${line%%$'\t'*}
      line=${line#*$'\t'}
      agent_keys+=("$id")
      target_of[$id]=$target
      agent_prio[$id]=$priority
      num=''
      if [[ $id == %* ]]; then
        jump_ids+=("$id")
        (( ${#jump_ids} > 9 )) || num=${#jump_ids}
        [[ $id == "$selected_id" ]] && selected_line=$(( ${#lines} + 1 ))
        [[ $priority == "$input_priority" && -z $input_id ]] && input_id=$id
        [[ $priority == "$done_priority" && -z $done_id ]] && done_id=$id
        states[$id]=$priority
        line_of[$id]=$(( ${#lines} + 1 ))
      fi
      (( ! selectable )) || line=${(r:2:)num}$line
    fi
    lines+=("$line")
  done
  attention_id=${input_id:-$done_id}

  if (( split_once )); then
    for id in ${(k)states}; do
      [[ ${row_state[$id]:-} == "${states[$id]}" ]] || flash_at[$id]=$EPOCHREALTIME
    done
  fi
  row_state=("${(@kv)states}")
  split_once=1

  if (( ! selected_line )); then
    selected_id=''
    return 0
  fi

  lines[selected_line]=$(__highlight_selected "${lines[selected_line]}")
}

# 選択中の行に暗い紺を行末まで敷き,文字の色は残す
# (反転は白地が目に刺さり,色付きの列が別の色の帯になるため背景色で示す)
__highlight_selected() {
  local bg reset bright
  bg=$'\e[48;2;31;47;79m'
  reset=$'\e[0m'
  # 紺地では暗い赤・緑・黄・灰色が読みにくいため,同じ色相の明るい色にする(灰色は明るい灰色)
  bright=${${${${${${1//$'\e[1;31m'/$'\e[1;91m'}//$'\e[1;33m'/$'\e[1;93m'}//$'\e[31m'/$'\e[91m'}//$'\e[32m'/$'\e[92m'}//$'\e[33m'/$'\e[93m'}//$'\e[90m'/$'\e[37m'}
  # 行の中の色の解除で背景も消えるので,解除のたびに敷き直してから行末まで塗る
  print -rn -- "$bg${bright//$reset/$reset$bg}"$'\e[K'"$reset"
}

# 隠れた行数の表示(下だけなら従来どおり "+N more")
__hidden_rows_label() {
  integer above below

  above=$1
  below=$2

  if (( above && below )); then
    printf '\e[90m… +%d above, +%d more\e[0m' $above $below
  elif (( above )); then
    printf '\e[90m… +%d above\e[0m' $above
  else
    printf '\e[90m… +%d more\e[0m' $below
  fi
}

# ペインに収まる画面を組み立てて out に入れる
# 折り返し抑止だけでは行数超過を防げないため,ペインに収まる行数へ切り詰め,隠れた行数は最終行に出す
# 末尾に改行を出さないのも同じ理由(最終行で改行するとそれだけでスクロールする)
# 選択中の行が隠れないようデータ行の表示範囲(scroll_top)を必要な分だけずらす
__compose_screen() {
  integer max_lines shown_header room capacity row_count sel bottom
  local -a rows screen

  max_lines=$1

  if (( ${#lines} <= max_lines )); then
    scroll_top=1
    out=${(F)lines}
    return 0
  fi

  # データ行が無いのに溢れる場合は見出しを先頭から切り詰める
  if (( ! first_row )); then
    out=${(F)lines[1,max_lines-1]}$'\n'$(__hidden_rows_label 0 $(( ${#lines} - max_lines + 1 )))
    return 0
  fi

  rows=("${(@)lines[first_row,-1]}")
  row_count=${#rows}

  # 見出しを出しても隠れた行数の表示と1行以上のデータ行が入るなら見出しを残し,
  # 入らない狭いペインでは選択中の行が見えることを優先して見出しを外す
  if (( max_lines - (first_row - 1) - 1 >= 1 )); then
    shown_header=$(( first_row - 1 ))
  else
    shown_header=0
  fi
  room=$(( max_lines - shown_header ))

  # データ行が全部入るなら隠れた行数の表示は出さず,1行しか入らない時も行を優先して出さない
  if (( row_count <= room )); then
    capacity=$row_count
  elif (( room >= 2 )); then
    capacity=$(( room - 1 ))
  else
    capacity=$room
  fi

  if (( selected_line )); then
    sel=$(( selected_line - first_row + 1 ))
    scroll_top=$(( scroll_top > sel ? sel : (scroll_top < sel - capacity + 1 ? sel - capacity + 1 : scroll_top) ))
  else
    scroll_top=1
  fi
  scroll_top=$(( scroll_top > row_count - capacity + 1 ? row_count - capacity + 1 : (scroll_top < 1 ? 1 : scroll_top) ))
  bottom=$(( scroll_top + capacity - 1 ))

  screen=()
  (( ! shown_header )) || screen+=("${(@)lines[1,shown_header]}")
  screen+=("${(@)rows[scroll_top,bottom]}")
  (( capacity == row_count || capacity == room )) || screen+=("$(__hidden_rows_label $(( scroll_top - 1 )) $(( row_count - bottom )))")

  out=${(F)screen}
}

# --- 作業の見える化: 一覧の下の余白に,どのリポジトリで何をしているか(WORKSPACE)と,有益な出来事だけの作業ログ(OPS.LOG)を出す ---
# 材料は各AIのフックで ai-agent-state が残す作業ログ(<キー>.activity: 時刻 種類 ツール 対象 補足 作業ディレクトリ)
# AIは一覧の並びが状態で入れ替わっても同じ名前で示せるよう,行番号ではなくTARGETで示す
typeset -A repo_root_of ops_verb_col
ops_verb_col=(ORDER 213 MSG 141 EDIT 48 EXEC 51 TEST 87 COMMIT 220 PUSH 214 SPAWN 141 FETCH 75 SEARCH 75 STEP 159 ASK 214 SKILL 141 AWAIT 214 DONE 203)
ops_tsig=''
ops_log=()
ops_cached=()
ops_newest=''
ops_newest_at=0
ops_label_w=4
ops_repo_count=0
ops_cache_cols=0
ops_cache_rows=0
# ペインの高さと幅(描画で大きさを聞き直す時に覚える,作業ログの行は高さの分だけ作っておく)
pane_rows=24
pane_cols=80
# 一覧が短い時に作業の見える化の枠が大きくなりすぎないよう,枠の上端はペインの上からこの割合(%)の位置より上にしない
ops_top_pct=25
# AIごとの材料(作業ディレクトリとそのリポジトリ・指示とその時刻・ターンの始まりと終わり・実行中のコマンド・承認待ち・
# 最後に動いた時刻・このターンの編集の集計・コミットやプッシュの印)と,このターンに触ったファイル(キーは リポジトリ<TAB>パス<TAB>AI)
typeset -A ag_cwd ag_root ag_task ag_task_t ag_turn_t ag_end ag_run ag_run_t ag_wait ag_last ag_files ag_add ag_del ag_mark ag_mark_t ops_files
# 作業ログは追記されていくだけなので,AIごとに読んだ所(inode・大きさ・1行目・行数)と拾った出来事を覚えて,増えた行だけを読む
typeset -A ops_ino ops_size ops_head ops_seen ops_ev

# コマンドの種類(テストの実行・コミット・プッシュ)を,コマンドとして実行した時だけ判定する
# && ; | で区切った各部分の先頭の語で見る(環境変数の指定や bundle exec 等の前置きは飛ばす)
__cmd_kind() { # $1=コマンド → REPLY=TEST/COMMIT/PUSH/空
  setopt localoptions extendedglob
  local seg
  local -a w
  REPLY=''
  for seg in "${(@s:;:)${${1//\&\&/;}//[|]/;}}"; do
    w=(${=seg})
    while (( ${#w} )) && [[ ${w[1]} == [A-Za-z_][A-Za-z0-9_]#=* ]]; do w[1]=(); done
    while (( ${#w} )) && [[ ${w[1]} == (time|env|npx|command) ]]; do w[1]=(); done
    [[ ${w[1]:-} == bundle && ${w[2]:-} == exec ]] && w[1,2]=()
    case ${w[1]:-} in
      bin/rspec | rspec | jest | vitest | pytest) REPLY=TEST; return 0 ;;
      go | cargo) [[ ${w[2]:-} == test ]] && { REPLY=TEST; return 0 } ;;
      bin/rails | rails) [[ ${w[2]:-} == test* ]] && { REPLY=TEST; return 0 } ;;
      pnpm | yarn | npm)
        [[ ${w[2]:-} == (--filter|-F|-w) ]] && w[2,3]=()
        [[ ${w[2]:-} == test(|:*) || ( ${w[2]:-} == run && ${w[3]:-} == test(|:*) ) ]] && { REPLY=TEST; return 0 } ;;
      git)
        [[ ${w[2]:-} == commit ]] && { REPLY=COMMIT; return 0 }
        [[ ${w[2]:-} == push ]] && { REPLY=PUSH; return 0 } ;;
    esac
  done
  return 0
}

# ファイルや作業ディレクトリが入っているgitリポジトリの一番上(無ければそのディレクトリ)
__repo_root() {
  local r=$1
  if [[ -n ${repo_root_of[$1]:-} ]]; then
    REPLY=${repo_root_of[$1]}
    return 0
  fi
  while [[ $r != / && -n $r && ! -e $r/.git ]]; do r=${r:h}; done
  [[ $r == / || -z $r ]] && r=$1
  repo_root_of[$1]=$r
  REPLY=$r
}

# 表示用のリポジトリ名(ghq の github.com/持ち主/名前 なら 持ち主/名前,ほかは一番上のディレクトリ名)
__repo_name() {
  local rest
  case $1 in
    */github.com/*/*) rest=${1#*/github.com/}; REPLY=${rest%%/*}/${${rest#*/}%%/*} ;;
    *) REPLY=${1:t} ;;
  esac
}

# 経過秒を 1h5m / 3m12s / 45s に(時刻の引き算は 74.999… のようになるので四捨五入する)
__fmt_dur() {
  integer s=$(( $1 + 0.5 ))
  if (( s >= 3600 )); then REPLY="$(( s / 3600 ))h$(( s % 3600 / 60 ))m"
  elif (( s >= 60 )); then REPLY="$(( s / 60 ))m$(( s % 60 ))s"
  else REPLY="${s}s"; fi
}

# 読んでいるAIの出来事(呼び出し元の ev)に足す
__ops_add() { # 時刻 キー 動詞 対象 補足
  local tk
  # 秒未満の桁数が記録ごとに違うと数として並べた時に前後が狂うので,小数点以下を3桁にそろえる
  printf -v tk '%.3f' $1
  ev+=("$tk"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"$5")
}

# 文字列のバイト数(書きかけの行を見分けるため,ファイルの大きさと比べる)
__byte_len() {
  setopt localoptions nomultibyte
  REPLY=${#1}
}

# AIの材料と作業ログを読んだ所を捨てる(作業ログを最初から読み直す時と,一覧から消えた時)
__ops_forget() {
  local k

  unset "ag_cwd[$1]" "ag_root[$1]" "ag_task[$1]" "ag_task_t[$1]" "ag_turn_t[$1]" "ag_end[$1]" "ag_run[$1]" "ag_run_t[$1]" \
    "ag_wait[$1]" "ag_last[$1]" "ag_files[$1]" "ag_add[$1]" "ag_del[$1]" "ag_mark[$1]" "ag_mark_t[$1]" \
    "ops_ino[$1]" "ops_size[$1]" "ops_head[$1]" "ops_seen[$1]" "ops_ev[$1]"
  for k in ${(k)ops_files}; do
    [[ ${ops_files[$k]%% *} == "$1" ]] && unset "ops_files[$k]"
  done
  return 0
}

# 一覧に出ているAIの作業ログを読み,ワークスペースと作業ログの材料を作る
# 全部を読み直すと描き直しが止まるため,追記されていくだけの作業ログは前に読んだ行を読み直さず,増えた行だけを読む
# (切り詰めや作り直しで中身が入れ替わった時は最初から読み直し,一覧から消えたAIの材料は捨てる)
__ops_load() {
  local key f kind tool obj extra cwd root k content tsig
  local -a p v lines ev all
  local -A st st2
  typeset -F t now
  integer a d i n changed

  now=$EPOCHREALTIME

  for key in ${(k)ops_ino}; do
    (( ${agent_keys[(Ie)$key]} )) && continue
    __ops_forget $key
    changed=1
  done

  for key in $agent_keys; do
    f=$state_dir/$key.activity
    if ! zstat -H st "$f" 2>/dev/null; then
      if (( ${+ops_ino[$key]} )); then
        __ops_forget $key
        changed=1
      fi
      continue
    fi
    [[ ${st[inode]} == "${ops_ino[$key]:-}" ]] && (( st[size] == ${ops_size[$key]:-0} )) && continue

    changed=1
    content=$(<$f)
    # 読んでいる間に置き換わると,どちらの中身を読んだか分からないので次に最初から読み直す
    if ! zstat -H st2 "$f" 2>/dev/null || [[ ${st2[inode]} != "${st[inode]}" ]]; then
      __ops_forget $key
      continue
    fi
    lines=("${(@f)content}")
    # 切り詰めで置き換わった(inodeが違う)・作り直された(1行目が違う)時は最初から読み直す
    [[ ${st[inode]} == "${ops_ino[$key]:-}" && ${lines[1]} == "${ops_head[$key]:-}" ]] || __ops_forget $key
    n=${#lines}
    # 大きさが読んだ中身と末尾の改行1つの分に合わない時は,最後の行が書きかけかもしれないので次に読む
    __byte_len "$content"
    (( REPLY + 1 == st[size] )) || (( n-- ))
    ev=()
    for (( i = ${ops_seen[$key]:-0} + 1; i <= n; i++ )); do
      p=("${(@ps:\t:)lines[i]}")
      # 時刻で始まらない行は数として扱えず描き手ごと止まるので読み飛ばす
      [[ ${p[1]} == <->.<-> ]] || continue
      t=${p[1]} kind=${p[2]} tool=${p[3]} obj=${p[4]} extra=${p[5]} cwd=${p[6]}
      if [[ -n $cwd && $cwd != "${ag_cwd[$key]:-}" ]]; then
        __repo_root "$cwd"
        ag_cwd[$key]=$cwd ag_root[$key]=$REPLY
      fi
      ag_last[$key]=$t
      case $kind in
        U)
          case $obj in
            # チームのエージェントからの連絡は人の指示と分け(中身は出さない),ほかの < で始まる自動の入力は出さない
            '<agent-message'*) ag_turn_t[$key]=$t ag_end[$key]=''; __ops_add $t $key MSG 'チームのエージェントから連絡' ''; continue ;;
            '<'*) continue ;;
          esac
          # 新しい指示で,そのAIのこのターンの記録をやり直す
          ag_task[$key]=$obj ag_task_t[$key]=$t ag_turn_t[$key]=$t ag_end[$key]='' ag_wait[$key]='' ag_run[$key]=''
          ag_files[$key]=0 ag_add[$key]=0 ag_del[$key]=0
          for k in ${(k)ops_files}; do [[ ${ops_files[$k]%% *} == "$key" ]] && unset "ops_files[$k]"; done
          __ops_add $t $key ORDER "「$obj」" '' ;;
        P)
          case $tool in
            Bash | exec | shell)
              ag_run[$key]=$obj ag_run_t[$key]=$t
              __cmd_kind "$extra"
              [[ $REPLY == (COMMIT|PUSH) ]] && ag_mark[$key]=$REPLY ag_mark_t[$key]=$t
              __ops_add $t $key ${REPLY:-EXEC} "$obj" '' ;;
            Agent | Task) __ops_add $t $key SPAWN "$obj" "$extra" ;;
            WebFetch) __ops_add $t $key FETCH "${${obj#*://}%%/*}" '' ;;
            WebSearch) __ops_add $t $key SEARCH "$obj" '' ;;
            TodoWrite) [[ -n $obj ]] && __ops_add $t $key STEP "$obj" '' ;;
            AskUserQuestion) __ops_add $t $key ASK "$obj" '' ;;
            Skill) __ops_add $t $key SKILL "$obj" '' ;;
          esac ;;
        D | F)
          # 承認を待っていたツールが終われば(失敗も含む),承認待ちも終わっている
          [[ ${ag_wait[$key]:-} == "$obj" ]] && ag_wait[$key]=''
          case $tool in
            Bash | exec | shell) [[ ${ag_run[$key]:-} == "$obj" ]] && ag_run[$key]='' ;;
            Edit | Write | MultiEdit | NotebookEdit | apply_patch)
              # 失敗した編集はファイルを変えていないので数えない
              [[ $kind == D ]] || continue
              # パッチは複数のファイルをまとめて書くので,先頭のファイルに寄せる
              obj=${obj%%, *}
              [[ $obj == /* ]] || obj=${cwd:-$HOME}/$obj
              # 一時ディレクトリのファイルは作業ではないので出さない
              [[ $obj == (/tmp/*|/private/tmp/*|/var/folders/*) ]] && continue
              __repo_root "${obj:h}"; root=$REPLY
              a=${${extra%% *}#+} d=${${extra##* }#-}
              # 同じファイルを複数のAIが触っても,AIごとに数える
              k=$root$'\t'${obj#$root/}$'\t'$key
              if [[ -n ${ops_files[$k]:-} ]]; then
                v=(${=ops_files[$k]})
                ops_files[$k]="$key $(( v[2] + a )) $(( v[3] + d )) $(( v[4] + 1 )) $t"
              else
                ops_files[$k]="$key $a $d 1 $t"
                (( ++ag_files[$key] ))
              fi
              ag_add[$key]=$(( ${ag_add[$key]:-0} + a )) ag_del[$key]=$(( ${ag_del[$key]:-0} + d ))
              __ops_add $t $key EDIT "${obj#$root/}" "+$a -$d" ;;
          esac ;;
        W) ag_wait[$key]=$obj; __ops_add $t $key AWAIT "$obj" '' ;;
        S)
          ag_end[$key]=$t ag_run[$key]='' ag_wait[$key]=''
          # かかった時間は,ターンの始まり(指示か連絡)が分かる時だけ添える
          REPLY=''
          [[ -n ${ag_turn_t[$key]:-} ]] && __fmt_dur $(( t - ag_turn_t[$key] ))
          if (( ${ag_files[$key]:-0} == 1 )); then
            obj="1 file  +${ag_add[$key]} -${ag_del[$key]}"
          elif (( ${ag_files[$key]:-0} > 1 )); then
            obj="${ag_files[$key]} files  +${ag_add[$key]} -${ag_del[$key]}"
          else
            obj='no changes'
          fi
          __ops_add $t $key DONE "$obj${REPLY:+  in $REPLY}" '' ;;
      esac
    done
    (( ! ${#ev} )) || ops_ev[$key]+=${(F)ev}$'\n'
    ops_ino[$key]=${st[inode]} ops_size[$key]=${st[size]} ops_head[$key]=${lines[1]} ops_seen[$key]=$n
  done

  # AIごとの出来事を合わせて時刻順に並べる
  if (( changed )); then
    all=()
    for key in ${(k)ops_ev}; do
      all+=("${(@f)${ops_ev[$key]%$'\n'}}")
    done
    ops_log=("${(@on)all}")
  fi
  # 1時間より前の出来事は出さない(作業ログが変わらなくても,時間が経てば外す)
  for (( i = 1; i <= ${#ops_log}; i++ )); do
    (( ${ops_log[i]%%$'\t'*} < now - 3600 )) || break
  done
  if (( i > 1 )); then
    ops_log=("${(@)ops_log[i,-1]}")
    changed=1
  fi
  # 出来事もTARGETの名前も変わっていなければ,作っておいた作業ログの行をそのまま使う
  tsig=${(j: :)${(@kv)target_of}}
  (( changed )) || [[ $tsig != "$ops_tsig" ]] || return 0
  ops_tsig=$tsig
  # いちばん新しい出来事が変わったら,それを1文字ずつ打ち出し直す
  if [[ ${ops_log[-1]:-} != "$ops_newest" ]]; then
    ops_newest=${ops_log[-1]:-} ops_newest_at=$now
  fi
  __ops_cache_log
  return 0
}

# 色の指定を除いた見えている幅(全角は2)
__vis() {
  setopt localoptions extendedglob
  local p=${1//$'\e'\[[0-9;]#[mG]/}
  REPLY=${(m)#p}
}
# 色の指定の無い文字列を,見えている幅 $2 に切り詰める
__clip() {
  local s=$1
  if (( ${(m)#s} <= $2 )); then
    REPLY=$s
    return 0
  fi
  s=${s[1,$2]}
  while (( ${(m)#s} > $2 - 1 )); do s=${s[1,-2]}; done
  REPLY=$s…
}

# 作業ログの1行(いちばん新しいものから数えた $2 番目ほど暗くする,$3=1 なら打ち出す途中に使う色の無い文字列)
__ops_log_line() { # $1=出来事 $2=新しい順の位置(0が最新) $3=色の無い文字列にするか → REPLY
  local ts verb obj extra name label tc col
  local -a p
  integer iw=$(( pane_cols - 4 )) lw rw ow
  p=("${(@ps:\t:)1}")
  strftime -s ts '%H:%M:%S' ${p[1]%.*}
  __repo_name "${ag_root[${p[2]}]:--}"; name=$REPLY
  label=${target_of[${p[2]}]:-${p[2]}}
  verb=${p[3]} obj=${p[4]} extra=${p[5]}
  lw=$(( ops_label_w )) rw=16
  __clip "$label" $lw; label=$REPLY
  __clip "$name" $rw; name=$REPLY
  ow=$(( iw - 1 - 8 - 2 - lw - 2 - rw - 2 - 6 - 2 - (${#extra} ? ${#extra} + 2 : 0) ))
  (( ow < 8 )) && ow=8
  __clip "$obj" $ow; obj=$REPLY
  if (( ${3:-0} )); then
    REPLY=" $ts  ${(r:lw:)label}  ${(r:rw:)name}  ${(r:6:)verb}  $obj${extra:+  $extra}"
    return 0
  fi
  tc=${${(s: :):-255 252 249 246 244 242 240}[$(( $2 > 6 ? 7 : $2 + 1 ))]}
  col=${ops_verb_col[$verb]:-245}
  REPLY=$'\e[38;5;242m'" $ts  "$'\e[38;5;244m'"${(r:lw:)label}  "$'\e[38;5;37m'"${(r:rw:)name}  "$'\e[1;38;5;'${col}m"${(r:6:)verb}"$'\e[0;38;5;'${tc}m"  $obj"
  [[ -n $extra ]] && REPLY+="  "$'\e[38;5;34m'"${extra%% *}"$'\e[38;5;160m'" ${extra##* }"
  return 0
}

# 作業ログの行は読み直した時に作っておき,コマごとには最新の1行だけ作り直す
# 出せるのは多くてもペインの高さまでなので,新しい方からその分だけ作る
__ops_cache_log() {
  local label
  integer i n=${#ops_log} from
  ops_cache_cols=$pane_cols
  ops_cache_rows=$pane_rows
  # TARGETの列は出ているAIの名前の長さに合わせる(長すぎる名前は21桁で切る)
  ops_label_w=4
  for label in ${(v)target_of}; do (( ${(m)#label} > ops_label_w )) && ops_label_w=${(m)#label}; done
  (( ops_label_w > 21 )) && ops_label_w=21
  ops_cached=()
  from=$(( n - pane_rows > 1 ? n - pane_rows : 1 ))
  for (( i = from; i < n; i++ )); do
    __ops_log_line "${ops_log[i]}" $(( n - i )) 0
    ops_cached+=("$REPLY")
  done
  return 0
}

# 枠(色の指定を除いた見えている幅で右端をそろえる)
__ops_frame_top() {
  integer fill=$(( pane_cols - 10 - ${#1} - ${(m)#2} ))
  (( fill < 0 )) && fill=0
  REPLY=" "$'\e[38;5;30m╭─\e[1;38;5;51m'" $1 "$'\e[0;38;5;30m'"${(l:fill::─:):-}"$'\e[38;5;242m'" $2 "$'\e[38;5;30m─╮\e[0m'
}
__ops_frame_mid() {
  integer fill=$(( pane_cols - 10 - ${#1} - ${(m)#2} ))
  (( fill < 0 )) && fill=0
  REPLY=" "$'\e[38;5;30m├─\e[1;38;5;51m'" $1 "$'\e[0;38;5;30m'"${(l:fill::─:):-}"$'\e[38;5;242m'" $2 "$'\e[38;5;30m─┤\e[0m'
}
__ops_frame_line() {
  local body=$1
  integer pad iw=$(( pane_cols - 4 ))
  __vis "$body"
  # 狭いペインで中身が枠の内側より長い時だけ,色の指定は残して見えている幅で切る
  if (( REPLY > iw )); then
    __vis_cut "$body" $iw
    body=$REPLY
    __vis "$body"
  fi
  pad=$(( iw - REPLY ))
  REPLY=" "$'\e[38;5;30m│\e[0m'"$body"$'\e[0m'"${(l:pad:: :):-}"$'\e[38;5;30m│\e[0m'
}
# 色の指定はそのまま残し,見えている幅 $2 までで切る
__vis_cut() { # $1=文字列 $2=幅 → REPLY
  setopt localoptions extendedglob
  local s=$1 out='' ch
  integer w=0 cw
  while [[ -n $s ]]; do
    if [[ ${s[1]} == $'\e' ]]; then
      ch=${(M)s##$'\e'\[[0-9;]#[mG]}
      if [[ -n $ch ]]; then
        out+=$ch
        s=${s:${#ch}}
        continue
      fi
    fi
    ch=${s[1]}
    cw=${(m)#ch}
    (( w + cw > $2 )) && break
    out+=$ch
    w=$(( w + cw ))
    s=${s:1}
  done
  REPLY=$out
}
__ops_frame_bottom() { REPLY=" "$'\e[38;5;30m╰'"${(l:$(( pane_cols - 4 ))::─:):-}"$'╯\e[0m' }

# AIの名前(TARGET)と状態の記号(作業中は回し,判断待ちは脈打たせる)
__ops_badge() { # $1=キー $2=コマ → REPLY
  local label=${target_of[$1]:-$1}
  case ${agent_prio[$1]:-} in
    0) REPLY=$'\e[1;38;5;214m'"$label ${pulse[$2 / 2 % 8 + 1]}" ;;
    1) REPLY=$'\e[1;38;5;203m'"$label ●" ;;
    2) REPLY=$'\e[1;38;5;46m'"$label ${spin[$2 % 8 + 1]}" ;;
    *) REPLY=$'\e[38;5;242m'"$label ●" ;;
  esac
}

# WORKSPACE: リポジトリごとに,そこで動くAIと今のターンで触ったファイル・実行中のコマンド
__ops_ws() { # $1=使ってよい行数 $2=コマ → ops_ws 配列
  local root name k f line bar col dur relp agents key
  local -a roots files v picked sorted
  local -A last_of block_of
  integer i lvl shown working upto gap pw first max=$1 iw=$(( pane_cols - 4 ))
  float t age now=$EPOCHREALTIME
  ops_ws=()
  # リポジトリを,AIの作業ディレクトリと触ったファイルから集め,入りきらない時に残すものは新しく動いた順に選ぶ
  for key in ${(k)ag_root}; do root=${ag_root[$key]}; (( ${ag_last[$key]:-0} > ${last_of[$root]:-0} )) && last_of[$root]=${ag_last[$key]}; done
  for k in ${(k)ops_files}; do root=${k%%$'\t'*}; v=(${=ops_files[$k]}); (( v[5] > ${last_of[$root]:-0} )) && last_of[$root]=${v[5]}; done
  for root in ${(k)last_of}; do roots+=("${last_of[$root]}"$'\t'"$root"); done
  roots=("${(@On)roots}")
  ops_repo_count=${#roots}
  for line in $roots; do
    (( ${#ops_ws} < max )) || break
    root=${line#*$'\t'}
    __repo_name "$root"; name=$REPLY
    working=0 agents='' first=$(( ${#ops_ws} + 1 ))
    for key in $agent_keys; do
      [[ ${ag_root[$key]:-} == "$root" ]] || continue
      [[ ${agent_prio[$key]:-} == 2 ]] && working=1
      __ops_badge $key $2; agents+="  $REPLY"
      # 承認待ちは一覧の状態が判断待ちの時だけ出す(拒否や中断では作業ログに終わりが残らないため)
      if [[ -n ${ag_wait[$key]:-} && ${agent_prio[$key]:-} == 0 ]]; then
        __clip "${ag_wait[$key]}" 30; agents+=$'\e[0;38;5;214m'" AWAIT $REPLY"
      elif [[ -n ${ag_task[$key]:-} ]]; then
        __clip "${ag_task[$key]}" 28
        # 新しい指示が来た瞬間は1文字ずつ打ち出す
        age=$(( now - ag_task_t[$key] ))
        if (( age < 3 )); then
          upto=$(( age * 20 + 1 ))
          agents+=$'\e[0;38;5;195m'" 「${REPLY[1,upto]}"$'\e[1;38;5;51m█'
        else
          agents+=$'\e[0;38;5;245m'" 「$REPLY」"
        fi
      fi
      # ターンが終わってから10分は,かかった時間を添える(始まりが分からない時は印だけ)
      if [[ -n ${ag_end[$key]:-} && ${agent_prio[$key]:-} == [13] ]] && (( now - ag_end[$key] < 600 )); then
        if [[ -n ${ag_turn_t[$key]:-} ]]; then
          __fmt_dur $(( ag_end[$key] - ag_turn_t[$key] )); agents+=$'\e[0;38;5;71m'" ✓ $REPLY"
        else
          agents+=$'\e[0;38;5;71m'" ✓"
        fi
      fi
      # コミット・プッシュの直後は金色の札を点滅させる
      if [[ -n ${ag_mark[$key]:-} ]] && (( now - ag_mark_t[$key] < 8 && $2 / 3 % 2 )); then
        if [[ ${ag_mark[$key]} == COMMIT ]]; then agents+=$'\e[1;38;5;220m  ◆ COMMIT'; else agents+=$'\e[1;38;5;220m  ▲ PUSH'; fi
      fi
    done
    # リポジトリの札: そこで作業中のAIがいれば光が脈打つ
    if (( working )); then col=${${(s: :):-51 45 38 31 38 45}[$(( $2 / 2 % 6 + 1 ))]}; else col=244; fi
    ops_ws+=(" "$'\e[1;38;5;'${col}m"▣ "$'\e[1;38;5;255m'"$name"$'\e[0;38;5;23m'" ─"$agents)
    # そのリポジトリで今のターンに触ったファイル(新しい順に3つまで)
    files=()
    for k in ${(k)ops_files}; do [[ ${k%%$'\t'*} == "$root" ]] || continue; v=(${=ops_files[$k]}); files+=("${v[5]}"$'\t'"$k"); done
    files=("${(@On)files}")
    shown=0
    for f in $files; do
      (( shown < 3 && ${#ops_ws} < max )) || break
      k=${f#*$'\t'}; v=(${=ops_files[$k]})
      age=$(( now - v[5] ))
      # 熱量: 触ってから時間が経つほど短く暗くなる
      if (( age < 30 )); then lvl=6; elif (( age < 120 )); then lvl=5; elif (( age < 300 )); then lvl=4; elif (( age < 600 )); then lvl=3; elif (( age < 1200 )); then lvl=2; else lvl=1; fi
      bar=''
      for (( i = 1; i <= 6; i++ )); do
        if (( i <= lvl )); then bar+=$'\e[38;5;'${${(s: :):-22 28 34 40 46 120}[i]}m'▮'; else bar+=$'\e[38;5;236m▯'; fi
      done
      __fmt_dur $age; dur=$REPLY
      pw=$(( iw - 48 - ops_label_w )); (( pw < 8 )) && pw=8
      __clip "${${k#*$'\t'}%$'\t'*}" $pw; relp=$REPLY
      # 書き込んだ瞬間はその行を白く光らせる
      if (( age < 1.5 )); then line="   "$'\e[1;38;5;231m'"✎ $relp"; else line="   "$'\e[38;5;48m'"✎ "$'\e[38;5;252m'"$relp"; fi
      __vis "$line"
      gap=$(( iw - 38 - ops_label_w - REPLY )); (( gap < 1 )) && gap=1
      ops_ws+=("$line${(l:gap:: :):-}  $bar"$'\e[0;38;5;34m'" +${v[2]}"$'\e[38;5;160m'" -${v[3]}"$'\e[38;5;242m'"  ×${v[4]}  ${(l:6:: :)dur}  "$'\e[38;5;244m'"${target_of[${v[1]}]:-${v[1]}}")
      (( ++shown ))
    done
    # そのリポジトリで動いているAIの,実行中のコマンド
    # (中断・拒否では作業ログに終わりが残らないため,一覧の状態が作業中の時だけ出す)
    for key in $agent_keys; do
      [[ ${ag_root[$key]:-} == "$root" && -n ${ag_run[$key]:-} && ${agent_prio[$key]:-} == 2 ]] || continue
      (( ${#ops_ws} < max )) || break
      __fmt_dur $(( now - ag_run_t[$key] )); dur=$REPLY
      pw=$(( iw - 34 - ops_label_w )); (( pw < 8 )) && pw=8
      __clip "${ag_run[$key]}" $pw
      ops_ws+=("   "$'\e[38;5;51m▶ \e[38;5;250m'"$REPLY  "$'\e[38;5;51m'"${spin[$2 % 8 + 1]}"$'\e[38;5;245m'" $dur  "$'\e[38;5;244m'"${target_of[$key]:-$key}")
    done
    block_of[$root]="$first ${#ops_ws}"
    picked+=("$name"$'\t'"$root")
  done
  # 並びは名前の順にして,AIが動くたびにリポジトリの行が入れ替わらないようにする
  for line in ${(o)picked}; do
    v=(${=block_of[${line#*$'\t'}]})
    sorted+=("${(@)ops_ws[v[1],v[2]]}")
  done
  ops_ws=("${sorted[@]}")
  return 0
}

# 作業ログ: 有益な出来事だけを新しいものを下に出す(いちばん新しい行は1文字ずつ打ち出し,判断待ちの間の承認待ちは脈打たせる)
__ops_log_lines() { # $1=行数 $2=コマ → ops_lg 配列
  local plain
  local -a p
  integer n=${#ops_log} c=${#ops_cached} take typed
  float now=$EPOCHREALTIME
  ops_lg=()
  (( n )) || return 0
  take=$(( $1 - 1 )); (( take > c )) && take=$c
  (( take > 0 )) && ops_lg=("${(@)ops_cached[c-take+1,c]}")
  typed=$(( (now - ops_newest_at) * 80 ))
  __ops_log_line "${ops_log[n]}" 0 1; plain=$REPLY
  if (( typed < ${#plain} )); then
    ops_lg+=($'\e[38;5;195m'"${plain[1,typed]}"$'\e[1;38;5;51m█')
  else
    __ops_log_line "${ops_log[n]}" 0 0
    p=("${(@ps:\t:)ops_log[n]}")
    [[ ${p[3]} == AWAIT && ${agent_prio[${p[2]}]:-} == 0 ]] && (( $2 / 3 % 2 )) && REPLY=${REPLY//$'\e[1;38;5;214m'/$'\e[1;38;5;94m'}
    ops_lg+=("$REPLY")
  fi
}

# 余白 $1 行に収まる枠を ops_panel に作る(ワークスペースは要る分だけ,多くても半分まで,残りを作業ログに使う)
__ops_panel() { # $1=行数 $2=コマ
  local -a out
  integer h=$1 wh lh i agents_n=0
  local key
  # ペインの幅が変わった・作っておいたより高くなったら,作業ログの行を今の大きさで作り直す
  (( ops_cache_cols == pane_cols && ops_cache_rows >= pane_rows )) || __ops_cache_log
  for key in $agent_keys; do [[ -n ${ag_last[$key]:-} ]] && (( ++agents_n )); done
  __ops_ws $(( (h - 3) / 2 )) $2
  wh=${#ops_ws}
  lh=$(( h - 2 - (wh ? wh + 1 : 0) ))
  if (( wh )); then
    __ops_frame_top 'WORKSPACE' "$ops_repo_count REPOS / $agents_n GHOSTS"; out=("$REPLY")
    for (( i = 1; i <= wh; i++ )); do __ops_frame_line "${ops_ws[i]}"; out+=("$REPLY"); done
    __ops_frame_mid 'OPS.LOG' "${#ops_log} EVENTS / 1h"; out+=("$REPLY")
  else
    __ops_frame_top 'OPS.LOG' "${#ops_log} EVENTS / 1h"; out=("$REPLY")
  fi
  __ops_log_lines $lh $2
  for (( i = 1; i <= lh - ${#ops_lg}; i++ )); do __ops_frame_line ''; out+=("$REPLY"); done
  for (( i = 1; i <= ${#ops_lg}; i++ )); do __ops_frame_line "${ops_lg[i]}"; out+=("$REPLY"); done
  __ops_frame_bottom; out+=("$REPLY")
  ops_panel=("${out[@]}")
}

# 描画済みの内容(lines)をペインに収めて出す(作業中の行は回し,判断待ちの行は脈打たせる)
# 1秒10コマで呼ぶため,ペインの高さは大きさが変わり得る時(size_stale)だけ聞き直す
__draw() {
  local size
  integer f top nl

  if (( size_stale )); then
    # 端末の縦幅はtmuxが続けてペインの大きさを変えると最大0.25秒遅れて届き,古い縦幅で描くと溢れた分だけ
    # 表示が上にずれるため,tmuxの中では大きさを変えた時点で変わるペインの高さを使う
    [[ -z ${TMUX_PANE:-} ]] || size=$(tmux display -p -t "$TMUX_PANE" '#{pane_height} #{pane_width}' 2>/dev/null || true)
    # tput lines はstdoutもstderrも端末でないと実際の縦幅が取れず既定の24を返すため,端末に直接聞く
    [[ -n $size ]] || size=$(stty size </dev/tty 2>/dev/null || print '24 80')
    pane_rows=${size%% *}
    pane_cols=${size##* }
    size_stale=0
  fi
  # 閃光: 状態が変わってから0.4秒,STATUSを反転させて2度点滅させる(このコマだけなので一覧の写しに付ける)
  local -a lines=("${lines[@]}")
  local id
  integer age i
  for id in ${(k)flash_at}; do
    age=$(( (EPOCHREALTIME - flash_at[$id]) * 10 ))
    if (( age >= 4 )); then
      unset "flash_at[$id]"
      continue
    fi
    i=${line_of[$id]:-0}
    (( i && age != 2 )) || continue
    if [[ ${lines[i]} == *'● '* ]]; then
      lines[i]=${lines[i]/● /$'\e[7m'● }
    else
      lines[i]=${lines[i]/○ /$'\e[7m'○ }
    fi
  done
  __compose_screen "$pane_rows"
  # コマは時刻から決め,キーを押して描き直しが増えても速さが変わらないようにする
  f=$(( EPOCHREALTIME * 10 ))
  out=${out//● Working/${spin[f % ${#spin} + 1]} Working}
  out=${out//● Input/${pulse[f / 2 % ${#pulse} + 1]} Input}
  # 一覧が収まって下に6行以上余る時は,余白に作業の見える化を出す(下に開いて一覧を中身の高さに縮めた時は出ない)
  # 枠の上端は,一覧の下に空行を1行置いた位置か上から ops_top_pct %の位置の低い方にする(枠の6行は残す)
  if (( ${#lines} + 7 <= pane_rows )); then
    top=$(( pane_rows * ops_top_pct / 100 ))
    (( top > ${#lines} )) || top=$(( ${#lines} + 1 ))
    (( top <= pane_rows - 6 )) || top=$(( pane_rows - 6 ))
    __ops_panel $(( pane_rows - top )) $f
    # 一覧の最後の行を終える改行と,枠までの空行の分
    nl=$(( top - ${#lines} + 1 ))
    out+=${(pl:nl::\n:):-}"${(pj:\n:)ops_panel}"
  fi
  # 何も動いていない時に端末へ書き続けないよう,前のコマと大きさも中身も同じなら書き直さない
  [[ "$pane_rows $pane_cols"$'\n'$out != "$drawn" ]] || return 0
  drawn="$pane_rows $pane_cols"$'\n'$out
  # 1コマを書き終えるまでtmuxにペインを出させず,消してから描き直す途中の姿を見せない
  printf '\e[?2026h\e[H\e[J%s\e[?2026l' "$out"
}

# 次(1)/前(-1)の選択できるペインIDを返す(未選択ならC-nは先頭から,C-pは末尾から始める)
__step_selection() {
  local direction current
  integer n idx

  direction=$1
  current=$2
  shift 2
  n=$#

  (( n )) || return 0

  idx=${@[(ie)$current]}
  if (( direction > 0 )); then
    (( idx > n )) && idx=0
    print -r -- "${@[idx % n + 1]}"
  else
    (( idx > n )) && idx=1
    print -r -- "${@[(idx - 2 + n) % n + 1]}"
  fi
}

if [[ ${1:-} == --once ]]; then
  __render | while IFS= read -r line; do print -r -- "${${${line#*$'\t'}#*$'\t'}#*$'\t'}"; done
  exit 0
fi

# watch表示(一覧は裏で1秒ごとに組み立て,ここでは1秒10コマで描き直す, Escで終了)
# 代替画面を使う(通常バッファに上書きし続けると溢れた分がペインのスクロールになり,
# iTerm2は既定でalternate screenから流れた行をscrollbackへ送るため端末側の表示がずれていく)
# 下に開いたAIを入れ替えたまま残さないよう,終了時(ペインやウィンドウを閉じた時も含む)に元の配置へ戻し,裏の組み立ても止める
# 下に開いたAIから一覧へ戻ったことや,ウィンドウを移ってから一覧へ戻ったことを知るため,フォーカスの出入りも通知させる
# (tmuxのfocus-eventsがonの時だけ届く)
last_swap=()
dir_panes=()
left_window=0
gen=0
need_render=0
size_stale=1
drawn=''
render_seq=''
render_pid=''
# 裏で組み立てた一覧と,手元で変えた中身(世代と下に開いたAI)を受け渡す場所
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/ai-bridge.XXXXXX")
render_file=$work_dir/rendered
ctl_file=$work_dir/ctl
print -r -- 0 >| "$ctl_file"
# ペインを閉じた時は描き直しや停止が失敗し得るが,set -e で後片付けが途中で止まらないよう失敗しても続ける
trap '__undo_swap || true; [[ -z $render_pid ]] || kill $render_pid 2>/dev/null || true; rm -rf -- "$work_dir"; printf "\e[?2026l\e[?1004l\e[?7h\e[?25h\e[?1049l"' EXIT
trap 'exit 0' INT TERM HUP
# ペインの大きさが変わったら,次のコマで高さを聞き直す
trap 'size_stale=1' WINCH
printf '\e[?1049h\e[?7l\e[?25l\e[?1004h'

# iTerm2のウィンドウをまたいだジャンプはmacOSのAppleScriptで行うため,macOS以外やtmuxの外では選択自体を無効にする
if [[ $OSTYPE == darwin* && -n ${TMUX:-} ]] && (( $+commands[osascript] )); then
  selectable=1
else
  selectable=0
fi
selected_id=''
scroll_top=1

# 最初の一覧は裏の組み立てを待たずにその場で出す
rendered=("${(@f)$(__render)}")
__split_rendered
__ops_load
__render_loop >/dev/null 2>&1 &
render_pid=$!

while :; do
  # 裏で組み立て終えた一覧のうち,手元で最後に中身を変えた後に組み立てたもの(世代が今と同じもの)だけを取り込む
  # (起動直後は裏がまだ一覧を書いていないので,ファイルがある時だけ読む)
  if [[ -r $render_file ]] && read -r new_seq new_gen < "$render_file" && [[ $new_seq != "$render_seq" && $new_gen == "$gen" ]]; then
    rendered=("${(@f)$(<"$render_file")}")
    rendered[1]=()
    render_seq=$new_seq
    __split_rendered
    __ops_load
    size_stale=1
  fi
  __draw

  if [[ -t 0 ]]; then
    # 押したキーがエコーされると,カーソルのある画面右下に ^N 等が次の再描画まで残るため -s で抑える
    if read -s -t 0.1 -k 1 key 2>/dev/null; then
      case $key in
        $'\e')
          # 矢印キー等はEscに続く文字と一緒に届くため,単独のEscの時だけ終了する
          if ! read -s -t 0.05 -k 1 rest 2>/dev/null; then
            break
          fi
          # ESC [ で始まる列は終端の文字(@〜~)まで読む(直後に届いたキーまで読み捨てないよう終端で止める)
          esc_seq=$rest
          if [[ $rest == '[' ]]; then
            rest=''
            while [[ $rest != [@-~] ]] && read -s -t 0.01 -k 1 rest 2>/dev/null; do
              esc_seq+=$rest
            done
          fi
          # フォーカスが外れた(\e[O)時,この一覧のウィンドウがカレントでなくなっていればウィンドウを移ったと覚えておく
          # (アプリの切り替えではカレントのウィンドウが変わらないので,そこから戻ってもC-lで開いたウィンドウは閉じない)
          if [[ $esc_seq == '[O' ]] && (( ${#dir_panes} )) && [[ $(tmux display -p -t "${TMUX_PANE:-}" '#{window_active}' 2>/dev/null) == 0 ]]; then
            left_window=1
          fi
          # フォーカスが戻った(\e[I)時,直前にいたペインが下に開いたAIなら作業を終えたとみなして q と同じく元に戻す
          # 描画中に届いて遅れて処理しても判定がずれないよう,印を持たずにその時点のtmuxの「直前のペイン」で決める
          # (別のウィンドウから入れ替えたAIは入れ替えた時点では履歴に載らないため,ウィンドウやアプリの切り替えから戻っても閉じない)
          if [[ $esc_seq == '[I' ]] && (( ${#last_swap} )) && [[ $(tmux display -p -t "${last_swap[1]}" '#{pane_last}' 2>/dev/null) == 1 ]]; then
            __undo_swap
          fi
          # ウィンドウを移ってから戻った時は,C-lで開いたウィンドウのうちシェルに戻っているものを閉じる
          if [[ $esc_seq == '[I' ]]; then
            (( ! left_window )) || __close_dir_window
            left_window=0
          fi
          ;;
        $'\x0e') # Ctrl+n
          if (( selectable )); then
            selected_id=$(__step_selection 1 "$selected_id" "${jump_ids[@]}")
          fi
          ;;
        $'\x10') # Ctrl+p
          if (( selectable )); then
            selected_id=$(__step_selection -1 "$selected_id" "${jump_ids[@]}")
          fi
          ;;
        $'\x13') # Ctrl+s
          if (( selectable )) && [[ -n $selected_id ]]; then
            __open_below "$selected_id"
          fi
          ;;
        $'\x0b') # Ctrl+k
          # 未選択なら判断待ち,無ければ完了のうち一番上を開く(選択は変えないので,次も一番上から選び直す)
          open_id=${selected_id:-$attention_id}
          if (( selectable )) && [[ -n $open_id ]]; then
            __open_and_focus_below "$open_id"
          fi
          ;;
        [1-9])
          if (( selectable && key <= ${#jump_ids} )); then
            selected_id=${jump_ids[key]}
            __open_and_focus_below "$selected_id"
          fi
          ;;
        $'\n' | $'\r')
          if (( selectable )) && [[ -n $selected_id ]]; then
            # 下に開いているAIや,それと入れ替わったAIは元の位置へ戻してから移る
            if [[ $selected_id == "${last_swap[1]:-}" || $selected_id == "${last_swap[2]:-}" ]]; then
              __undo_swap
            fi
            __jump "$selected_id"
          fi
          ;;
        $'\x0c') # Ctrl+l
          if (( selectable )) && [[ -n $selected_id ]]; then
            __open_dir_window "$selected_id"
          fi
          ;;
        q)
          if (( selectable )); then
            __undo_swap
          fi
          ;;
        $'\x07') # Ctrl+g
          selected_id=''
          ;;
      esac
      # 下に開いた等で中身が変わった時はその場で組み立て直し,選択の表示も裏を待たずに作り直す
      if (( need_render )); then
        rendered=("${(@f)$(__render)}")
        need_render=0
      fi
      __split_rendered
      __ops_load
    fi
  else
    sleep 1
  fi
done
