#!/usr/bin/env zsh
# AIエージェント(claude/codex)の状態一覧をwatch表示する(tmux内外を統合)
#
# 使い方:
#   ai-bridge           # 自動更新表示(1秒間隔, Escで終了)
#   ai-bridge --once    # 1回だけ出力して終了
#   ai-bridge --session <セッション名>  # d・C-d・Space でAIを起動する先のtmuxセッションを指定する(無ければこのai-bridgeがいるセッション)
#
# 表示対象:
#   tmux内のエージェント: <pane_id>.state (TARGET=セッション:window.pane)
#   tmux外のエージェント: sid-<session_id>.state (TARGET=tty, 制御端末なしはheadless)
set -eu

zmodload zsh/datetime
# 裏で一覧を組み立てる時の待ちと置き換えを,外部コマンドを起動せずに行う
zmodload zsh/zselect
zmodload -F zsh/files b:zf_mv
# 作業ログが変わったかを外部コマンドを起動せずに調べる
zmodload -F zsh/stat b:zstat

# 置き場は役割で分ける(新しいファイルもこれに従う)
#   設定 ~/.config/ai_agents: 人が決めて置くもの(どのAIを使うか等)
#   データ AI_AGENTS_DATA_DIR_PATH(~/.local/share/ai_agents): 人が書いたもの(+ のメモ・保存済みのセッションの一覧),AIのサンドボックスの中のコマンドからも書ける
#   状態 AI_AGENTS_STATE_DIR_PATH(~/.local/state/ai_agents): ai-bridge と hook が書く今の様子(AIごとの状態・O で保存したAI・push の許可),
#     AIのサンドボックスの中からは書けない(Claude も Codex も hook はサンドボックスの外で動くため,状態の置き場を書ける場所に入れなくてよい)
#   書けるかはサンドボックスの設定(claude/settings.json の sandbox.filesystem.allowWrite,codex/config.toml の workspace_roots)で決まり,
#   push の許可のようにAIに書き換えられては困るものはデータに置かない
#   (AIを ~ 等で起動すると起動したディレクトリごと書ける場所に入るため,push の許可は Read・Edit の deny,Codex の deny でも守る)
state_root=${AI_AGENTS_STATE_DIR_PATH:-}
data_root=${AI_AGENTS_DATA_DIR_PATH:-}
if [[ -z $state_root || -z $data_root ]]; then
  print "$0: AI_AGENTS_STATE_DIR_PATH and AI_AGENTS_DATA_DIR_PATH must be set"
  exit 1
fi

state_dir=$state_root/state

# 作業中の行を回し,判断待ちの行を脈打たせるコマ(描き直しは1秒10コマ)
spin=(⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷)
pulse=(● ◉ ◎ ○ ○ ◎ ◉ ●)
# 状態が変わった行を閃光で知らせるため,ペインごとの前回の状態・光らせ始めた時刻・一覧での行の位置を持つ
typeset -A row_state flash_at line_of
split_once=0
# 一覧の下の作業の見える化で使う,一覧に出ているAIのキー(並び順)・TARGET・優先度
agent_keys=()
typeset -A target_of agent_prio
# C-s で下に開いた時の一覧のAIのキーの並び(開いている間はこの並びのままにする,__keep_browse_order)
browse_order=()
# キーの説明は1行にまとめると14インチの画面のウィンドウ(107桁)で見切れるため,4つに分けて ? を押すごとに順に見出しへ出す
# 時刻はいつもの見出し(__render_title)にだけ出し,ここの説明は時刻に代えて出す(show_keys は出している方の番号,0はいつもの見出し)
# (区切りは空白1つにし,C-n/C-p は C-n/p と縮める,見出しの幅はいつもの104桁に対して104桁・105桁で,i・+・- はどれに足しても107桁を超えるため4つ目に分ける)
key_help=(
  'C-n/p:select C-s:open-close C-k:open-below C-;:reply C-l:open-dir C-y:copy-target C-u:clear'
  'e:restart E:restart-all x:exit X:exit-all O:save-all R:restore-all g:browse-repo C-g:open-pr'
  'i:info +:edit-info -:remove-info'
)
show_keys=0
# 一覧の下の作業の見える化(WORKSPACE・OPS.LOG・SYSTEM)は,起動時は出さず a を押した時だけ出す
show_ops=0
# i を押している間は,一覧の MODEL から後ろの列の代わりに,+ で書いたメモ(INFO)を出す
info_view=0
# X・x(一括・選んだ1つの終了)・E・e(一括・選んだ1つの再起動)・O(保存)・R(復元)を実行する前の確かめ(出している間は見出しを確かめの文に差し替え,y で実行する)
# confirm_action は確かめている操作で,exit・restart・save・restore のどれか(確かめていない時は空)
confirm_action=''
confirm_prompt=''
exit_targets=()
exit_note=''
integer exit_working was_confirming
# E・e で再起動するペインIDと,ペインごとにシェルへ送る再開コマンド
restart_targets=()
typeset -A restart_command
# O で保存し R で復元するAI(1行に AIの種類・セッションID・モデル・effort・起動したディレクトリ・いたセッション・ウィンドウ番号をタブ区切りで並べる)と,その保存先
save_lines=()
restore_lines=()
resurrect_file=$state_root/resurrect.tsv
# + で書いたメモの置き場(AIのセッションIDごとに1つのファイルに置き,中身が空ならメモ無し)
# セッションIDごとにするのは,E・e の再起動や R の復元,保存済みのセッションの起動で開き直しても同じセッションIDで再開され,メモが付いてくるため
info_dir=$data_root/info

# 一覧の行を作る小さな関数は,行ごとに何度も呼ぶため,サブシェルを起こさないよう結果を REPLY に入れる

# 一覧の並び順(上ほど対応が必要): blocked > done > working > idle > spare
__priority_for() { # $1=状態 → REPLY
  case $1 in
    blocked) REPLY=0 ;;
    done)    REPLY=1 ;;
    working) REPLY=2 ;;
    spare)   REPLY=4 ;;
    *)       REPLY=3 ;;
  esac
}

# 状態ラベル(ANSI色付き・パディング込みで幅を揃える)
# 判断待ちで待っている項目が分かる時は Input(Bash) のように添える(添えた最長の Input(Skill) に幅を合わせる)
__label_for() { # $1=状態 $2=待っている項目 → REPLY
  local text color

  case $1 in
    blocked) text="● Input${2:+($2)}"; color='1;33' ;;
    done)    text='● Done';            color='1;31' ;;
    working) text='● Working';         color='32' ;;
    spare)   text='○ Spare';           color='90' ;;
    *)       text='● Idle';            color='90' ;;
  esac

  __pad "$text" 14
  REPLY=$'\e['"${color}m$REPLY"$'\e[0m'
}

# 判断待ちの項目(ai-agent-stateが記録したツール名)を一覧用の短い名前にする
# 縮めると紛らわしいまれなツールは空にし,種類なしの Input にする
__wait_label() { # $1=ツール名 → REPLY
  case $1 in
    Bash | PowerShell)                          REPLY=Bash ;;
    Edit | Write | NotebookEdit | apply_patch)  REPLY=Edit ;;
    Read | Grep | Glob)                         REPLY=Read ;;
    WebFetch | WebSearch)                       REPLY=Web ;;
    mcp__*)                                     REPLY=MCP ;;
    Skill)                                      REPLY=Skill ;;
    ExitPlanMode)                               REPLY=Plan ;;
    AskUserQuestion)                            REPLY=Q ;;
    *)                                          REPLY='' ;;
  esac
}

# 表示幅ベースで切り詰め+右パディングする(全角文字を含む名前の列ズレ対策)
__pad() { # $1=文字列 $2=幅 → REPLY
  local text width w
  text=$1
  width=$2

  w=${(m)#text}
  while (( w > width )); do
    text=${text[1,-2]}
    w=${(m)#text}
  done
  REPLY=$text${(l:width-w:: :):-}
}

# トークン数を 61K / 1M 形式に
__fmt_tokens() { # $1=トークン数 → REPLY
  local t
  t=${1:-0}
  if   (( t >= 1000000 )); then printf -v REPLY '%dM' $(( t / 1000000 ))
  elif (( t >= 1000 ));    then printf -v REPLY '%dK' $(( t / 1000 ))
  else                          printf -v REPLY '%d' $t
  fi
}

# 最終更新からの経過時間を 8s / 15m / 2h 形式に
__fmt_last() { # $1=更新時刻 → REPLY
  local rem
  # NOTE: (( rem = ... )) は結果0でexit 1となりset -eで死ぬため算術展開で代入する
  rem=$(( EPOCHSECONDS - $1 ))
  (( rem < 0 )) && rem=0
  if   (( rem < 60 ));   then REPLY=${rem}s
  elif (( rem < 3600 )); then REPLY=$(( rem / 60 ))m
  else                        REPLY=$(( rem / 3600 ))h
  fi
}

# 利用枠リセットまでの残り時間を 2d 5h / 5h 30m / 30m 形式に
__fmt_reset() {
  local rem d h m
  rem=$(( $1 - EPOCHSECONDS ))
  (( rem < 0 )) && rem=0
  d=$(( rem / 86400 ))
  h=$(( (rem % 86400) / 3600 ))
  m=$(( (rem % 3600) / 60 ))
  if   (( d > 0 )); then print "${d}d ${h}h"
  elif (( h > 0 )); then print "${h}h ${m}m"
  else                   print "${m}m"
  fi
}

# 使用率(0-100)から8マスのバーを生成する(claude-code-statuslineと同じ見た目に揃える)
__usage_bar() {
  local pct filled empty bar
  pct=${1:-0}
  filled=$(( pct * 8 / 100 ))
  (( filled > 8 )) && filled=8
  (( filled < 0 )) && filled=0
  empty=$(( 8 - filled ))
  bar=''

  repeat $filled; do bar+='▰'; done
  repeat $empty; do bar+='▱'; done
  print -rn -- "$bar"
}

# 使用率に応じたANSI色(緑<50 / 黄<80 / 赤>=80)
__usage_color() { # $1=使用率 → REPLY
  if   (( ${1:-0} >= 80 )); then REPLY=31
  elif (( ${1:-0} >= 50 )); then REPLY=33
  else                           REPLY=32
  fi
}

# 利用枠1つ分のセグメントを組み立てる(window=5h/7d, values="使用率 リセットepoch")
# 枠を横並びにしても桁が揃うよう,リセット表記まで含めて固定幅(26列)にする
__format_window() {
  local window values pct reset reset_txt color

  window=$1
  values=$2

  if [[ -z ${values:-} ]]; then
    printf '%26s' ''
    return 0
  fi

  pct=${values%% *}
  reset=${values#* }
  reset_txt=''
  [[ -n ${reset:-} ]] && reset_txt="($(__fmt_reset "$reset"))"
  __usage_color "$pct"
  color=$REPLY

  printf '%-2s \e[%sm%s\e[0m %3d%% %-9s' \
    "$window" "$color" "$(__usage_bar "$pct")" "$pct" "$reset_txt"
}

# エージェント1行を組み立てる(5時間枠と週次枠を横並びにする)
__format_agent_line() {
  local label h5 d7 line

  label=$1
  h5=$2
  d7=$3

  line=$(printf '  %-7s %s %s' "$label" "$(__format_window 5h "$h5")" "$(__format_window 7d "$d7")")
  while [[ $line == *' ' ]]; do line=${line% }; done

  print -r -- "$line"
}

# claudeのmeta.jsonから枠ごとの候補を作るために取る値を "<transcriptの場所>\t<5時間枠>\t<週次枠>" にする jq の式
# (枠は "使用率 リセットepoch",その枠の値が無ければ空)
claude_window_jq='def w($p; $r): if .[$p] != null then "\(.[$p] | floor) \(.[$r] // 0)" else "" end;
  "\(.transcript_path // "")\t\(w("h5_pct"; "h5_reset"))\t\(w("d7_pct"; "d7_reset"))"'

# claudeのmeta.jsonから枠ごとの候補を "<枠> <最終assistant時刻> <使用率> <リセットepoch>" 形式で列挙する
# statusLineが受け取るrate_limitsはセッションによって5時間枠だけ欠けることがあり,
# 最新1件に固定すると枠が出たり消えたりするため,アカウント単位で共通な値を枠ごとに独立して探す
# 各セッションの値はそのセッションの最終API応答時点のもので,待機中のセッションも古い値のまま書き直し続けるため
# meta.jsonやtranscriptの更新時刻では選べない(transcriptにはAPI応答なしでメタデータ行が足されることがある)
# 手動リセットでは同じ枠のまま使用率が下がるため最大値でも選べず,最後のassistantエントリが最も新しいセッションの値を採る
# transcriptの読み込みが重いため,両枠ぶんを1回の走査でまとめて出す
# meta.json は全部のAIの分を1回の jq で読む(どれかが壊れていると,jq はそこから先を読まずに止まるため,その時は1つずつ読む)
# 最後のassistantの時刻は,transcriptの大きさと更新時刻が前に調べた時と同じなら,前に調べた値を使う
# (transcriptは追記されていくだけなので,どちらも同じなら中身も同じで,待機中のAIのtranscriptはほとんど変わらない)
# (調べた値は,ai-bridge をいくつ開いていても使えるよう,state_dir の .usage_last_at に置く)
__claude_window_candidates() {
  local meta_file line transcript_path h5 d7 last_at out cache f
  local -a fields metas
  local -A rows seen fresh st

  cache=$state_dir/.usage_last_at
  if [[ -r $cache ]]; then
    while IFS=$'\t' read -r f line; do
      seen[$f]=$line
    done < "$cache"
  fi

  metas=("$state_dir"/*.meta.json(N))
  if (( ${#metas} )) && out=$(jq -r "$claude_window_jq"' as $v | "\(input_filename)\t\($v)"' "${metas[@]}" 2>/dev/null); then
    for line in ${(f)out}; do
      rows[${line%%$'\t'*}]=${line#*$'\t'}
    done
  else
    for meta_file in "${metas[@]}"; do
      line=$(jq -r "$claude_window_jq" "$meta_file" 2>/dev/null) || continue
      rows[$meta_file]=$line
    done
  fi

  for meta_file in "${metas[@]}"; do
    (( ${+rows[$meta_file]} )) || continue
    fields=("${(@ps.\t.)rows[$meta_file]}")
    transcript_path=${fields[1]:-}
    h5=${fields[2]:-}
    d7=${fields[3]:-}
    [[ -n $h5 || -n $d7 ]] || continue

    # transcriptは数十MBになるため末尾だけを読む(UTCのISO8601は文字列順が時刻順になる)
    last_at=''
    if zstat -H st "$transcript_path" 2>/dev/null; then
      if [[ ${seen[$transcript_path]-} == ${st[size]}$'\t'${st[mtime]}$'\t'* ]]; then
        last_at=${seen[$transcript_path]#*$'\t'*$'\t'}
      else
        last_at=$(tail -c 262144 "$transcript_path" 2>/dev/null \
          | grep -F '"type":"assistant"' \
          | jq -Rr 'fromjson? | select(.type == "assistant") | .timestamp // empty' 2>/dev/null \
          | tail -n 1)
      fi
      fresh[$transcript_path]=${st[size]}$'\t'${st[mtime]}$'\t'$last_at
    fi
    [[ -n $h5 ]] && print -r -- "h5 ${last_at:-0} $h5"
    [[ -n $d7 ]] && print -r -- "d7 ${last_at:-0} $d7"
  done

  { for f in ${(k)fresh}; do print -r -- "$f"$'\t'"${fresh[$f]}"; done >| "$cache.$$" && zf_mv -f "$cache.$$" "$cache" } 2>/dev/null || true
  return 0
}

# 最後のassistantの時刻で並べ替えた候補から,指定枠の "使用率 リセットepoch" を返す
__claude_window() { # $1=枠 $2..=並べ替えた候補
  local window best line reset pct

  window=$1
  shift

  # 同じ枠のうち,並べ替えで最後になるもの(最後のassistantが最も新しいもの)を採る
  best=''
  for line in "$@"; do
    [[ $line == "$window "* ]] && best=${line#* }
  done
  [[ -n ${best:-} ]] || return 0

  reset=${best##* }
  pct=${${best#* }%% *}

  # リセット不明時も "使用率 " の形を保つ(呼び出し側が空白区切りで分解するため)
  if (( reset > 0 )); then
    print -r -- "$pct $reset"
  else
    print -r -- "$pct "
  fi
}

# claudeの5時間/週次利用枠
__usage_lines_claude() {
  local candidates h5 d7
  local -a sorted

  candidates=$(__claude_window_candidates)
  # 枠ごとに最後のassistantの時刻で選ぶため,候補を時刻(2列目)で1回だけ並べ替える
  # (枠ごとに分けてから時刻で並べ替えるのと同じ順になる,時刻が同じものはどちらも行全体で比べ,枠の名前は同じため)
  sorted=("${(@f)$(print -r -- "$candidates" | sort -k2,2)}")
  h5=$(__claude_window h5 "${sorted[@]}")
  d7=$(__claude_window d7 "${sorted[@]}")
  [[ -n ${h5:-} || -n ${d7:-} ]] || return 0

  __format_agent_line claude "$h5" "$d7"
}

# codexのrate_limitsスナップショットから指定ウィンドウの "使用率 リセットepoch" を返す
# 判定はcodex本体のTUIと同じく期待値の±5%を許容する
# (5時間と週次のどちらがprimary/secondaryに入るかはバックエンド応答次第で位置固定できない)
__codex_window() {
  local snapshot minutes lo hi
  snapshot=$1
  minutes=$2
  lo=$(( minutes * 95 / 100 ))
  hi=$(( minutes * 105 / 100 ))

  print -r -- "$snapshot" \
    | jq -r --argjson lo "$lo" --argjson hi "$hi" \
        '[.payload.rate_limits.primary, .payload.rate_limits.secondary]
         | map(select(. != null and (.window_minutes // 0) >= $lo and (.window_minutes // 0) <= $hi))
         | first
         | if . == null then empty else "\(.used_percent | floor) \(.resets_at // "")" end' 2>/dev/null || true
}

# codexの5時間/週次利用枠(codexのmeta.jsonには利用枠が無いためセッションのrolloutから採る)
# rolloutは開始日のディレクトリに残り続けるため,日付から辿ると長時間セッションを取り逃がす
# state DBのthreadsが最終更新順のrollout_pathを持つのでそれを使う(WAL反映のためimmutableは付けない)
# rolloutは20MB級になるがtoken_countは毎ターン出るのでtailで足りる
__usage_lines_codex() {
  local rollouts rollout snapshot h5 d7
  local -a state_dbs
  local -i seen=0

  # state DBはスキーマ更新でstate_5→state_6のように採番が上がるためglobで最新を採る
  state_dbs=("$HOME"/.codex/state_*.sqlite(N.om))
  (( ${#state_dbs} )) || return 0

  # 起動しただけで1ターンも回していないスレッドはtoken_countを持たず,候補が浅いと
  # それだけで埋まって行ごと消えるため多めに採る
  # WALはcodex稼働中も書かれ続け,busy_timeout未設定だと競合した瞬間に即失敗するので待たせる
  rollouts=$(sqlite3 -cmd '.timeout 1000' "file:${state_dbs[1]}?mode=ro" \
    'SELECT rollout_path FROM threads ORDER BY updated_at DESC LIMIT 20;' 2>/dev/null) || return 0
  [[ -n ${rollouts:-} ]] || return 0

  h5=''
  d7=''

  # 5時間枠と週次枠は同じrate_limits応答に同居するが応答によって片方だけ欠けることがあり,
  # 1スナップショットで打ち切ると枠が出たり消えたりするため枠ごとに独立して探す
  # 枠自体を持たないプランでは何件見ても埋まらないのでtoken_countを持つ3件で打ち切る
  while IFS= read -r rollout; do
    [[ -n ${rollout:-} && -f $rollout ]] || continue

    snapshot=$(tail -n 500 "$rollout" 2>/dev/null | grep '"type":"token_count"' | tail -n 1) || continue
    [[ -n ${snapshot:-} ]] || continue

    (( seen += 1 ))
    [[ -z ${h5:-} ]] && h5=$(__codex_window "$snapshot" 300)
    [[ -z ${d7:-} ]] && d7=$(__codex_window "$snapshot" 10080)
    [[ -n ${h5:-} && -n ${d7:-} ]] && break
    (( seen >= 3 )) && break
  done < <(print -r -- "$rollouts")

  [[ -n ${h5:-} || -n ${d7:-} ]] || return 0

  __format_agent_line codex "$h5" "$d7"
}

# agent view経由のプロセスなら task,そのうちタスクを持たない予備プロセスなら spare を返す(それ以外は何も返さない)
# agent viewはセッションを --bg-pty-host 付きで動かし,次の投入に備えて --bg-spare 付きの予備プロセスも先に起動しておく
# 予備プロセスはタスクを割り当てられるまで ~/.claude/jobs/<短縮ID>/state.json を持たない
__bg_kind() {
  local key agent pid tty cmd session_id

  key=$1
  agent=$2
  pid=$3
  tty=$4

  [[ $agent == claude && ( -z $tty || $tty == '??' ) && -n $pid ]] || return 0

  cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
  [[ $cmd == *--bg-pty-host* ]] || return 0

  session_id=${key#sid-}
  if [[ $cmd == *--bg-spare* && ! -f $HOME/.claude/jobs/${session_id[1,8]}/state.json ]]; then
    print -r -- spare
  else
    print -r -- task
  fi
}

# 一覧に出ているエージェント種別を返す(pane単位は空白区切り,tmux外はタブ区切り)
__active_agents() {
  local state_file state agent rest

  {
    for state_file in "$state_dir"/%*.state(N); do
      read -r state agent rest < "$state_file" || continue
      print -r -- "$agent"
    done

    for state_file in "$state_dir"/sid-*.state(N); do
      IFS=$'\t' read -r state agent rest < "$state_file" || continue
      print -r -- "$agent"
    done
  } | sort -u
}

# 利用枠を一覧に出ているエージェントの分だけ並べて返す
__usage_lines() {
  local agents
  local -a parts

  agents=$(__active_agents)
  parts=()

  [[ $'\n'$agents$'\n' == *$'\n'claude$'\n'* ]] && parts+=("${(@f)$(__usage_lines_claude)}")
  [[ $'\n'$agents$'\n' == *$'\n'codex$'\n'* ]] && parts+=("${(@f)$(__usage_lines_codex)}")
  parts=(${parts:#})

  (( ${#parts} )) || return 0
  print -rl -- "${parts[@]}"
}

# 現存しないpane・シェルに戻ったpane・死んだプロセスの状態ファイルを掃除する
__cleanup_stale() {
  local panes live state_file id cmd pid
  local -a tmp_files

  # 書き込みの途中で止められて残った一時ファイルを消す(書き込み中のものを消さないよう,5分以上経ったものだけ)
  tmp_files=("$state_dir"/.(state|meta|activity|usage|usage_last_at).*(N.mm+5))
  (( ! ${#tmp_files} )) || rm -f -- "${tmp_files[@]}"

  # tmuxサーバー停止中やソケット一時障害でpane一覧が取れないと,全paneを
  # 「消えたpane」と誤判定して状態ファイルを消し去るため掃除自体を打ち切る
  panes=$(tmux list-panes -a -F '#{pane_id} #{pane_current_command}' 2>/dev/null) || return 0
  [[ -n $panes ]] || return 0

  # カレントコマンドがシェルのpane(=エージェント終了後)は,SessionEndが
  # 発火しない異常終了でも掃除できるよう生存リストから除外する
  live=$(
    print -r -- "$panes" \
      | while read -r id cmd; do
          case $cmd in
            zsh | bash) ;;
            *) print -r -- "$id" ;;
          esac
        done
  )

  for state_file in "$state_dir"/%*.state(N); do
    id=${${state_file:t}%.state}
    if [[ $'\n'$live$'\n' != *$'\n'$id$'\n'* ]]; then
      rm -f "$state_file" "$state_dir/$id.meta.json" "$state_dir/$id.wait" "$state_dir/$id.activity" "$state_dir/$id.artifact_mtime" "$state_dir/$id.cwd"
      # シェルに戻ったペインのステータスラインの @ を,シェルの作業ディレクトリに戻す(消えたペインでは失敗するだけ)
      tmux set-option -p -u -t "$id" @ai_cwd >/dev/null 2>&1 || true
    fi
  done

  for state_file in "$state_dir"/sid-*.state(N); do
    pid=$(cut -f3 "$state_file" 2>/dev/null || true)
    if [[ -z ${pid:-} ]] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$state_file" "${state_file%.state}.meta.json" "${state_file%.state}.wait" "${state_file%.state}.activity" "${state_file%.state}.artifact_mtime"
    fi
  done
}

# インストール済みのClaude Codeの版を出力する(ネイティブ版のランチャーは ~/.local/share/claude/versions/<版> へのリンク)
# リンク先が版の形でない入れ方では何も出さず,古い版の印を付けない
__claude_installed_version() {
  local launcher version
  launcher=$HOME/.local/bin/claude
  version=${launcher:A:t}
  if [[ $version == <->.<->.<-> ]]; then
    print -r -- "$version"
  fi
}

# meta.json から表示列に使う値を取る jq の式(モデル名・context の使用率・トークン数・動いている版・メモを引くセッションID)
# モデル名の括弧付き補足("Opus 4.8 (1M context)"等)は列に収まらないため除去する
meta_jq='[((.model // "-") | split(" (")[0]), (.cx_pct // 0 | floor), (.cx_tok // 0), (.version // ""), (.session_id // "")]'

# メタ情報の表示列を出力する(形式: "<model>\t<context>\t<古い版なら1,それ以外は0>\t<セッションID>",$2はエージェント種別)
# contextは使用率で色分けし,色指定を幅に数えて列がずれないよう幅をそろえてから色で囲む
__meta_columns() {
  local meta_file values model cx_pct cx_tok version outdated color session_id
  local -a fields
  meta_file=$state_dir/$1.meta.json

  if [[ -f $meta_file ]]; then
    # 毎秒・行ごとに呼ばれるため,__emit_rows が全部のAIの分をまとめて読んだ値を使い,
    # その中に無い時(まとめて読めなかった・その後にできた)だけ,このファイルを jq で1回読む
    if (( ${+meta_vals[$1]} )); then
      values=${meta_vals[$1]}
    else
      values=$(jq -r "$meta_jq | @tsv" "$meta_file" 2>/dev/null || true)
    fi
    fields=("${(@ps.\t.)values}")
    model=${fields[1]:--}
    cx_pct=${fields[2]:-0}
    cx_tok=${fields[3]:-0}
    version=${fields[4]:-}
    session_id=${fields[5]:-}
    # 動いている版(ステータスラインが書いた version)がインストール済みの版と違えば,E・e で再起動すると新しい版になる印を付ける
    outdated=0
    if [[ $2 == claude && -n $version && -n ${claude_installed:-} && $version != "$claude_installed" ]]; then
      outdated=1
    fi
    __usage_color "$cx_pct"
    color=$REPLY
    __fmt_tokens "$cx_tok"
    printf '%s\t\e[%sm%-9s\e[0m\t%s\t%s' "$model" "$color" "${cx_pct}% $REPLY" "$outdated" "$session_id"
  else
    printf -- '-\t%-9s\t0\t' -
  fi
}

# 1行分の表示を整形する(形式: "<priority>\t<mtime>\t<キー>\t<TARGET>\t<整形済み表示行>\t<メモ>")
# キーはtmux内ならペインID,tmux外なら sid-<session_id> で,選べる(ジャンプできる)のはペインIDの行だけ
# 一覧の下の作業の見える化でAIを同じ名前で示すため,TARGETも添える(並びは状態で入れ替わるので行番号は使えない)
# i の INFO の表示に替えるのは描き手なので,+ で書いたメモも添える(タブと改行は区切りと紛れないよう空白にする)
__format_row() {
  local target agent agent_pid state dir key mtime meta model ctx outdated model_col wait_label target_col open_mark
  local prio label dir_col last session_id info
  local -a fields
  target=$1
  agent=$2
  agent_pid=$3
  state=$4
  dir=$5
  key=$6
  mtime=$7

  meta=$(__meta_columns "$key" "$agent")
  fields=("${(@ps.\t.)meta}")
  model=${fields[1]}
  ctx=${fields[2]}
  outdated=${fields[3]}
  # tmux外のAIは,meta.json にセッションIDが無くてもキーに入っている
  session_id=${fields[4]:-}
  [[ -n $session_id || $key != sid-* ]] || session_id=${key#sid-}
  info=''
  if [[ -n $session_id && -s $info_dir/$session_id ]]; then
    info=$(<"$info_dir/$session_id")
    # メモはサンドボックスの中のAIのコマンドからも書けるため,端末の制御文字(タブ・改行を含む)は空白にしてから出す
    info=${info//[[:cntrl:]]/ }
  fi

  # 古い版の印(↑)は,下に開いている印と同じく,幅をそろえた後で色を付ける
  if [[ $outdated == 1 ]]; then
    __pad "${model[1,10]} ↑" 12
    model_col=${REPLY/↑/$'\e[1;33m↑\e[0m'}
  else
    __pad "$model" 12
    model_col=$REPLY
  fi

  if [[ $state == blocked && -f $state_dir/$key.wait ]]; then
    __wait_label "$(<"$state_dir/$key.wait")"
    wait_label=$REPLY
  fi

  # 下に開いている印(▼)は細い記号でも目に留まるよう,鮮やかな赤の太字にする
  # 色の指定が幅に数えられないよう,幅をそろえた後で色を付ける
  __pad "$target" 23
  target_col=$REPLY
  open_mark=$'\e[1;38;5;196m▼\e[0m'

  __priority_for "$state"
  prio=$REPLY
  __label_for "$state" "$wait_label"
  label=$REPLY
  __pad "$dir" 22
  dir_col=$REPLY
  __fmt_last "$mtime"
  last=$REPLY

  printf '%s\t%s\t%s\t%s\t%-7s %s %-7s %s %s %s %s %s\t%s\n' \
    "$prio" \
    "$mtime" \
    "$key" \
    "${target#▼ }" \
    "${${agent_pid:--}[1,7]}" \
    "${target_col/#▼/$open_mark}" \
    "${agent[1,7]}" \
    "$label" \
    "$dir_col" \
    "$model_col" \
    "$ctx" \
    "$last" \
    "$info"
}

# 全エージェントのデータ行を出力する
__emit_rows() {
  local line pane_id session win pane pane_path pane_cmd pane_title state agent
  local state_file key agent_pid agent_tty cwd mtime sep target bg_kind row_state home out
  local -a parts metas st_mtime
  local -A meta_vals started_agent

  # meta.json の列は,行ごとに jq を起こさないよう,全部のAIの分を1回の jq で読んでおく(__meta_columns が使う)
  # (どれかが壊れていると,jq はそこから先を読まずに止まるため,その時は使わずに行ごとに読ませる)
  metas=("$state_dir"/*.meta.json(N))
  if (( ${#metas} )) && out=$(jq -r "[input_filename] + $meta_jq | @tsv" "${metas[@]}" 2>/dev/null); then
    for line in ${(f)out}; do
      meta_vals[${${line%%$'\t'*}:t:r:r}]=${line#*$'\t'}
    done
  fi

  # 下に開いているAIの位置は一覧の隣になるため,入れ替わったペインがいる元の場所を印付きで出す
  home=''
  if [[ -n ${last_swap[2]:-} ]]; then
    home=$(tmux display -p -t "${last_swap[2]}" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)
  fi

  # このai-bridgeが d・C-d・Space で起動したペインとAIの種類(__start_agent_window が書く,--once では work_dir を作らない)
  if [[ -n ${work_dir:-} && -r $work_dir/started ]]; then
    for line in ${(f)"$(<"$work_dir/started")"}; do
      started_agent[${line%% *}]=${line#* }
    done
  fi

  # tmux内(pane単位)
  sep=$'\t'
  tmux list-panes -a -F "#{pane_id}${sep}#{session_name}${sep}#{window_index}${sep}#{pane_index}${sep}#{pane_current_path}${sep}#{pane_current_command}${sep}#{pane_title}" 2>/dev/null \
    | while IFS= read -r line; do
        parts=("${(@ps.\t.)line}")
        pane_id=${parts[1]:-}
        session=${parts[2]:-}
        win=${parts[3]:-}
        pane=${parts[4]:-}
        pane_path=${parts[5]:-}
        pane_cmd=${parts[6]:-}
        pane_title=${parts[7]:-}
        [[ -n $pane_id ]] || continue
        if [[ -n $home && $pane_id == "${last_swap[1]:-}" ]]; then
          target="▼ $home"
        else
          target="${session}:${win}.${pane}"
        fi
        if [[ ! -f $state_dir/$pane_id.state ]]; then
          # 起動したAIは,初めてのディレクトリで出る信頼の確認がセッションの始まる前に出てフックの記録が無いため,
          # AIが動いている(シェルに戻っていない)のに記録が無い間は判断待ちとして出す(確認が無くても,記録が書かれるまでの一瞬は判断待ちに見える)
          # Codexは最初のプロンプトまでフックを出さないため,入力欄を出した後(ペインのタイトルを付ける,確認の画面では付けずホスト名のまま)は入力待ちとして出す
          if [[ -n ${started_agent[$pane_id]:-} && $pane_cmd != (zsh|bash) ]]; then
            row_state=blocked
            if [[ ${started_agent[$pane_id]} == codex && -n $pane_title && $pane_title != "$HOST" ]]; then
              row_state=idle
            fi
            __format_row "$target" "${started_agent[$pane_id]}" '' "$row_state" "${pane_path:t}" "$pane_id" $EPOCHSECONDS
          fi
          continue
        fi
        read -r state agent agent_pid < "$state_dir/$pane_id.state" || continue
        zstat -A st_mtime +mtime "$state_dir/$pane_id.state" 2>/dev/null || st_mtime=($EPOCHSECONDS)
        mtime=${st_mtime[1]}

        __format_row "$target" "$agent" "${agent_pid:-}" "$state" "${pane_path:t}" "$pane_id" "$mtime"
      done

  # tmux外(session_id単位)
  for state_file in "$state_dir"/sid-*.state(N); do
    key=${${state_file:t}%.state}
    IFS=$'\t' read -r state agent agent_pid agent_tty cwd < "$state_file" || continue
    zstat -A st_mtime +mtime "$state_file" 2>/dev/null || st_mtime=($EPOCHSECONDS)
    mtime=${st_mtime[1]}
    bg_kind=$(__bg_kind "$key" "$agent" "${agent_pid:-}" "${agent_tty:-}")

    # agent view経由のプロセスはattach等にそのまま使える短縮IDを出す
    # 制御端末を持たないヘッドレス実行(cron等)はpsのttyが??になるため表示名に置き換える
    # 予備プロセスはタスクを持たないので,通常のセッションのIdleと紛れないよう専用の状態で出す
    row_state=$state
    if [[ $bg_kind == spare ]]; then
      target=agents:spare
      row_state=spare
    elif [[ $bg_kind == task ]]; then
      target=agents:${${key#sid-}[1,8]}
    elif [[ -z ${agent_tty:-} || $agent_tty == '??' ]]; then
      target=headless
    else
      target=$agent_tty
    fi

    __format_row "$target" "$agent" "${agent_pid:-}" "$row_state" "${cwd:t}" "$key" "$mtime"
  done
}

# ヘッダ+ソート済み一覧を出力する
__render() {
  local usage branch
  local -a usage_lines
  integer i

  # 利用枠は一覧に出るエージェントで絞るため,先に古い状態ファイルを掃除する
  __cleanup_stale
  __usage_lines_shared
  usage=$REPLY

  __render_title
  # 利用枠の行は見出しから枝分かれさせ(途中の行は ┣,最後の行は ┗ にして線をつなげる),
  # 列の名前との間は,利用枠の行が無い時も1行空ける
  if (( $#usage )); then
    usage_lines=("${(@f)usage}")
    for (( i = 1; i <= ${#usage_lines}; i++ )); do
      if (( i < ${#usage_lines} )); then branch='┣'; else branch='┗'; fi
      print -r -- "  $branch ${usage_lines[i]#  }"
    done
  fi
  print
  # 選択できる時はデータ行の頭に番号(数字キーで選ぶ)が付くので,見出しも同じだけずらす
  printf '%*s%-7s %-23s %-7s %-14s %-22s %-12s %-9s %s\n' $(( ${selectable:-0} ? 2 : 0 )) '' PID TARGET AGENT STATUS DIR MODEL CONTEXT LAST
  # ターン終了イベントを取りこぼしてworkingのまま残った状態を倒す
  __reconcile_shared
  __render_rows
}

# ai-bridge をいくつ開いていても同じ結果になる仕事は,この1秒の間にどれかが済ませていれば,その結果を使う
# (済ませた印と結果は状態ファイルの置き場所に置く)
# (1つだけの時は組み立ての間隔が1秒より長いので毎回自分で行い,今と変わらない,印や結果を置けない時も毎回自分で行う)

# 取り残しの判定(ai-agent-state)を,この1秒の間にどの ai-bridge もまだ行っていなければ行う
# (判定の結果は,どの ai-bridge も読む状態ファイルに書かれる)
__reconcile_shared() {
  local -a t

  if zstat -A t +mtime "$state_dir/.reconciled" 2>/dev/null && (( t[1] == EPOCHSECONDS )); then
    return 0
  fi
  : >| "$state_dir/.reconciled" 2>/dev/null || true
  ai-agent-state --reconcile-stuck 2>/dev/null || true
}

# 利用枠の行を REPLY に入れる(この1秒の間にどれかの ai-bridge が組み立て始めていれば,置いたものを使う)
# 組み立て始めた印は組み立てる前に置き,組み立て中に来たものには1つ前に置いたものを使わせる
# (組み立て終わってから印を置くと,同じ時に組み立て始めたものがみな組み立ててしまうため)
__usage_lines_shared() {
  local cache started
  local -a t
  cache=$state_dir/.usage
  started=$state_dir/.usage_started

  if [[ -r $cache ]] && zstat -A t +mtime "$started" 2>/dev/null && (( t[1] == EPOCHSECONDS )); then
    REPLY=$(<"$cache")
    return 0
  fi
  : >| "$started" 2>/dev/null || true
  REPLY=$(__usage_lines)
  { print -r -- "$REPLY" >| "$cache.$$" && zf_mv -f "$cache.$$" "$cache" } 2>/dev/null || true
}

# 一覧の1行目(見出しと時刻)を出力する
# 選べる時のキーの説明は4つに分けて ? で切り替え(key_help),ここにはその1つ目を時刻と並べて書く
# (選べない時は ? と選ぶ操作が使えないため,使える a・E・X・Esc だけを書く)
__render_title() {
  if (( ${selectable:-0} )); then
    print -r -- "AI Bridge  $(strftime '%H:%M:%S' $EPOCHSECONDS)  "'(a:activity d/C-d:new m:move Space:select-saved \:edit-saved Esc:quit ?:other-keys)'
  else
    print -r -- "AI Bridge  $(strftime '%H:%M:%S' $EPOCHSECONDS)  (a:activity E:restart-all X:exit-all Esc:quit)"
  fi
}

# データ行を並べて出力する
__render_rows() {
  # 古い版の印のため,インストール済みの版は行ごとでなく一覧を作るたびに1回だけ調べる
  claude_installed=$(__claude_installed_version)
  # 同じ状態の中では直近に状態が変わったものを上に出す(データ行は優先度・キー・TARGETを先頭に残す)
  __emit_rows | sort -t$'\t' -k1,1n -k2,2nr | cut -f1,3-
}

# 選んだペインへ移り,そのセッションを表示しているiTerm2のウィンドウも前面に出す
__jump() {
  local pane_id session client_tty

  pane_id=$1

  session=$(tmux display -p -t "$pane_id" '#{session_name}' 2>/dev/null) || return 0
  tmux select-window -t "$pane_id" 2>/dev/null || return 0
  tmux select-pane -t "$pane_id" 2>/dev/null || return 0

  # 同じセッションを複数のウィンドウで表示している場合は最後に操作したものを使う
  client_tty=$(
    tmux list-clients -F "#{client_activity}"$'\t'"#{client_tty}"$'\t'"#{client_session}" 2>/dev/null \
      | awk -F '\t' -v s="$session" '$3 == s' \
      | sort -t$'\t' -k1,1nr \
      | head -n 1 \
      | cut -f2
  )

  # どのウィンドウにも表示されていないセッションは,このai-bridgeのウィンドウに出す
  if [[ -z $client_tty ]]; then
    tmux switch-client -t "$pane_id" 2>/dev/null || true
    return 0
  fi

  # iTerm2が起動していない時に tell で起動させてしまわないよう,起動中の時だけ操作する
  osascript \
    -e 'on run argv' \
    -e 'if application "iTerm2" is not running then return' \
    -e 'tell application "iTerm2"' \
    -e 'repeat with w in windows' \
    -e 'repeat with t in tabs of w' \
    -e 'repeat with s in sessions of t' \
    -e 'if tty of s is (item 1 of argv) then' \
    -e 'select w' \
    -e 'select t' \
    -e 'select s' \
    -e 'activate' \
    -e 'return' \
    -e 'end if' \
    -e 'end repeat' \
    -e 'end repeat' \
    -e 'end repeat' \
    -e 'end tell' \
    -e 'end run' \
    "$client_tty" >/dev/null 2>&1 || true
}

# 選んだペインの TARGET(ai-session:4.1 のような場所,下に開いている時に付く ▼ は除く)を,tmux のバッファとクリップボードに写す
# クリップボードのコマンドは claude-code-bash-clipboard と同じものを,入っているものから順に試して写せた所で止める
# (Linux では入っているコマンドが Wayland・X11 の環境と合わないと失敗するため,失敗したら次を試す)
# (xclip・xsel は既定がクリップボードでなく PRIMARY 選択のためクリップボードを指定し,xclip・wl-copy は選択を渡すために裏に残るので出力は捨てる)
__copy_target() {
  local target name
  local -a copy
  target=${${target_of[$1]:-}#▼ }
  [[ -n $target ]] || return 0
  tmux set-buffer -- "$target" 2>/dev/null || true
  for name in pbcopy wl-copy xclip xsel; do
    (( $+commands[$name] )) || continue
    case $name in
      pbcopy)  copy=(pbcopy) ;;
      wl-copy) copy=(wl-copy) ;;
      xclip)   copy=(xclip -selection clipboard) ;;
      xsel)    copy=(xsel --clipboard --input) ;;
    esac
    print -rn -- "$target" | "${copy[@]}" >/dev/null 2>&1 && break
  done
  tmux display-message "Copied: ${target//\#/##}" 2>/dev/null || true
}

# 選んだペイン $1 の TARGET のウィンドウ(ai-session:2.1 なら ai-session:2)を,tmux の prefix + m と同じく移す先を聞いて動かす
# 打った番号はそのウィンドウのセッションの中の番号として扱う(この一覧の端末はほかのセッションを出していて,番号だけだとそちらの番号になるため)
# 下に開いているAIは,TARGET に出している元の場所(入れ替えた相手がいるウィンドウ)を動かす
# ペインIDの % は聞いた答えを入れる印(%1 等)と紛れるためウィンドウIDで指し,答えを待つ間もこの一覧を止めないよう -b で聞く
__move_window() {
  local pane info

  if [[ $1 == "${last_swap[1]:-}" ]]; then
    pane=${last_swap[2]}
  else
    pane=$1
  fi
  info=$(tmux display -p -t "$pane" '#{window_id} #{session_name}:#{window_index}' 2>/dev/null || true)
  [[ -n $info ]] || return 0
  tmux command-prompt -b -p "(move-window ${${info#* }//\#/##} to)" "move-window -s ${info%% *} -t '${${info#* }%:*}:%%'" 2>/dev/null || true
}

# 選んだペイン $1 のAIのメモ(INFO)を小窓で書かせ,info_dir のそのAIのセッションIDのファイルに置く(今のメモを入れておき,空で確定すると消える)
# 置いたメモは,どの ai-bridge も1秒ごとの一覧の組み立てで読む
# 書く欄は zsh の vared で,キーは zsh の設定(zsh.d/config.zsh)と同じく vi の挿入モードに,行の編集の C-a・C-b・C-e・C-f・C-h・BS・C-u・C-w・C-x を足したもの
# (vi の挿入モードの C-h・BS は,挿入モードに入った所(入れておいた今のメモの後ろ)より前を消さず,今のメモを直せないため,前も消せるものにする)
# (Enter で確定,Space・\ の小窓と同じく Esc で取り消せるよう,Esc は vi のコマンドモードにせず取り消しにする)
# (C-g は Space・\ の小窓と同じく閉じないようにし,zsh の既定の list-expand は1行の欄を崩すため,行を描き直すだけの redisplay にする)
# (矢印キーも Esc で始まるため,続く文字を待つ時間(KEYTIMEOUT)は 10ms にして,Esc だけの時にすぐ取り消す)
# (欄の頭の1桁は,枠に文字が付かないよう打てない半角スペース(vared の見出し)にする,小窓の zsh は早く開くよう設定のファイルを読まない)
# 取り消した時は何も書かないので,空で確定した時と見分けるため答えの前に = を付ける
__edit_info() {
  local target session_id tmp editor

  target=${target_of[$1]:-$1}
  session_id=$(jq -r '.session_id // ""' "$state_dir/$1.meta.json" 2>/dev/null || true)
  if [[ -z $session_id ]]; then
    tmux display-message "Cannot edit info for ${target//\#/##} (no session ID yet)" 2>/dev/null || true
    return 0
  fi
  editor='
    memo=""
    [[ ! -r $AI_BRIDGE_INFO_FILE ]] || memo=$(<"$AI_BRIDGE_INFO_FILE")
    bindkey -v
    bindkey -v "^a" beginning-of-line "^b" backward-char "^e" end-of-line "^f" forward-char "^g" redisplay "^h" backward-delete-char "^?" backward-delete-char \
      "^u" kill-whole-line "^w" backward-kill-word "^x" kill-word "^[" send-break
    KEYTIMEOUT=1
    vared -p " " memo && print -rn -- "=$memo" >| "$AI_BRIDGE_POPUP_OUT"'
  : >| "$work_dir/popup_out"
  tmux display-popup -E -w 80% -h 3 -T " info ${target//\#/##} (Enter: save, Esc: cancel) " \
    -e "AI_BRIDGE_INFO_FILE=$info_dir/$session_id" -e "AI_BRIDGE_POPUP_OUT=$work_dir/popup_out" \
    zsh -f -c "$editor" 2>/dev/null || true
  REPLY=$(<"$work_dir/popup_out")
  # = で始まる語は zsh がコマンドの場所に置き換える(EQUALS)ため,= は引用符で囲む
  [[ $REPLY == '='* ]] || return 0
  tmp=$info_dir/.$session_id.$EPOCHREALTIME
  mkdir -p "$info_dir" && print -rn -- "${REPLY#=}" >| "$tmp" && zf_mv -f "$tmp" "$info_dir/$session_id"
  __data_changed
}

# 選んだペイン $1 のAIのメモ(INFO)を消す(+ で空にして確定した時と同じく,置き場のファイルを空にする)
# 一覧はメモを出していない時もあり消えたかが見えないため,消した時は tmux の設定を読み直した時(prefix + r)と同じ形の小窓で知らせる
# (1秒経つか何かキーを押すと閉じ,開いている間も一覧の描き直しを止めないよう裏で開く)
__remove_info() {
  local target session_id message

  target=${target_of[$1]:-$1}
  session_id=$(jq -r '.session_id // ""' "$state_dir/$1.meta.json" 2>/dev/null || true)
  [[ -n $session_id && -s $info_dir/$session_id ]] || return 0
  : >| "$info_dir/$session_id" 2>/dev/null || return 0
  __data_changed
  message="Removed info: $target"
  (
    # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
    trap - EXIT INT TERM HUP WINCH
    tmux display-popup -E -b rounded -S 'fg=colour38' -w $(( ${(m)#message} + 4 )) -h 3 \
      zsh -f -c 'printf "\e[?25l\e[1;38;5;51m %s" "$1"; read -s -t 1 -k 1' zsh "$message"
  ) </dev/null >/dev/null 2>&1 &!
}

# 選んだペイン $1 の作業ディレクトリ(DIR)が git の中の時だけ,そこで関数 $2 を裏で動かす(g・C-g で使う)
# 画面を乱さず,gh が問い合わせのためにこのai-bridgeへのキー入力を読まないよう入出力は使わず,開き終わるのを待たない
__run_in_repo() {
  local dir
  dir=$(tmux display -p -t "$1" '#{pane_current_path}' 2>/dev/null || true)
  [[ -n $dir ]] || return 0
  (
    # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
    trap - EXIT INT TERM HUP WINCH
    cd -- "$dir" && git rev-parse && "$2"
  ) </dev/null >/dev/null 2>&1 &!
}

# zsh の C-s,g (immediate-gh-browse) と同じく,リポジトリをブラウザで開く
__browse_repo() {
  gh browse
}

# zsh の C-s,C-g (immediate-gh-browse-pull-request) と同じく,今のブランチのプルリクエストを開き,無ければ作る画面を開く
__open_pr() {
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD) || return 0
  gh pr view --web "$branch" || gh pr create --web --head "$branch"
}

# 選んだペインの作業ディレクトリ(DIR)で,このai-bridgeのセッションに新しいウィンドウを開いて移る
# 一覧へ戻った時に閉じられるよう,開いたペインを dir_panes に残す
__open_dir_window() {
  local dir pane

  dir=$(tmux display -p -t "$1" '#{pane_current_path}' 2>/dev/null) || return 0
  # -c はtmuxのフォーマットとして展開されるため,パスの # は ## にして文字どおりに渡す
  pane=$(tmux new-window -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 0
  dir_panes+=("$pane")
}

# tmux の小窓で $2 以降のコマンドを動かし,そのコマンドが AI_BRIDGE_POPUP_OUT のファイル($1)に書いたものを REPLY に入れる(取り消した時は空)
# 小窓は画面の上に重ねて出すだけなので,閉じるとこのペインのフォーカスのままになる(display-popup は小窓が閉じるまで戻らない)
# 小窓の中のコマンドはtmuxの環境で動くため,peco 等が見つかるようこのai-bridgeの PATH を渡す
__popup_pick() {
  local out
  out=$1
  shift

  : >| "$out"
  tmux display-popup -E -w 90% -h 80% -d "${PWD//\#/##}" -e "PATH=$PATH" -e "AI_BRIDGE_POPUP_OUT=$out" "$@" 2>/dev/null || true
  REPLY=$(<"$out")
}

# zsh の C-s,_ (peco-cd-ghq-repo) と同じく ghq で管理しているリポジトリを peco で選ばせ,そこで $1 のコマンドのAIを起動する
__start_agent_in_repo() {
  __popup_pick "$work_dir/popup_out" "${SHELL:-zsh}" -c 'ghq list -p | peco --select-1 >| "$AI_BRIDGE_POPUP_OUT"'
  [[ -n $REPLY ]] || return 0
  __start_agent_window "$1" "$REPLY"
}

# ウィンドウのペイン $1 を上の30%に縮めてai-bridgeを動かし,下に作ったペインで $3 のコマンドを $2 のディレクトリで実行する(prefix + a と同じ形)
# 作ったAIのペインを REPLY に入れる($4 に --keep-top を付けると,上のペインはそのまま使う)
# 下のペインはこのai-bridgeが下に開く欄と同じ大きさになるため,入れ替えて開いても大きさが変わらず,描き直しで表示が崩れない
# コマンドは zsh の C-d 等と同じく入力欄に打って実行する(シェルの準備ができる前に打った文字も溜まって実行される,prefix + a の ai-bridge と同じ)
__make_agent_window() {
  local top dir command bottom
  integer height
  top=$1
  dir=$2
  command=$3

  # prefix + a と同じく下のペインを選んだ状態にする(-d を付けないが,裏のウィンドウなので端末の画面は切り替わらない)
  # (-c はtmuxのフォーマットとして展開されるため,パスの # は ## にして文字どおりに渡す)
  bottom=$(tmux split-window -v -t "$top" -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 1
  height=$(tmux display -p -t "$top" '#{window_height}' 2>/dev/null || print 0)
  (( ! height )) || tmux resize-pane -t "$top" -y $(__fit_height $height) 2>/dev/null || true
  # 上のペインで何か動いている時(R で既にあるペインを使う時)は,打ったキーがそれへの操作になるため ai-bridge を起動しない
  [[ ${4:-} == --keep-top ]] || tmux send-keys -t "$top" 'ai-bridge' Enter 2>/dev/null || true
  __run_agent_in_pane "$bottom" "$command"
  REPLY=$bottom
}

# ペイン $1 で $2 のコマンドを実行する
__run_agent_in_pane() {
  local agent

  # フックの記録が無い間も一覧に出せるよう,裏の一覧の組み立てに起動したペインとAIの種類を伝える(__emit_rows が読む)
  if [[ " $2 " == *' codex '* ]]; then
    agent=codex
  else
    agent=claude
  fi
  print -r -- "$1 $agent" >> "$work_dir/started"
  tmux send-keys -t "$1" -l "$2" 2>/dev/null || true
  tmux send-keys -t "$1" Enter 2>/dev/null || true
}

# AIを起動する先のセッションに prefix + a と同じ形のウィンドウ(上の30%でai-bridge,下でAI)を作り,下のペインで $1 のコマンドを実行する
# ウィンドウは裏に作り(-d),そのセッションを表示している端末の画面も,このペインのフォーカスも動かさない
__start_agent_window() {
  local command dir session top bottom
  command=$1
  dir=$2
  session=${start_session:-$(tmux display -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null || true)}
  [[ -n $session ]] || return 0

  # -c はtmuxのフォーマットとして展開されるため,パスの # は ## にして文字どおりに渡す
  top=$(tmux new-window -d -t "=${session}:" -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 0
  __make_agent_window "$top" "$dir" "$command" || return 0
  bottom=$REPLY
  # 起動したAIは C-s と同じくこのai-bridgeの下に開いて見せる(フォーカスはこのペインのまま)
  # (初めてのディレクトリで出る信頼の確認はセッションが始まる前に出るためフックの記録が無く一覧に出ず,裏のウィンドウのままだと気づけない)
  __open_below "$bottom"
  # 下に開いたAIを選ぶ(前に選んでいた行が残ると,C-k 等が下のAIではなくその行のAIを開くため)
  selected_id=$bottom
  launched_id=$bottom
}

# 保存済みのセッションを選ぶ小窓へ渡す設定(env.zsh)の名前
# 小窓は tmux サーバーの環境変数で動くため,このai-bridgeの値を渡す(d・C-d の AI_AGENT_WITH_OPT 等と同じく,ai-bridgeを起動した時の値を使う)
saved_session_vars=(
  AI_AGENT_SESSIONS_FILE_PATH
  AI_AGENT_SESSION_CLAUDE_COMMAND AI_AGENT_SESSION_CLAUDE_MODELS AI_AGENT_SESSION_CLAUDE_EFFORTS
  AI_AGENT_SESSION_CODEX_COMMAND AI_AGENT_SESSION_CODEX_MODELS AI_AGENT_SESSION_CODEX_EFFORTS
  EDITOR
)

# このファイルの関数 $1 を小窓の zsh で動かし,書き出した結果を REPLY に入れる($1 が使う関数は $2 以降に並べて一緒に渡す)
__popup_saved_session() {
  local name
  local -a envs

  for name in "${saved_session_vars[@]}"; do
    envs+=("$name=${(P)name-}")
  done
  __popup_pick "$work_dir/popup_out" env "${envs[@]}" zsh -c "$(functions "$@"); $1"
}

# zsh の C-s,Space (peco-resume-ai-agent-session) と同じく,保存済みのセッションを選ばせ,決まった再開のコマンドを __start_agent_window で起動する
__start_saved_agent() {
  __popup_saved_session __pick_saved_session __select_saved_options __popup_error
  [[ -n $REPLY ]] || return 0
  __start_agent_window "$REPLY" "$PWD"
}

# zsh の C-s,\ (peco-edit-ai-agent-session) と同じく,保存済みのセッションを選ばせ,一覧のファイルのその行をエディタで開く
__edit_saved_session() {
  __popup_saved_session __edit_saved_session_in_popup
}

# ここから __edit_saved_session_in_popup までは小窓の中で動かす(__popup_saved_session が小窓の zsh に渡す)
# zsh のウィジェット(peco-resume-ai-agent-session・peco-edit-ai-agent-session)と zsh.d/lib/ai_agent_session.zsh の同じ処理を写したもので,
# 記録の読み方・Model と Effort の選び方・再開のコマンドの組み立て方を zsh で変えたら,こちらも合わせる

# 保存済みのセッションを peco で選ばせ,Model と Effort を選ばせて,選んだセッションの場所へ cd して再開するコマンドを AI_BRIDGE_POPUP_OUT に書く
__pick_saved_session() {
  local selected agent record session_id session_name session_dir agent_command models efforts model_option effort_option effort_config
  local -a reply

  selected=$(peco --select-1 "$AI_AGENT_SESSIONS_FILE_PATH" 2>/dev/null)
  (( $#selected )) || return 0

  agent=${${selected#\[}%%\]*}
  record=${selected#*| }
  if [[ $agent == "$selected" || $record == "$selected" || $record != *' - '* || $record != *@* ]]; then
    __popup_error 'invalid session record'
    return 1
  fi
  session_id=${record%% - *}
  # セッション名自体に @ が含まれ得るため,ディレクトリ側は最後の @ で切り落とす
  session_name=${${record#* - }%@*}
  session_dir=${${record##*@}/#\~/$HOME}

  case $agent in
    claude)
      agent_command=$AI_AGENT_SESSION_CLAUDE_COMMAND
      models=$AI_AGENT_SESSION_CLAUDE_MODELS
      efforts=$AI_AGENT_SESSION_CLAUDE_EFFORTS
      ;;
    codex)
      agent_command=$AI_AGENT_SESSION_CODEX_COMMAND
      models=$AI_AGENT_SESSION_CODEX_MODELS
      efforts=$AI_AGENT_SESSION_CODEX_EFFORTS
      ;;
    *)
      __popup_error "unsupported AI agent: $agent"
      return 1
      ;;
  esac
  if (( ! $#agent_command || ! $#models || ! $#efforts )); then
    __popup_error "command, model or effort options are empty: $agent"
    return 1
  fi

  __select_saved_options "Session: $session_name" Model "$models" Effort "$efforts" || return 0

  if [[ ${reply[1]} != default ]]; then
    model_option=" --model ${(q)reply[1]}"
  fi
  if [[ $agent == claude ]]; then
    if [[ ${reply[2]} != default ]]; then
      effort_option=" --effort ${(q)reply[2]}"
    fi
    print -r -- "cd ${(q)session_dir} && $agent_command --resume ${(q)session_id}$model_option$effort_option" >| "$AI_BRIDGE_POPUP_OUT"
  else
    effort_config="model_reasoning_effort=\"${reply[2]}\""
    if [[ ${reply[2]} != default ]]; then
      effort_option=" --config ${(q)effort_config}"
    fi
    print -r -- "cd ${(q)session_dir} && $agent_command resume ${(q)session_id}$model_option$effort_option" >| "$AI_BRIDGE_POPUP_OUT"
  fi
}

# 見出し $1 の下に「項目名 [候補 / 候補] (C-n/C-p): 選んでいる候補」を出し,C-n・C-p で候補を替えて Enter で決め,次の項目へ進む
# $2 以降に項目名と候補(カンマ区切り)の組を並べ,決めた候補を reply に入れる(C-c で取り消す)
__select_saved_options() {
  local key
  local -a options chosen
  integer i

  print -r -- "$1"
  shift
  while (( $# )); do
    options=("${(@s:,:)2}")
    i=1
    while :; do
      print -nr -- $'\r\e[K'"$1 [${(j: / :)options}] (C-n/C-p): ${options[i]}"
      read -s -k 1 key || return 1
      case $key in
        $'\x0e') i=$(( i % ${#options} + 1 )) ;;
        $'\x10') i=$(( (i + ${#options} - 2) % ${#options} + 1 )) ;;
        $'\n' | $'\r') break ;;
        $'\x03') return 1 ;;
      esac
    done
    print
    chosen+=("${options[i]}")
    shift 2
  done
  reply=("${chosen[@]}")
}

# 選べなかった理由を出し,読めるようキーを押すまで小窓を閉じずに待つ
__popup_error() {
  print -r -- "ai-bridge: $1" 1>&2
  read -s -k 1
}

# 保存済みのセッションを peco で選ばせ,一覧のファイルのその行をエディタで開く
__edit_saved_session_in_popup() {
  local selected
  local -a lines

  selected=$(peco --select-1 "$AI_AGENT_SESSIONS_FILE_PATH" 2>/dev/null)
  (( $#selected )) || return 0
  # セッションIDは一覧の中で重なり得るため,選んだ行そのものと同じ行を探して行番号にする
  lines=("${(@f)$(<$AI_AGENT_SESSIONS_FILE_PATH)}")
  ${=EDITOR:-vim} +${lines[(ie)$selected]} "$AI_AGENT_SESSIONS_FILE_PATH"
}

# ウィンドウを移ってから一覧へ戻った時に呼び,C-lで開いたウィンドウのうちシェル1つに戻っているものを全部閉じる
# 何か実行中だったりペインを分けていれば巻き込まないよう残し,次に戻った時にもう一度見る
__close_dir_window() {
  local pane info panes cmd
  local -a kept

  for pane in "${dir_panes[@]}"; do
    # 既に閉じられたウィンドウは追うのをやめる
    info=$(tmux display -p -t "$pane" '#{window_panes} #{pane_current_command}' 2>/dev/null) || continue
    read -r panes cmd <<< "$info"
    if [[ $panes == 1 && ( $cmd == zsh || $cmd == bash ) ]]; then
      tmux kill-window -t "$pane" 2>/dev/null || true
    else
      kept+=("$pane")
    fi
  done
  dir_panes=("${kept[@]}")
}

# このai-bridgeのペインの真下にある,同じウィンドウのペインIDを返す(無ければ何も返さない)
__pane_below() {
  local self_geometry
  integer top height left width

  [[ -n ${TMUX_PANE:-} ]] || return 0
  self_geometry=$(tmux display -p -t "$TMUX_PANE" '#{pane_top} #{pane_height} #{pane_left} #{pane_width}' 2>/dev/null) || return 0
  read -r top height left width <<< "$self_geometry"

  # 真下のペインは上端が「自分の上端+高さ+境界線1行」で,横方向に自分と重なる
  tmux list-panes -t "$TMUX_PANE" -F '#{pane_id} #{pane_top} #{pane_left} #{pane_width}' 2>/dev/null \
    | awk -v t=$(( top + height + 1 )) -v l=$left -v w=$width '$2 == t && $3 < l + w && $3 + $4 > l { print $1; exit }'
}

# 選んだペインを,このウィンドウのai-bridgeの真下のペインと入れ替えて表示する(フォーカスはai-bridgeに残す)
# ペインIDはペインと一緒に移動するため,入れ替えた2つを last_swap に残しておけば同じ2つを入れ替え直して戻せる
# 真下にペインが無ければ仮のペインを作って入れ替え,AIが元いた場所の配置を崩さないよう仮のペインをそこへ置く
# 仮のペインが他のウィンドウに溜まらないよう,入れ替えは常に1組だけにする(表示中の別のAIは先に元の場所へ戻す)
__open_below() {
  local pane_id below target placeholder height dir
  integer fit

  pane_id=$1

  [[ $(__pane_below) != "$pane_id" ]] || return 0
  (( ! ${#last_swap} )) || __undo_swap --no-draw

  below=$(__pane_below)
  # 開いた時に一覧の高さを変えるので,閉じた時に戻せるよう開く前の高さを残す
  height=$(tmux display -p -t "$TMUX_PANE" '#{pane_height}' 2>/dev/null || true)
  # tmuxはペインを縮める時,カーソルより下の行を消し切ると残りを上の行から消して表示が上にずれるため,
  # 一覧の高さを変える前にカーソルを左上へ移して下の行から消させる
  # (描き終えた後も左上に置くと,読み込みの合間に打ったキーのエコーが見出しに重なるので,ここでだけ移す)
  printf '\e[H'
  if [[ -n $below ]]; then
    target=$below
    # 一覧と下のAIで分け合う高さは,下のペインの分と間の境界線1行を足したもの
    fit=$(__fit_height $(( height + 1 + $(tmux display -p -t "$below" '#{pane_height}' 2>/dev/null || print 0) )))
  else
    fit=$(__fit_height $height)
    # 入れ替えた後にAIを閉じても元の場所が同じディレクトリのままになるよう,仮のペインはAIの作業ディレクトリで開く
    # (-c はtmuxのフォーマットとして展開されるため,パスの # は ## にして文字どおりに渡す)
    dir=$(tmux display -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null) || return 0
    # 一度縮めてから合わせ直すと一覧も下のAIも続けて2回大きさが変わり,その度に描き直しになるため,
    # 仮のペインは最初から合わせた後の大きさで作る
    placeholder=$(tmux split-window -d -v -l $(( height - fit - 1 )) -c "${dir//\#/##}" -t "$TMUX_PANE" -P -F '#{pane_id}' 2>/dev/null) || return 0
    target=$placeholder
  fi

  if ! tmux swap-pane -d -s "$pane_id" -t "$target" 2>/dev/null; then
    [[ -z ${placeholder:-} ]] || tmux kill-pane -t "$placeholder" 2>/dev/null || true
    return 0
  fi

  last_swap=("$pane_id" "$target" "${placeholder:-}" "$height")
  tmux resize-pane -t "$TMUX_PANE" -y $fit 2>/dev/null || true
  __data_changed
  size_stale=1
  __draw
}

# 下にAIを開いた時の一覧の高さ
# 一覧と下のAIで分け合う高さ($1)から境界線1行を除いた分を,一覧の行数に依らず 30:70 に分け(四捨五入,少なくとも1行),
# 入りきらない分は … +N more の表示に任せる
__fit_height() {
  integer fit

  fit=$(( (($1 - 1) * 30 + 50) / 100 ))
  (( fit >= 1 )) || fit=1
  print -r -- $fit
}

# このウィンドウのai-bridgeの真下のペインへフォーカスを移す
__focus_below() {
  local below

  below=$(__pane_below)
  [[ -n $below ]] || return 0

  tmux select-pane -t "$below" 2>/dev/null || true
}

# 開いたAIの最後の返答(行頭が返答の印の最後の塊)の冒頭が画面より上へ流れていれば,コピーモードにしてその冒頭を画面の上に出す
# 印は Claude Code が ⏺,Codex が • で,Codex の返答の中の箇条書きの • は2桁下げて出るため,行頭の印とは混ざらない
# 冒頭が画面に見えていれば返答は全部見えているので,コピーモードにせず,すぐ打ち込めるままにする
# 作業中のAIは返答が書きかけで,コピーモードにすると下の進み具合が見えず Esc でも止められなくなるため何もしない
# 入り方は普段の prefix + v と同じにする(-e を付けると,下まで読んで抜けた後に癖で押した q がAIの入力欄に入る)
# goto-line は copy-mode-line-numbers の設定で数え方が変わるため,画面の一番上の行で cursor-up して1行ずつ上へ送る
# 右上の位置の表示が冒頭の行に重ならないよう,1行上(返答の前の空行)を画面の一番上にする
# 遡るのは2000行まで(最後の返答は90%点で1,654文字,画面では80行ほど)で,それより長い返答では何もしない
# Codex は大きさが変わると画面を消して会話を描き直すため,入れ替えて開いた直後に読むと,印の行が見つからないか前の返答の印を拾う
# 履歴の行数と量を0.1秒おきに読み,続けて同じになる(描き直しが済む)まで待つ(400行の会話で0.13秒ほどだった,長くても1秒で打ち切る)
__scroll_to_last_reply() {
  local pane state agent rest mark prev cur
  local -a screen cmds
  integer hsize n i up tries
  pane=$1

  [[ -f $state_dir/$pane.state ]] || return 0
  read -r state agent rest < "$state_dir/$pane.state" || return 0
  [[ $state != working ]] || return 0
  case $agent in
    claude) mark=⏺ ;;
    codex) mark=• ;;
    *) return 0 ;;
  esac

  if [[ $agent == codex ]]; then
    for (( tries = 0; tries < 10; tries++ )); do
      zselect -t 10 || true
      cur=$(tmux display -p -t "$pane" '#{history_size} #{history_bytes}' 2>/dev/null || true)
      [[ $cur != "$prev" ]] || break
      prev=$cur
    done
  fi

  hsize=$(tmux display -p -t "$pane" '#{history_size}' 2>/dev/null || print 0)
  (( hsize )) || return 0
  n=$(( hsize < 2000 ? hsize : 2000 ))
  # 1〜n 行目が履歴の末尾,n+1 行目からが画面になる
  screen=("${(@f)$(tmux capture-pane -p -t "$pane" -S -$n -E - 2>/dev/null || true)}")
  for (( i = ${#screen}; i > 0; i-- )); do
    [[ ${screen[i]} != $mark* ]] || break
  done
  (( i && i <= n )) || return 0

  # 冒頭の行は画面の一番上より up 行上にある(履歴の一番上の行なら,その上の行は無い)
  up=$(( n - i + 1 ))
  cmds=(copy-mode -q -t "$pane" \; copy-mode -t "$pane" \; send-keys -X -t "$pane" top-line \;)
  if (( up < hsize )); then
    cmds+=(send-keys -X -N $(( up + 1 )) -t "$pane" cursor-up \; send-keys -X -t "$pane" cursor-down \;)
  else
    cmds+=(send-keys -X -N $up -t "$pane" cursor-up \;)
  fi
  cmds+=(send-keys -X -t "$pane" start-of-line)
  tmux "${cmds[@]}" 2>/dev/null || true
}

# 選んだペインを真下に開いてそこへ移る(既に下に開いていれば __open_below は何もしないので,移るだけになる)
# --last-reply を付けると,移る前に最後の返答の冒頭から読めるようにする(移った後だと,下の端が一瞬見えてから飛ぶため)
__open_and_focus_below() {
  __open_below "$1"
  [[ ${2:-} != --last-reply ]] || __scroll_to_last_reply "$1"
  __focus_below
  __mark_below_seen
}

# 下に開いたAIを見たとみなして,完了をidleへ戻す(判断待ちは戻さない,C-k・数字キー・C-s・下に開いたままの C-n/C-p で使う)
# (ウィンドウを移らないのでtmuxのフックでは戻らず,未選択のC-kで同じ行が選ばれ続けるため)
# 下に開いたAIはこのai-bridgeのウィンドウにいるので,このウィンドウの完了を戻す
__mark_below_seen() {
  ai-agent-state --focus-reset "$(tmux display -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)" 2>/dev/null || true
  __data_changed
}

# 直前の入れ替えを元に戻す(どちらかのペインが閉じていれば入れ替え自体は失敗するが,後片付けと描き直しは続ける)
# 仮のペインはai-bridgeの下へ戻ってくるので閉じて元の配置に戻すが,そこで何か実行していれば巻き込まないよう残す
# --no-draw は続けて別のAIを下に開く時に使い,開いた後にまとめて描かせる(途中の配置で1回余分に描かないように)
__undo_swap() {
  local placeholder

  (( ${#last_swap} )) || return 0

  # 一覧を開く前の高さへ縮める時も表示が上にずれないよう,先にカーソルを左上へ移す(__open_below と同じ理由)
  printf '\e[H'
  tmux swap-pane -d -s "${last_swap[1]}" -t "${last_swap[2]}" 2>/dev/null || true

  placeholder=${last_swap[3]:-}
  if [[ -n $placeholder ]]; then
    case $(tmux display -p -t "$placeholder" '#{pane_current_command}' 2>/dev/null || true) in
      zsh | bash) tmux kill-pane -t "$placeholder" 2>/dev/null || true ;;
    esac
  elif (( ${last_swap[4]:-0} > 0 )); then
    # 元からあった下のペインと入れ替えた時は,一覧の高さも開く前に戻す(仮のペインは閉じれば元の高さに戻る)
    tmux resize-pane -t "$TMUX_PANE" -y "${last_swap[4]}" 2>/dev/null || true
  fi

  last_swap=()
  __data_changed
  size_stale=1
  [[ ${1:-} == --no-draw ]] || __draw
}

# tmux内のAIを終了させる(X・x と E・e で,AIごとに裏で呼ぶ)
# Ctrl-Cは待機中なら1回目で入力欄を空け2回目で終了し,作業中は1回目が中断になるため,ペインがシェルに戻るまで送り続ける
# 状態ファイルのpidはペインのシェルでAIが終わっても生きているため,終わったかはペインのカレントコマンドで見る(__cleanup_stale と同じ)
# 中断が長引いてもシェルに戻ったペインへCtrl-Cを打ち込み続けないよう,10秒で諦める
__exit_agent() {
  local pane_id
  integer deadline

  # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
  trap - EXIT INT TERM HUP WINCH
  pane_id=$1
  deadline=$(( EPOCHSECONDS + 10 ))

  while (( EPOCHSECONDS < deadline )); do
    case $(tmux display -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null || print zsh) in
      zsh | bash) return 0 ;;
    esac
    tmux send-keys -t "$pane_id" C-c 2>/dev/null || return 0
    zselect -t 30 || true
  done
}

# X・x で選んだAIをまとめて終了させ,ペインも閉じる(裏で呼び,AIごとの __exit_and_close_agent を同時に動かして終わるのを待つ)
# セッションの最後のウィンドウまで閉じるとセッションごと無くなり,それを出していた端末が tmux から抜けてしまうため,
# 閉じる前にAIのいるセッションへ空のウィンドウを足しておき,終わった時にほかのウィンドウが残っていれば消し,
# 残っていなければ先頭の番号(base-index)へ移して,起動した直後と同じ空のセッションにする
# (このai-bridgeのいるセッションと,AIのいないウィンドウがあるセッションは,そのウィンドウが残るので足さない)
__exit_and_close_agents() {
  local id session own base
  local -a targets windows others
  local -A spare

  # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
  trap - EXIT INT TERM HUP WINCH
  own=$(tmux display -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null || true)
  for id in "$@"; do
    targets+=("$(tmux display -p -t "$id" '#{window_id}' 2>/dev/null || true)")
  done
  for id in "$@"; do
    session=$(tmux display -p -t "$id" '#{session_name}' 2>/dev/null || true)
    [[ -n $session && $session != "$own" && -z ${spare[$session]:-} ]] || continue
    windows=(${(f)"$(tmux list-windows -t "=$session" -F '#{window_id}' 2>/dev/null || true)"})
    # AIのいないウィンドウ(入れ子の ${#${a:|b}} は全部引けて空の時に0にならないため,いったん配列に受けて数える)
    others=(${windows:|targets})
    (( ! ${#others} )) || continue
    spare[$session]=$(tmux new-window -d -t "=${session}:" -P -F '#{window_id}' 2>/dev/null || true)
  done

  for id in "$@"; do
    __exit_and_close_agent "$id" &
  done
  wait || true

  for session in ${(k)spare}; do
    [[ -n ${spare[$session]} ]] || continue
    if [[ $(tmux list-windows -t "=$session" -F '#{window_id}' 2>/dev/null || true) != "${spare[$session]}" ]]; then
      tmux kill-window -t "${spare[$session]}" 2>/dev/null || true
    else
      base=$(tmux display -p -t "${spare[$session]}" '#{base-index}' 2>/dev/null || true)
      [[ -z $base ]] || tmux move-window -s "${spare[$session]}" -t "=${session}:$base" 2>/dev/null || true
    fi
  done
}

# X・x で選んだAIを1つ終了させ,シェルに戻ったらペインも閉じる(__exit_and_close_agents が裏で呼ぶ)
# ウィンドウが上のai-bridgeと下のこのAIの2つだけ(prefix + a・t-ai-session・d・C-d・Space で作る形)なら,上のai-bridgeのペインも閉じる
# ai-bridge はzshのスクリプトでカレントコマンドではシェルと見分けられないため,ペインの端末で ai-bridge が動いているかで見る
# (このai-bridge自身のペインは閉じない,閉じるとまだ終了させている途中の裏の処理まで止まるため)
# 10秒で終わらずシェルに戻らなかったAIのペインは,巻き込まないよう残す
__exit_and_close_agent() {
  local pane_id line id ai_at_top rest bridge bridge_at_top bridge_tty bridge_cmd
  local -a panes

  # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
  trap - EXIT INT TERM HUP WINCH
  pane_id=$1

  __exit_agent "$pane_id"
  case $(tmux display -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null || true) in
    zsh | bash) ;;
    *) return 0 ;;
  esac

  panes=("${(@f)$(tmux list-panes -t "$pane_id" -F '#{pane_id} #{pane_at_top} #{pane_tty} #{pane_current_command}' 2>/dev/null || true)}")
  for line in "${panes[@]}"; do
    if [[ $line == "$pane_id "* ]]; then
      read -r id ai_at_top rest <<< "$line"
    else
      read -r bridge bridge_at_top bridge_tty bridge_cmd <<< "$line"
    fi
  done
  tmux kill-pane -t "$pane_id" 2>/dev/null || true

  (( ${#panes} == 2 )) || return 0
  [[ $ai_at_top == 0 && $bridge_at_top == 1 && $bridge_cmd == zsh && $bridge != "${TMUX_PANE:-}" ]] || return 0
  __tty_runs_ai_bridge "$bridge_tty" || return 0
  tmux kill-pane -t "$bridge" 2>/dev/null || true
}

# 端末 $1 で ai-bridge が動いているか(ai-bridge はzshのスクリプトで,ペインのカレントコマンドではシェルと見分けられないため)
# macOS の pgrep -t は ttys012 の形の端末名で絞り込めないため ps で見る
__tty_runs_ai_bridge() {
  local -a commands

  commands=("${(@f)$(ps -t "${1#/dev/}" -o command= 2>/dev/null || true)}")
  (( ${#${(@M)commands:#*/ai-bridge(| *)}} ))
}

# ペインの画面の入力欄(上下を罫線に挟まれた ❯ の行)が空だと確かめられた時だけ0を返す($2はエージェント種別)
# 書きかけは終了の Ctrl-C で消えてしまい,判断待ちのダイアログ等で入力欄が見えない時は送ったキーの行き先が分からないため,
# 入力欄が見つからない時も空でないものとして扱う(過去の指示も ❯ で始まるが,罫線に挟まれているのは入力欄だけ)
# Codex は入力欄の見え方が違うため __codex_input_is_empty で確かめる
__input_is_empty() {
  local -a screen
  integer i

  if [[ $2 == codex ]]; then
    __codex_input_is_empty "$1"
    return
  fi

  screen=("${(@f)$(tmux capture-pane -p -t "$1" 2>/dev/null || true)}")
  for (( i = ${#screen}; i > 1; i-- )); do
    [[ ${screen[i]} == ❯* ]] || continue
    [[ ${screen[i-1]} == ─* && ${screen[i+1]:-} == ─* ]] || continue
    [[ -z ${${screen[i]#❯}//[[:space:]]/} ]]
    return
  done
  return 1
}

# Codex の入力欄が空だと確かめられた時だけ0を返す(__input_is_empty と同じく,見つからない時は空でないものとして扱う)
# 入力欄は罫線が無く太字の › で始まる行で,下には状態の1行(モデル・残りのコンテキスト等)だけが続く
# ダイアログの選択行は反転の › で始まり,過去の指示や複数行の書きかけは下に行が続くため,入力欄とみなさない
# 空の時は薄字の案内文が出て,その文言は変わり得るため,文字ではなく色(薄字の部分を除いて何も残らないか)で確かめる
__codex_input_is_empty() {
  local line typed visible
  local -a screen
  integer i below

  screen=("${(@f)$(tmux capture-pane -p -e -t "$1" 2>/dev/null || true)}")
  for (( i = ${#screen}; i > 0; i-- )); do
    line=${screen[i]}
    if [[ $line != $'\e[1m›\e[0m'* ]]; then
      [[ -z ${${(S)line//$'\e'\[*m/}//[[:space:]]/} ]] || below+=1
      continue
    fi
    (( below <= 1 )) || return 1
    typed=${line#$'\e[1m›\e[0m'}
    visible=${(S)typed//$'\e[2m'*$'\e[0m'/}
    [[ -z ${${(S)visible//$'\e'\[*m/}//[[:space:]]/} ]]
    return
  done
  return 1
}

# 再開コマンド(起動したディレクトリへの cd 付き)を REPLY に入れる(E・e の再起動と R の復元で使い,組み立て方の訳は __plan_restart の上に書く)
# $1=AIの種類(claude・codex) $2=セッションID $3=モデル $4=effort(effort に対応しないモデルでは空) $5=起動したディレクトリ
__resume_command() {
  local effort_config

  if [[ $1 == codex ]]; then
    effort_config="model_reasoning_effort=\"$4\""
    REPLY="cd ${(q)5} && ${AI_AGENT_SESSION_CODEX_COMMAND:-} resume ${(q)2} --model ${(q)3}${4:+ --config ${(q)effort_config}}"
  else
    REPLY="cd ${(q)5} && ${AI_AGENT_SESSION_CLAUDE_COMMAND:-} --resume ${(q)2} --model ${(q)3}${4:+ --effort ${(q)4}}"
  fi
}

# E(一覧の全部)・e(選んでいる1つ)で再起動するペインと再開コマンドを restart_targets / restart_command に入れ,確かめの文を confirm_prompt に入れる
# ($1 は all か one,one の時は対象の名前と,再起動できなければその理由を出す)
# 再起動するのは,待機中か完了で,再開に要る値がそろい,入力欄が空と確かめられたClaude・Codexだけにする
#   作業中: 中断すると,裏のサブエージェントやバックグラウンドのコマンドは再開されない
#   判断待ち: 送ったキーがダイアログへの回答になってしまう
#   値: セッションID・モデル・effort・起動したディレクトリは meta.json に書かれた今の値(Claude はステータスライン,Codex は ai-agent-state が書く)で,
#       会話記録が無いセッションは再開できない(終了すると meta.json は消えるため,値はここで写しておく)
#       戻る先は今の作業ディレクトリ(workspace.current_dir)ではなく起動したディレクトリ(workspace.project_dir)にする
#       (Bash の cd で作業ディレクトリが動いていると,その場所で開き直してしまうため)
# 再開コマンドは,いつもの再開(peco-resume-ai-agent-session)と同じ起動の土台(AI_AGENT_SESSION_CLAUDE_COMMAND・AI_AGENT_SESSION_CODEX_COMMAND)に今の値を付けて組み立てる
#   Codex: resume は元のモデル・effort を戻さず config.toml の値を使うため(openai/codex#32061),--model と --config model_reasoning_effort を付ける
#       AI_AGENT_SESSION_CODEX_COMMAND は --no-daemon 付きにする(共有の daemon の上ではフックが daemon を起動したペインの環境で動き,別のペインの記録になるため)
#       開き直した Codex は次の指示を送るまでフックが動かないため,それまで一覧から消える
__plan_restart() {
  local mode id state agent rest values session_id model_id effort project_dir transcript_path agent_command
  local -a fields skipped ids
  integer working=0 waiting=0 input=0 noinfo=0 other=0

  mode=$1
  if [[ $mode == one ]]; then
    ids=("$selected_id")
  else
    ids=("${jump_ids[@]}")
  fi
  restart_targets=()
  restart_command=()
  for id in "${ids[@]}"; do
    if ! read -r state agent rest < "$state_dir/$id.state" 2>/dev/null; then
      other+=1
      continue
    fi
    case $agent in
      claude)
        agent_command=${AI_AGENT_SESSION_CLAUDE_COMMAND:-}
        ;;
      codex)
        agent_command=${AI_AGENT_SESSION_CODEX_COMMAND:-}
        ;;
      *)
        other+=1
        continue
        ;;
    esac
    case $state in
      idle | done) ;;
      working)
        working+=1
        continue
        ;;
      blocked)
        waiting+=1
        continue
        ;;
      *)
        other+=1
        continue
        ;;
    esac
    values=$(jq -r '[.session_id // "", .model_id // "", .effort // "", .project_dir // "", .transcript_path // ""] | @tsv' "$state_dir/$id.meta.json" 2>/dev/null || true)
    fields=("${(@ps.\t.)values}")
    session_id=${fields[1]:-}
    model_id=${fields[2]:-}
    effort=${fields[3]:-}
    project_dir=${fields[4]:-}
    transcript_path=${fields[5]:-}
    # effort に対応しないモデルでは effort が無いので,無ければ effort の指定を付けない
    if [[ -z $session_id || -z $model_id || -z $project_dir || ! -f $transcript_path || -z $agent_command ]]; then
      noinfo+=1
      continue
    fi
    if ! __input_is_empty "$id" "$agent"; then
      input+=1
      continue
    fi
    restart_targets+=("$id")
    __resume_command "$agent" "$session_id" "$model_id" "$effort" "$project_dir"
    restart_command[$id]=$REPLY
  done

  (( ! working )) || skipped+=("$working working")
  (( ! waiting )) || skipped+=("$waiting waiting")
  (( ! input )) || skipped+=("$input input")
  (( ! noinfo )) || skipped+=("$noinfo no-info")
  (( ! other )) || skipped+=("$other other")
  if [[ $mode == one ]]; then
    if (( ${#restart_targets} )); then
      confirm_prompt=$'\e[1;97;41m'"AI Bridge  Restart ${target_of[$selected_id]:-$selected_id}? y/N"$'\e[0m'
    else
      confirm_prompt=$'\e[1;97;41m'"AI Bridge  Cannot restart ${target_of[$selected_id]:-$selected_id} (${skipped[1]#* })"$'\e[0m'
    fi
    return 0
  fi
  (( ${#agent_keys} == ${#jump_ids} )) || skipped+=("$(( ${#agent_keys} - ${#jump_ids} )) outside tmux")
  # 飛ばした理由が多いと幅102桁のペインで見切れるため,問いと y/N を先に出す
  confirm_prompt=$'\e[1;97;41m'"AI Bridge  Restart ${#restart_targets} AI(s)? y/N${skipped:+  (skipped: ${(j:, :)skipped})}"$'\e[0m'
}

# E・e で選んだペインを1つ再起動する(y で決めた後,ペインごとに裏で動かす)
# 確かめてから y を押すまでに状態や入力欄が変わっていれば何もせず,終了させてシェルに戻ったと確かめられた時だけ再開コマンドを送る
# (AIが動いたままのペインに送ると,再開コマンドが指示としてAIに送られてしまう)
__restart_agent() {
  local pane_id command state agent rest start_input
  integer deadline

  # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
  trap - EXIT INT TERM HUP WINCH
  pane_id=$1
  command=$2

  read -r state agent rest < "$state_dir/$pane_id.state" 2>/dev/null || return 0
  [[ ( $agent == claude || $agent == codex ) && ( $state == idle || $state == done ) ]] || return 0
  __input_is_empty "$pane_id" "$agent" || return 0

  # Codex は開き直しただけではフックが動かず,終了の SessionEnd で消えた記録が次の指示まで戻らないため,
  # 終了させる前に meta.json の値を写し,開き直した後にフックの代わりに SessionStart(resume)として記録させる
  if [[ $agent == codex ]]; then
    start_input=$(jq -c '{hook_event_name: "SessionStart", source: "resume", session_id, cwd: .project_dir, model: .model_id, transcript_path}' "$state_dir/$pane_id.meta.json" 2>/dev/null || true)
  fi

  __exit_agent "$pane_id"
  case $(tmux display -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null || true) in
    zsh | bash) ;;
    *) return 0 ;;
  esac

  tmux send-keys -t "$pane_id" -l -- "$command" 2>/dev/null || return 0
  tmux send-keys -t "$pane_id" Enter 2>/dev/null || true

  [[ -n $start_input ]] || return 0
  # シェルのままのペインの記録は __cleanup_stale が消すため,Codex が動き始めてから記録させる
  deadline=$(( EPOCHSECONDS + 10 ))
  while (( EPOCHSECONDS < deadline )); do
    if [[ $(tmux display -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null || true) == codex ]]; then
      print -r -- "$start_input" | TMUX_PANE=$pane_id ai-agent-state codex SessionStart 2>/dev/null || true
      return 0
    fi
    zselect -t 30 || true
  done
}

# O で保存するAI(一覧に出ているtmux内のAIのうち,再開に要る値がそろったもの)を tmux のウィンドウの順に save_lines に入れ,確かめの文を confirm_prompt に入れる
# 値は E・e の再起動と同じく meta.json の今の値で,会話記録が無いセッションは再開できないため保存しない
# 作業中や判断待ちのAIも保存する(保存するだけで,動いているAIには何もしない)
# R で元の場所に戻せるよう,いたセッションとウィンドウ番号も書く
# このai-bridgeの下に開いて入れ替えているAI(とその相手)は,入れ替えた相手が今いる場所が元の場所になる
# (別のai-bridgeで入れ替えたものは元の場所が分からないため,今いる場所を書く)
__plan_save() {
  local pane state agent rest values line home sep
  local -a fields skipped panes
  local -A location
  integer noinfo=0

  save_lines=()
  sep=$'\t'
  # ペインごとの「セッション<タブ>ウィンドウ番号」と,tmux のウィンドウの順のペインの並び
  for line in ${(f)"$(tmux list-panes -a -F "#{pane_id}${sep}#{session_name}${sep}#{window_index}" 2>/dev/null || true)"}; do
    panes+=("${line%%$'\t'*}")
    location[${line%%$'\t'*}]=${line#*$'\t'}
  done
  for pane in "${panes[@]}"; do
    (( ${jump_ids[(Ie)$pane]} )) || continue
    if ! read -r state agent rest < "$state_dir/$pane.state" 2>/dev/null; then
      noinfo+=1
      continue
    fi
    values=$(jq -r '[.session_id // "", .model_id // "", .effort // "", .project_dir // "", .transcript_path // ""] | @tsv' "$state_dir/$pane.meta.json" 2>/dev/null || true)
    fields=("${(@ps.\t.)values}")
    if [[ ( $agent != claude && $agent != codex ) || -z ${fields[1]:-} || -z ${fields[2]:-} || -z ${fields[4]:-} || ! -f ${fields[5]:-} ]]; then
      noinfo+=1
      continue
    fi
    if [[ $pane == "${last_swap[1]:-}" ]]; then
      home=${last_swap[2]}
    elif [[ $pane == "${last_swap[2]:-}" ]]; then
      home=${last_swap[1]}
    else
      home=$pane
    fi
    save_lines+=("$agent"$'\t'"${fields[1]}"$'\t'"${fields[2]}"$'\t'"${fields[3]:-}"$'\t'"${fields[4]}"$'\t'"${location[$home]:-}")
  done

  (( ! noinfo )) || skipped+=("$noinfo no-info")
  (( ${#agent_keys} == ${#jump_ids} )) || skipped+=("$(( ${#agent_keys} - ${#jump_ids} )) outside tmux")
  if (( ${#save_lines} )); then
    confirm_prompt=$'\e[1;97;41m'"AI Bridge  Save ${#save_lines} AI(s) to restore with R? y/N${skipped:+  (skipped: ${(j:, :)skipped})}"$'\e[0m'
  else
    confirm_prompt=$'\e[1;97;41m'"AI Bridge  Nothing to save${skipped:+  (skipped: ${(j:, :)skipped})}"$'\e[0m'
  fi
}

# __plan_save で選んだAIを保存のファイルに書く(前に保存したものは置き換え,書きかけを R で読まないよう一時ファイルに書いてから置き換える)
__save_agents() {
  print -rl -- "${save_lines[@]}" >| "$resurrect_file.tmp" 2>/dev/null || return 0
  zf_mv -f "$resurrect_file.tmp" "$resurrect_file" 2>/dev/null || true
}

# R で復元するAIを,O で保存したファイルから restore_lines に入れ,確かめの文を confirm_prompt に入れる
# 今どこかで動いているセッションは二重に動かさないよう,起動したディレクトリが無くなったものは開けないため飛ばす
__plan_restore() {
  local line running
  local -a fields skipped metas
  integer dup=0 nodir=0

  restore_lines=()
  if [[ -z ${TMUX_AI_SESSION:-} ]]; then
    confirm_prompt=$'\e[1;97;41m'"AI Bridge  Cannot restore (TMUX_AI_SESSION is not set)"$'\e[0m'
    return 0
  fi
  if [[ ! -r $resurrect_file ]]; then
    confirm_prompt=$'\e[1;97;41m'"AI Bridge  Nothing to restore (save with O first)"$'\e[0m'
    return 0
  fi

  # 動いているセッションは meta.json のセッションIDで見る(壊れた meta.json があっても読み落とさないよう,jq を通さずに中身から探す)
  metas=("$state_dir"/*.meta.json(N))
  (( ! ${#metas} )) || running=$(cat -- "${metas[@]}" 2>/dev/null || true)
  for line in "${(@f)$(<"$resurrect_file")}"; do
    [[ -n $line ]] || continue
    fields=("${(@ps.\t.)line}")
    if [[ -n ${fields[2]:-} && $running == *"${fields[2]}"* ]]; then
      dup+=1
      continue
    fi
    if [[ ! -d ${fields[5]:-} ]]; then
      nodir+=1
      continue
    fi
    restore_lines+=("$line")
  done

  (( ! dup )) || skipped+=("$dup running")
  (( ! nodir )) || skipped+=("$nodir no-dir")
  if (( ${#restore_lines} )); then
    confirm_prompt=$'\e[1;97;41m'"AI Bridge  Restore ${#restore_lines} AI(s) into $TMUX_AI_SESSION? y/N${skipped:+  (skipped: ${(j:, :)skipped})}"$'\e[0m'
  else
    confirm_prompt=$'\e[1;97;41m'"AI Bridge  Nothing to restore${skipped:+  (skipped: ${(j:, :)skipped})}"$'\e[0m'
  fi
}

# __plan_restore で選んだAIを,$TMUX_AI_SESSION のセッションに上でai-bridge・下でAIのウィンドウを1つずつ作って再開する(セッションが無ければ作る)
# $TMUX_AI_SESSION から保存したAIは元のウィンドウ番号に戻し,ほかのセッションから保存したもの(番号はそのセッションでの番号なので使わない)は後で末尾に足す
# (元の番号の分を先に作り,末尾に足すものに番号を取られないようにする)
__restore_agents() {
  local line index
  local -a fields placed appended

  for line in "${restore_lines[@]}"; do
    fields=("${(@ps.\t.)line}")
    if [[ ${fields[6]:-} == "$TMUX_AI_SESSION" && -n ${fields[7]:-} ]]; then
      placed+=("$line")
    else
      appended+=("$line")
    fi
  done
  for line in "${placed[@]}" "${appended[@]}"; do
    fields=("${(@ps.\t.)line}")
    index=''
    [[ ${fields[6]:-} != "$TMUX_AI_SESSION" ]] || index=${fields[7]:-}
    __resume_command "${(@)fields[1,5]}"
    __restore_agent "$index" "${fields[5]}" "$REPLY"
  done
}

# $TMUX_AI_SESSION のウィンドウ番号 $1(空ならほかのセッションから保存したもの)に,ディレクトリ $2 でAIを戻して再開のコマンド $3 を実行する
# tmux-resurrect と同じく,あるウィンドウやペインはそのまま使い,足りないものだけ作る
#   セッションが無い: 作って,最初のウィンドウ(base-index の番号になる)を元の番号へ移し,上でai-bridge・下でAIの形にする
#   ウィンドウが無い: 元の番号に上でai-bridge・下でAIのウィンドウを作る
#   ペインが1つ: その下にAIのペインを作る
#   上下2つで下がシェルだけ(prefix + a で作った形等): 下のペインでAIを動かす
#   (上のペインがシェルだけなら ai-bridge を動かして形をそろえ,何か動いていれば打ったキーがそれへの操作になるためそのまま使う)
# 下のペインで何か動いている等,元の場所に置けない時と,番号が空の時は,一番後ろのウィンドウの次に作る
# 裏で作るセッションは既定の大きさ(80x24)になり,上下の分け方が後でつなぐ端末と合わないため,このai-bridgeのウィンドウと同じ大きさで作る
# (-x・-y を付けて作ったセッションは,後から作るウィンドウもその大きさになる)
__restore_agent() {
  local index dir command line id at_top tty cmd top top_tty top_cmd bottom bottom_tty bottom_cmd keep last
  local -a size panes
  index=$1
  dir=$2
  command=$3

  if ! tmux has-session -t "=$TMUX_AI_SESSION" 2>/dev/null; then
    size=(${=$(tmux display -p -t "${TMUX_PANE:-}" '#{window_width} #{window_height}' 2>/dev/null || true)})
    top=$(tmux new-session -d -s "$TMUX_AI_SESSION" -x "${size[1]:-80}" -y "${size[2]:-24}" -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 0
    [[ -z $index ]] || tmux move-window -s "$top" -t "=${TMUX_AI_SESSION}:$index" 2>/dev/null || true
    __make_agent_window "$top" "$dir" "$command" || true
    return 0
  fi

  if [[ -n $index ]]; then
    panes=("${(@f)$(tmux list-panes -t "=${TMUX_AI_SESSION}:$index" -F '#{pane_id} #{pane_at_top} #{pane_tty} #{pane_current_command}' 2>/dev/null || true)}")
    if [[ -z ${panes[1]} ]]; then
      top=$(tmux new-window -d -t "=${TMUX_AI_SESSION}:$index" -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 0
      __make_agent_window "$top" "$dir" "$command" || true
      return 0
    fi
    # 上の段の1つ目を上のペイン,下の段の1つ目を下のペインとする(左右に分かれていれば,どちらかが空のままになる)
    for line in "${panes[@]}"; do
      read -r id at_top tty cmd <<< "$line"
      if [[ $at_top == 1 && -z $top ]]; then
        top=$id top_tty=$tty top_cmd=$cmd
      elif [[ $at_top == 0 && -z $bottom ]]; then
        bottom=$id bottom_tty=$tty bottom_cmd=$cmd
      fi
    done
    if [[ -n $top ]] && __is_idle_shell "$top_tty" "$top_cmd"; then
      keep=''
    else
      keep=--keep-top
    fi
    if [[ -n $top ]] && (( ${#panes} == 1 )); then
      __make_agent_window "$top" "$dir" "$command" $keep || true
      return 0
    fi
    if [[ -n $top && -n $bottom ]] && (( ${#panes} == 2 )) && __is_idle_shell "$bottom_tty" "$bottom_cmd"; then
      [[ -n $keep ]] || tmux send-keys -t "$top" 'ai-bridge' Enter 2>/dev/null || true
      __run_agent_in_pane "$bottom" "$command"
      return 0
    fi
  fi

  last=${${(On)${(f)"$(tmux list-windows -t "=$TMUX_AI_SESSION" -F '#{window_index}' 2>/dev/null || true)"}}[1]:-0}
  top=$(tmux new-window -d -t "=${TMUX_AI_SESSION}:$(( last + 1 ))" -c "${dir//\#/##}" -P -F '#{pane_id}' 2>/dev/null) || return 0
  __make_agent_window "$top" "$dir" "$command" || true
}

# ペインがシェルだけで何も動かしていないか($1=ペインの端末 $2=ペインのカレントコマンド)
__is_idle_shell() {
  [[ $2 == (zsh|bash) ]] && ! __tty_runs_ai_bridge "$1"
}

# 下に開いた・閉じた・完了を待機へ戻した等,手元で一覧の中身を変えた時に呼ぶ
# 裏の1秒ごとの組み立てを待たずにすぐ組み立て直させ,裏にも下に開いたAIを伝える
# 変える前に裏で組み立て始めた一覧を取り込んで表示が戻らないよう,世代(gen)を上げて古い一覧を捨てさせる
__data_changed() {
  (( ++gen ))
  __write_ctl
  need_render=1
}

# 裏に,世代・作業の見える化を出しているか(1/0)・下に開いたAIとその入れ替え相手を伝える
# (出しているかは,裏が出している間だけ SYSTEM の GPU・メモリ・ストレージを測るために使う)
# 空白区切りで読むため,必ず値のある項目は,空のことがある下に開いたAIの2つより前に置く
__write_ctl() {
  print -r -- "$gen $show_ops ${last_swap[1]:-} ${last_swap[2]:-}" >| "$ctl_file"
}

# 中身を変えた時の一覧を,キーの受け付けを止めずに裏ですぐ組み立てさせる
# (その場で組み立てると,C-s で下に開いたまま C-n/C-p で動かす時に続けて押したキーが待たされるため)
# 変わるのはAIの行だけなので,利用枠の行と列の名前は今の一覧のものを使い,見出しとAIの行だけを組み立て直す
# (状態ファイルの掃除と取り残しの判定は裏の1秒ごとの組み立てに任せ,組み立ての重さを半分以下にする)
# 組み立てた時の世代を1行目に添えて quick_file に置かせ,描き手は今の世代のものだけを取り込む
# 続けて呼ぶと前の組み立てと重なるので,書きかけのファイルは世代ごとに分ける
__render_soon() {
  # zsh は裏の処理の優先度を下げるため,その場で組み立てていた時と同じ優先度で組み立てさせる
  setopt local_options no_bg_nice
  {
    # 描き手のEXITのtrap(後片付け)を裏で走らせないよう外す(__render_loop と同じ)
    trap - EXIT INT TERM HUP WINCH
    { print -r -- $gen; __render_title; print -rl -- "${(@)rendered[2,first_row-1]}"; __render_rows } >| "$quick_file.$gen" 2>/dev/null || true
    zf_mv -f "$quick_file.$gen" "$quick_file" 2>/dev/null || true
  } >/dev/null 2>&1 &!
  quick_gen=$gen
}

# --- SYSTEM の値を裏で測る(どれも sudo 無しで取れるもの) ---
# CPU と負荷: iostat,GPU: ioreg,メモリ: vm_stat,ストレージ: df,チップ名・コア数・メモリの総量: system_profiler
# 手前へは,一覧のファイルの1行目の世代の後ろに 名前=値 をタブ区切りにして載せて渡す

# チップ名・コア数・メモリの総量を取る(変わらないので,裏を起動した時に1回だけ呼ぶ)
__sys_hw() { # → reply=(CPUとGPUの補足を 名前=値 のタブ区切りにしたもの メモリの総量(GiB,取れなければ0))
  local hw io chip='?' cpu_cores='?' gpu_cores='?' mem_total=0
  hw=$(system_profiler SPHardwareDataType 2>/dev/null || true)
  io=$(ioreg -r -c IOAccelerator -w 0 -d 1 2>/dev/null || true)
  [[ $hw =~ 'Chip: ([^'$'\n'']+)' ]] && chip=$match[1]
  [[ $hw =~ 'Total Number of Cores: ([0-9]+)' ]] && cpu_cores=$match[1]
  [[ $hw =~ 'Memory: ([0-9]+) GB' ]] && mem_total=$match[1]
  [[ $io =~ '"gpu-core-count" = ([0-9]+)' ]] && gpu_cores=$match[1]
  reply=("cpu_sub=$chip · $cpu_cores cores"$'\t'"gpu_sub=$chip · $gpu_cores cores" $mem_total)
}

# CPU の使用率と負荷を iostat で1秒かけて測る(裏の1秒の休みを兼ねるため,iostat が動かない時は1秒休む)
# iostat の1行目は起動してからの平均なので,最後の行(1秒の間の差分)を使う
__sys_cpu() { # → REPLY=名前=値 のタブ区切り(測れない値は -)
  local out=''
  local -a v
  if ! out=$(iostat -n0 -c 2 -w 1 2>/dev/null); then
    zselect -t 100 || true
  fi
  v=(${=${(f)out}[-1]})
  if (( ${#v} == 6 )) && [[ ${v[3]} == <-> ]]; then
    REPLY="cpu=$(( 100 - v[3] ))"$'\t'"load=${v[4]} ${v[5]} ${v[6]}"
  else
    REPLY=$'cpu=-\tload=-'
  fi
}

# GPU・メモリ・ストレージの使用率と使用量を測る(作業の見える化を出している間だけ,裏で組み立てるたびに呼ぶ)
__sys_usage() { # $1=メモリの総量(GiB,不明なら0) → REPLY=名前=値 のタブ区切り(測れない値は -)
  local io vm gpu=- mem=- mem_sub=- disk=- disk_sub=-
  local -a v
  integer page=16384 purge=0 wired=0 comp=0
  float used

  # GPU: Apple シリコンの GPU が報告する使用率
  io=$(ioreg -r -c IOAccelerator -w 0 -d 1 2>/dev/null || true)
  [[ $io =~ '"Device Utilization %"=([0-9]+)' ]] && gpu=$match[1]

  # メモリ: アクティビティモニタの「使用済みメモリ」と同じく,アプリ(匿名-解放可能)・確保済み・圧縮の合計
  vm=$(vm_stat 2>/dev/null || true)
  if (( $1 )) && [[ $vm =~ 'Anonymous pages: *([0-9]+)' ]]; then
    integer anon=$match[1]
    [[ $vm =~ 'page size of ([0-9]+)' ]] && page=$match[1]
    [[ $vm =~ 'Pages purgeable: *([0-9]+)' ]] && purge=$match[1]
    [[ $vm =~ 'Pages wired down: *([0-9]+)' ]] && wired=$match[1]
    [[ $vm =~ 'Pages occupied by compressor: *([0-9]+)' ]] && comp=$match[1]
    used=$(( (anon - purge + wired + comp) * page / 1073741824.0 ))
    printf -v mem '%.0f' $(( used * 100 / $1 ))
    printf -v mem_sub '%.1f / %.1f GiB' $used $1
  fi

  # ストレージ: データの入るボリュームのコンテナ全体の大きさと空きから,ほかのボリュームの分も含めた使用量を出す
  v=(${=${(f)"$(df -k /System/Volumes/Data 2>/dev/null || true)"}[2]})
  if [[ ${v[2]:-} == <-> && ${v[4]:-} == <-> ]] && (( v[2] )); then
    printf -v disk '%.0f' $(( (v[2] - v[4]) * 100.0 / v[2] ))
    printf -v disk_sub '%.1f / %.1f GiB' $(( (v[2] - v[4]) / 1048576.0 )) $(( v[2] / 1048576.0 ))
  fi
  REPLY="gpu=$gpu"$'\t'"mem=$mem"$'\t'"mem_sub=$mem_sub"$'\t'"disk=$disk"$'\t'"disk_sub=$disk_sub"
}

# この ai-bridge のペインのウィンドウを,どれかの端末が画面に出しているか(tmux の外や,tmux に聞けない時は出しているとみなす)
__pane_shown() {
  [[ -n ${TMUX_PANE:-} ]] || return 0
  [[ $(tmux display -p -t "$TMUX_PANE" '#{window_active_clients}' 2>/dev/null) != 0 ]]
}

# 一覧の組み立て(約0.2秒)が1秒10コマの描き直しを止めないよう,裏で1秒ごとに組み立ててファイルに置く
# 1行目に通し番号と組み立てた時の世代を添え,置き換えは一度に行う(描き手が書きかけを読まないように)
# 1行目の世代の後ろには SYSTEM の値を載せる(1秒の休みは iostat で CPU を測る1秒に充てる)
# 画面に出ていない間は,組み立てを10秒に1回に減らし,0.5秒ごとに出たかを確かめて,出たらすぐ組み立てる
# (取り残しの判定は,どの ai-bridge も画面に出ていない時にも遅れないよう,組み立てない間も続ける)
# (SYSTEM の値は画面に出ている間だけ測り,出ていない間は,古い値を出さないよう測れていない扱いにする)
# 描き手が強制終了されても裏に残り続けないよう,描き手がいなくなったら止まる
__render_loop() {
  local g s a b hw cpu usage
  integer seq=0 mem_total shown built_at=0

  trap - EXIT INT TERM HUP WINCH
  __sys_hw
  hw=${reply[1]} mem_total=${reply[2]}
  cpu=$'cpu=-\tload=-'
  while kill -0 $$ 2>/dev/null; do
    if __pane_shown; then
      shown=1
    else
      shown=0
      cpu=$'cpu=-\tload=-'
    fi
    if (( ! shown && EPOCHSECONDS - built_at < 10 )); then
      __reconcile_shared
      zselect -t 50 || true
      continue
    fi
    built_at=$EPOCHSECONDS
    if ! read -r g s a b < "$ctl_file"; then
      g=0 s=0 a='' b=''
    fi
    if [[ -n $a ]]; then
      last_swap=("$a" "$b")
    else
      last_swap=()
    fi
    # GPU・メモリ・ストレージは,作業の見える化を画面に出している間だけ測る
    if [[ $s == 1 ]] && (( shown )); then
      __sys_usage $mem_total
      usage=$'\t'$REPLY
    else
      usage=''
    fi
    { print -r -- "$(( ++seq )) $g"$'\t'"$cpu"$'\t'"$hw$usage"; __render } >| "$render_file.tmp" 2>/dev/null || true
    zf_mv -f "$render_file.tmp" "$render_file" 2>/dev/null || true
    if (( shown )); then
      __sys_cpu
      cpu=$REPLY
    else
      zselect -t 50 || true
    fi
  done
}

# rendered のAIの行を,C-s で下に開いた時の並び(browse_order)に並べ直す(その後に出たAIは,届いた順で後ろに付ける)
# 下に開いて見たAIは完了から待機へ戻り,いつもの並びでは下へ動くため,そのままだと C-n で次の完了の行を飛ばしてしまう
__keep_browse_order() {
  local line id
  local -a head rows ordered
  local -A row_of

  for line in "${rendered[@]}"; do
    if [[ $line == *$'\t'* ]]; then
      id=${${line#*$'\t'}%%$'\t'*}
      row_of[$id]=$line
      rows+=("$id")
    else
      head+=("$line")
    fi
  done
  for id in "${browse_order[@]}" "${rows[@]}"; do
    (( ${+row_of[$id]} )) || continue
    ordered+=("${row_of[$id]}")
    unset "row_of[$id]"
  done
  rendered=("${head[@]}" "${ordered[@]}")
}

# 描画結果から優先度・キー・TARGETの列を外して lines に,選択できるペインIDを並び順に jump_ids に入れる
# 一覧の下の作業の見える化のため,一覧に出ているAIのキーを並び順に agent_keys に,TARGETと優先度を target_of / agent_prio に入れる
# 表示範囲をずらせるよう,データ行の開始位置を first_row に,選択中の行の位置を selected_line に入れる(無ければ0)
# 未選択のC-kで開く先として,判断待ち,無ければ完了のうち一番上のペインIDを attention_id に入れる
# 選択できる時は数字キーで選べるよう,選択できる行の頭に1〜9の番号を付ける
# 選択中のペインがあれば目立たせ,一覧から消えていれば選択を外す
# (ただし d・C-d・Space で起動して下に開いているAIは,AIが立ち上がって一覧に出るまでの間も選んだままにする)
# 状態が変わった行と新しく出た行は閃光で知らせる(最初に一覧を出した時は全て新しいので光らせない)
# 行の後ろに添えたメモ(__format_row)も外し,i で INFO の表示にしている時は,MODEL から後ろの列をメモに替える
__split_rendered() {
  local line priority id target input_id done_id num input_priority done_priority info header
  local -A states

  lines=()
  line_of=()
  jump_ids=()
  agent_keys=()
  target_of=()
  agent_prio=()
  first_row=0
  selected_line=0
  input_id=''
  done_id=''
  __priority_for blocked
  input_priority=$REPLY
  __priority_for done
  done_priority=$REPLY
  # C-s で下に開いている間は,開いた時の並び(browse_order)のままにする(閉じたら,いつもの並びに戻す)
  if (( ${#last_swap} )); then
    (( ! ${#browse_order} )) || __keep_browse_order
  else
    browse_order=()
  fi

  for line in "${rendered[@]}"; do
    if [[ $line == *$'\t'* ]]; then
      (( first_row )) || first_row=$(( ${#lines} + 1 ))
      priority=${line%%$'\t'*}
      line=${line#*$'\t'}
      id=${line%%$'\t'*}
      line=${line#*$'\t'}
      target=${line%%$'\t'*}
      line=${line#*$'\t'}
      info=${line#*$'\t'}
      line=${line%%$'\t'*}
      if (( info_view )); then
        __info_row "$line" "$info"
        line=$REPLY
      fi
      agent_keys+=("$id")
      target_of[$id]=$target
      agent_prio[$id]=$priority
      num=''
      if [[ $id == %* ]]; then
        jump_ids+=("$id")
        (( ${#jump_ids} > 9 )) || num=${#jump_ids}
        [[ $id == "$selected_id" ]] && selected_line=$(( ${#lines} + 1 ))
        [[ $priority == "$input_priority" && -z $input_id ]] && input_id=$id
        [[ $priority == "$done_priority" && -z $done_id ]] && done_id=$id
        states[$id]=$priority
        line_of[$id]=$(( ${#lines} + 1 ))
      fi
      (( ! selectable )) || line=${(r:2:)num}$line
    elif (( ! ${#lines} && show_keys )); then
      # ? でキーの説明を出している間は,見出しを時刻の無いキーの説明に差し替える
      line="AI Bridge  (${key_help[show_keys]})"
    fi
    lines+=("$line")
  done
  attention_id=${input_id:-$done_id}
  # INFO の表示では,列の名前(データ行の1つ上の行)も MODEL から後ろを INFO にする
  if (( info_view && first_row > 1 )); then
    printf -v header '%*s%-7s %-23s %-7s %-14s %-22s %s' $(( selectable ? 2 : 0 )) '' PID TARGET AGENT STATUS DIR INFO
    lines[first_row-1]=$header
  fi

  if (( split_once )); then
    for id in ${(k)states}; do
      [[ ${row_state[$id]:-} == "${states[$id]}" ]] || flash_at[$id]=$EPOCHREALTIME
    done
  fi
  row_state=("${(@kv)states}")
  split_once=1

  if (( ! selected_line )); then
    [[ -n $selected_id && $selected_id == "$launched_id" && $selected_id == "${last_swap[1]:-}" ]] || selected_id=''
    return 0
  fi
  launched_id=''

  lines[selected_line]=$(__highlight_selected "${lines[selected_line]}")
}

# INFO の表示の行(一覧の行の DIR までの78桁に,MODEL から後ろの列の代わりにメモを続ける)
# メモはペインの右端の1桁手前まで使い,長いものは … で切り,メモの無い行は暗い - にする
# (幅は描き手が描く時に聞き直したペインの幅で,選べる時は行の頭の番号の2桁の分を引く)
__info_row() { # $1=一覧の行 $2=メモ → REPLY
  local prefix
  integer width

  __vis_cut "$1" 78
  prefix=$REPLY
  width=$(( pane_cols - (selectable ? 2 : 0) - 79 ))
  (( width >= 8 )) || width=8
  if [[ -n $2 ]]; then
    __clip "$2" $width
    REPLY=$prefix$'\e[38;5;229m'$REPLY$'\e[0m'
  else
    REPLY=$prefix$'\e[38;5;240m-\e[0m'
  fi
}

# 選択中の行に暗い紺を行末まで敷き,文字の色は残す
# (反転は白地が目に刺さり,色付きの列が別の色の帯になるため背景色で示す)
__highlight_selected() {
  local bg reset bright
  bg=$'\e[48;2;31;47;79m'
  reset=$'\e[0m'
  # 紺地では暗い赤・緑・黄・灰色が読みにくいため,同じ色相の明るい色にする(灰色は明るい灰色)
  bright=${${${${${${1//$'\e[1;31m'/$'\e[1;91m'}//$'\e[1;33m'/$'\e[1;93m'}//$'\e[31m'/$'\e[91m'}//$'\e[32m'/$'\e[92m'}//$'\e[33m'/$'\e[93m'}//$'\e[90m'/$'\e[37m'}
  # 行の中の色の解除で背景も消えるので,解除のたびに敷き直してから行末まで塗る
  print -rn -- "$bg${bright//$reset/$reset$bg}"$'\e[K'"$reset"
}

# 隠れた行数の表示(下だけなら従来どおり "+N more")
__hidden_rows_label() {
  integer above below

  above=$1
  below=$2

  if (( above && below )); then
    printf '\e[90m… +%d above, +%d more\e[0m' $above $below
  elif (( above )); then
    printf '\e[90m… +%d above\e[0m' $above
  else
    printf '\e[90m… +%d more\e[0m' $below
  fi
}

# ペインに収まる画面を組み立てて out に入れる
# 折り返し抑止だけでは行数超過を防げないため,ペインに収まる行数へ切り詰め,隠れた行数は最終行に出す
# 末尾に改行を出さないのも同じ理由(最終行で改行するとそれだけでスクロールする)
# 選択中の行が隠れないようデータ行の表示範囲(scroll_top)を必要な分だけずらす
__compose_screen() {
  integer max_lines shown_header room capacity row_count sel bottom
  local -a rows screen

  max_lines=$1

  if (( ${#lines} <= max_lines )); then
    scroll_top=1
    out=${(F)lines}
    return 0
  fi

  # データ行が無いのに溢れる場合は見出しを先頭から切り詰める
  if (( ! first_row )); then
    out=${(F)lines[1,max_lines-1]}$'\n'$(__hidden_rows_label 0 $(( ${#lines} - max_lines + 1 )))
    return 0
  fi

  rows=("${(@)lines[first_row,-1]}")
  row_count=${#rows}

  # 見出しを出しても隠れた行数の表示と1行以上のデータ行が入るなら見出しを残し,
  # 入らない狭いペインでは選択中の行が見えることを優先して見出しを外す
  if (( max_lines - (first_row - 1) - 1 >= 1 )); then
    shown_header=$(( first_row - 1 ))
  else
    shown_header=0
  fi
  room=$(( max_lines - shown_header ))

  # データ行が全部入るなら隠れた行数の表示は出さず,1行しか入らない時も行を優先して出さない
  if (( row_count <= room )); then
    capacity=$row_count
  elif (( room >= 2 )); then
    capacity=$(( room - 1 ))
  else
    capacity=$room
  fi

  if (( selected_line )); then
    sel=$(( selected_line - first_row + 1 ))
    scroll_top=$(( scroll_top > sel ? sel : (scroll_top < sel - capacity + 1 ? sel - capacity + 1 : scroll_top) ))
  else
    scroll_top=1
  fi
  scroll_top=$(( scroll_top > row_count - capacity + 1 ? row_count - capacity + 1 : (scroll_top < 1 ? 1 : scroll_top) ))
  bottom=$(( scroll_top + capacity - 1 ))

  screen=()
  (( ! shown_header )) || screen+=("${(@)lines[1,shown_header]}")
  screen+=("${(@)rows[scroll_top,bottom]}")
  (( capacity == row_count || capacity == room )) || screen+=("$(__hidden_rows_label $(( scroll_top - 1 )) $(( row_count - bottom )))")

  out=${(F)screen}
}

# --- 作業の見える化: 一覧の下の余白に,どのリポジトリで何をしているか(WORKSPACE)と,有益な出来事だけの作業ログ(OPS.LOG)と,この Mac の使用率(SYSTEM)を出す ---
# 材料は各AIのフックで ai-agent-state が残す作業ログ(<キー>.activity: 時刻 種類 ツール 対象 補足 作業ディレクトリ)
# AIは一覧の並びが状態で入れ替わっても同じ名前で示せるよう,行番号ではなくTARGETで示す
typeset -A repo_root_of ops_verb_col
ops_verb_col=(ORDER 213 MSG 141 EDIT 48 EXEC 51 TEST 87 COMMIT 220 PUSH 214 SPAWN 141 FETCH 75 SEARCH 75 STEP 159 ASK 214 SKILL 141 AWAIT 214 DONE 203)
ops_tsig=''
ops_log=()
ops_cached=()
ops_newest=''
ops_newest_at=0
ops_label_w=4
ops_repo_count=0
ops_cache_cols=0
ops_cache_rows=0
# ペインの高さと幅(描画で大きさを聞き直す時に覚える,作業ログの行は高さの分だけ作っておく)
pane_rows=24
pane_cols=80
# 一覧が短い時に作業の見える化の枠が大きくなりすぎないよう,枠の上端はペインの上からこの割合(%)の位置より上にしない
ops_top_pct=25
# AIごとの材料(作業ディレクトリのリポジトリ・指示とその時刻・ターンの始まりと終わり・実行中のコマンド・承認待ち・
# 最後に動いた時刻・このターンの編集の集計・コミットやプッシュの印)と,このターンに触ったファイル(キーは リポジトリ<TAB>パス<TAB>AI)
typeset -A ag_root ag_task ag_task_t ag_turn_t ag_end ag_run ag_run_t ag_wait ag_last ag_files ag_add ag_del ag_mark ag_mark_t ops_files
# 作業ログは追記されていくだけなので,AIごとに読んだ所(inode・大きさ・1行目・行数)と拾った出来事を覚えて,
# 変わった時にファイルを読み直しても,解釈するのは増えた行だけにする
typeset -A ops_ino ops_size ops_head ops_seen ops_ev
# SYSTEM に出す CPU・GPU・メモリ・ストレージの値(裏が測って一覧のファイルの1行目に載せたものを,取り込むたびに写す)
typeset -A sys
# SYSTEM の行を作った時のペインの幅と,取り込んだ一覧の通し番号
ops_sys_key=''

# コマンドの種類(テストの実行・コミット・プッシュ)を,コマンドとして実行した時だけ判定する
# && ; | で区切った各部分の先頭の語で見る(環境変数の指定や bundle exec 等の前置きは飛ばす)
__cmd_kind() { # $1=コマンド → REPLY=TEST/COMMIT/PUSH/空
  setopt localoptions extendedglob
  local seg
  local -a w
  REPLY=''
  for seg in "${(@s:;:)${${1//\&\&/;}//[|]/;}}"; do
    w=(${=seg})
    while (( ${#w} )) && [[ ${w[1]} == [A-Za-z_][A-Za-z0-9_]#=* ]]; do w[1]=(); done
    while (( ${#w} )) && [[ ${w[1]} == (time|env|npx|command) ]]; do w[1]=(); done
    [[ ${w[1]:-} == bundle && ${w[2]:-} == exec ]] && w[1,2]=()
    case ${w[1]:-} in
      bin/rspec | rspec | jest | vitest | pytest) REPLY=TEST; return 0 ;;
      go | cargo) [[ ${w[2]:-} == test ]] && { REPLY=TEST; return 0 } ;;
      bin/rails | rails) [[ ${w[2]:-} == test* ]] && { REPLY=TEST; return 0 } ;;
      pnpm | yarn | npm)
        [[ ${w[2]:-} == (--filter|-F|-w) ]] && w[2,3]=()
        [[ ${w[2]:-} == test(|:*) || ( ${w[2]:-} == run && ${w[3]:-} == test(|:*) ) ]] && { REPLY=TEST; return 0 } ;;
      git)
        [[ ${w[2]:-} == commit ]] && { REPLY=COMMIT; return 0 }
        [[ ${w[2]:-} == push ]] && { REPLY=PUSH; return 0 } ;;
    esac
  done
  return 0
}

# ファイルや作業ディレクトリが入っているgitリポジトリの一番上(無ければそのディレクトリ)
__repo_root() {
  local r=$1
  if [[ -n ${repo_root_of[$1]:-} ]]; then
    REPLY=${repo_root_of[$1]}
    return 0
  fi
  while [[ $r != / && -n $r && ! -e $r/.git ]]; do r=${r:h}; done
  [[ $r == / || -z $r ]] && r=$1
  repo_root_of[$1]=$r
  REPLY=$r
}

# 表示用のリポジトリ名(ghq の github.com/持ち主/名前 なら名前だけ,ほかは一番上のディレクトリ名)
# 持ち主まで出すと長くなり,狭いペインで名前が切れて読みにくいため出さない
__repo_name() {
  local rest
  case $1 in
    */github.com/*/*) rest=${1#*/github.com/}; REPLY=${${rest#*/}%%/*} ;;
    *) REPLY=${1:t} ;;
  esac
}

# 経過秒を 1h5m / 3m12s / 45s に(時刻の引き算は 74.999… のようになるので四捨五入する)
__fmt_dur() {
  integer s=$(( $1 + 0.5 ))
  if (( s >= 3600 )); then REPLY="$(( s / 3600 ))h$(( s % 3600 / 60 ))m"
  elif (( s >= 60 )); then REPLY="$(( s / 60 ))m$(( s % 60 ))s"
  else REPLY="${s}s"; fi
}

# 読んでいるAIの出来事(呼び出し元の ev)に足す
__ops_add() { # 時刻 キー 動詞 対象 補足
  local tk
  # 秒未満の桁数が記録ごとに違うと数として並べた時に前後が狂うので,小数点以下を3桁にそろえる
  printf -v tk '%.3f' $1
  ev+=("$tk"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"$5")
}

# 文字列のバイト数(書きかけの行を見分けるため,ファイルの大きさと比べる)
__byte_len() {
  setopt localoptions nomultibyte
  REPLY=${#1}
}

# AIの材料と作業ログを読んだ所を捨てる(作業ログを最初から読み直す時と,一覧から消えた時)
__ops_forget() {
  local k

  unset "ag_root[$1]" "ag_task[$1]" "ag_task_t[$1]" "ag_turn_t[$1]" "ag_end[$1]" "ag_run[$1]" "ag_run_t[$1]" \
    "ag_wait[$1]" "ag_last[$1]" "ag_files[$1]" "ag_add[$1]" "ag_del[$1]" "ag_mark[$1]" "ag_mark_t[$1]" \
    "ops_ino[$1]" "ops_size[$1]" "ops_head[$1]" "ops_seen[$1]" "ops_ev[$1]"
  for k in ${(k)ops_files}; do
    [[ ${ops_files[$k]%% *} == "$1" ]] && unset "ops_files[$k]"
  done
  return 0
}

# 一覧に出ているAIの作業ログを読み,ワークスペースと作業ログの材料を作る
# 全部を解釈し直すと描き直しが止まるため,追記されていくだけの作業ログは前に解釈した行を解釈し直さず,増えた行だけを解釈する
# (ファイルは書きかけの行や入れ替わりを見分けるため変わるたびに丸ごと読む,切り詰めや作り直しで中身が入れ替わった時は
# 最初から解釈し直し,一覧から消えたAIの材料は捨てる)
__ops_load() {
  local key f kind tool obj extra cwd root k content tsig
  local -a p v lines ev all
  local -A st st2
  typeset -F t now
  integer a d i n changed

  # 出していない間は読まない(出した時に,それまでに増えた行をまとめて読む)
  (( show_ops )) || return 0
  now=$EPOCHREALTIME

  for key in ${(k)ops_ino}; do
    (( ${agent_keys[(Ie)$key]} )) && continue
    __ops_forget $key
    changed=1
  done

  for key in $agent_keys; do
    f=$state_dir/$key.activity
    if ! zstat -H st "$f" 2>/dev/null; then
      if (( ${+ops_ino[$key]} )); then
        __ops_forget $key
        changed=1
      fi
      continue
    fi
    [[ ${st[inode]} == "${ops_ino[$key]:-}" ]] && (( st[size] == ${ops_size[$key]:-0} )) && continue

    changed=1
    content=$(<$f)
    # 読んでいる間に置き換わると,どちらの中身を読んだか分からないので次に最初から読み直す
    if ! zstat -H st2 "$f" 2>/dev/null || [[ ${st2[inode]} != "${st[inode]}" ]]; then
      __ops_forget $key
      continue
    fi
    lines=("${(@f)content}")
    # 切り詰めで置き換わった(inodeが違う)・作り直された(1行目が違う)時は最初から読み直す
    [[ ${st[inode]} == "${ops_ino[$key]:-}" && ${lines[1]} == "${ops_head[$key]:-}" ]] || __ops_forget $key
    n=${#lines}
    # 大きさが読んだ中身と末尾の改行1つの分に合わない時は,最後の行が書きかけかもしれないので次に読む
    __byte_len "$content"
    (( REPLY + 1 == st[size] )) || (( n-- ))
    ev=()
    for (( i = ${ops_seen[$key]:-0} + 1; i <= n; i++ )); do
      p=("${(@ps:\t:)lines[i]}")
      # 時刻で始まらない行は数として扱えず描き手ごと止まるので読み飛ばす
      [[ ${p[1]} == <->.<-> ]] || continue
      t=${p[1]} kind=${p[2]} tool=${p[3]} obj=${p[4]} extra=${p[5]} cwd=${p[6]}
      if [[ -n $cwd ]]; then
        __repo_root "$cwd"
        ag_root[$key]=$REPLY
      fi
      ag_last[$key]=$t
      case $kind in
        U)
          case $obj in
            # チームのエージェントからの連絡は人の指示と分け(中身は出さない),ほかの < で始まる自動の入力は出さない
            '<agent-message'*) ag_turn_t[$key]=$t ag_end[$key]=''; __ops_add $t $key MSG 'チームのエージェントから連絡' ''; continue ;;
            '<'*) continue ;;
          esac
          # 新しい指示で,そのAIのこのターンの記録をやり直す
          ag_task[$key]=$obj ag_task_t[$key]=$t ag_turn_t[$key]=$t ag_end[$key]='' ag_wait[$key]='' ag_run[$key]=''
          ag_files[$key]=0 ag_add[$key]=0 ag_del[$key]=0
          for k in ${(k)ops_files}; do [[ ${ops_files[$k]%% *} == "$key" ]] && unset "ops_files[$k]"; done
          __ops_add $t $key ORDER "「$obj」" '' ;;
        P)
          case $tool in
            Bash | exec | shell)
              ag_run[$key]=$obj ag_run_t[$key]=$t
              __cmd_kind "$extra"
              [[ $REPLY == (COMMIT|PUSH) ]] && ag_mark[$key]=$REPLY ag_mark_t[$key]=$t
              __ops_add $t $key ${REPLY:-EXEC} "$obj" '' ;;
            Agent | Task) __ops_add $t $key SPAWN "$obj" "$extra" ;;
            WebFetch) __ops_add $t $key FETCH "${${obj#*://}%%/*}" '' ;;
            WebSearch) __ops_add $t $key SEARCH "$obj" '' ;;
            TodoWrite) [[ -n $obj ]] && __ops_add $t $key STEP "$obj" '' ;;
            AskUserQuestion) __ops_add $t $key ASK "$obj" '' ;;
            Skill) __ops_add $t $key SKILL "$obj" '' ;;
          esac ;;
        D | F)
          # 承認を待っていたツールが終われば(失敗も含む),承認待ちも終わっている
          [[ ${ag_wait[$key]:-} == "$obj" ]] && ag_wait[$key]=''
          case $tool in
            Bash | exec | shell) [[ ${ag_run[$key]:-} == "$obj" ]] && ag_run[$key]='' ;;
            Edit | Write | MultiEdit | NotebookEdit | apply_patch)
              # 失敗した編集はファイルを変えていないので数えない
              [[ $kind == D ]] || continue
              # パッチは複数のファイルをまとめて書くので,先頭のファイルに寄せる
              obj=${obj%%, *}
              [[ $obj == /* ]] || obj=${cwd:-$HOME}/$obj
              # 一時ディレクトリのファイルは作業ではないので出さない
              [[ $obj == (/tmp/*|/private/tmp/*|/var/folders/*) ]] && continue
              # ~/.claude/skills のようにリンクの先が git の中にある道筋は,実体の場所で辿る
              obj=${obj:A}
              __repo_root "${obj:h}"; root=$REPLY
              a=${${extra%% *}#+} d=${${extra##* }#-}
              # 同じファイルを複数のAIが触っても,AIごとに数える
              k=$root$'\t'${obj#$root/}$'\t'$key
              # git の外のファイル(タスクのメモ等)はリポジトリの変更ではないので,リポジトリの欄を空にしてワークスペースに出さない
              # (作業ログとターンの集計には入れる)
              [[ -e $root/.git ]] || k=$'\t'$k
              if [[ -n ${ops_files[$k]:-} ]]; then
                v=(${=ops_files[$k]})
                ops_files[$k]="$key $(( v[2] + a )) $(( v[3] + d )) $(( v[4] + 1 )) $t"
              else
                ops_files[$k]="$key $a $d 1 $t"
                (( ++ag_files[$key] ))
              fi
              ag_add[$key]=$(( ${ag_add[$key]:-0} + a )) ag_del[$key]=$(( ${ag_del[$key]:-0} + d ))
              __ops_add $t $key EDIT "${obj#$root/}" "+$a -$d" ;;
          esac ;;
        W) ag_wait[$key]=$obj; __ops_add $t $key AWAIT "$obj" '' ;;
        S)
          ag_end[$key]=$t ag_run[$key]='' ag_wait[$key]=''
          # かかった時間は,ターンの始まり(指示か連絡)が分かる時だけ添える
          REPLY=''
          [[ -n ${ag_turn_t[$key]:-} ]] && __fmt_dur $(( t - ag_turn_t[$key] ))
          if (( ${ag_files[$key]:-0} == 1 )); then
            obj="1 file  +${ag_add[$key]} -${ag_del[$key]}"
          elif (( ${ag_files[$key]:-0} > 1 )); then
            obj="${ag_files[$key]} files  +${ag_add[$key]} -${ag_del[$key]}"
          else
            obj='no changes'
          fi
          __ops_add $t $key DONE "$obj${REPLY:+  in $REPLY}" '' ;;
      esac
    done
    (( ! ${#ev} )) || ops_ev[$key]+=${(F)ev}$'\n'
    ops_ino[$key]=${st[inode]} ops_size[$key]=${st[size]} ops_head[$key]=${lines[1]} ops_seen[$key]=$n
  done

  # AIごとの出来事を合わせて時刻順に並べる
  if (( changed )); then
    all=()
    for key in ${(k)ops_ev}; do
      all+=("${(@f)${ops_ev[$key]%$'\n'}}")
    done
    ops_log=("${(@on)all}")
  fi
  # 1時間より前の出来事は出さない(作業ログが変わらなくても,時間が経てば外す)
  for (( i = 1; i <= ${#ops_log}; i++ )); do
    (( ${ops_log[i]%%$'\t'*} < now - 3600 )) || break
  done
  if (( i > 1 )); then
    ops_log=("${(@)ops_log[i,-1]}")
    changed=1
  fi
  # 出来事もTARGETの名前も変わっていなければ,作っておいた作業ログの行をそのまま使う
  tsig=${(j: :)${(@kv)target_of}}
  (( changed )) || [[ $tsig != "$ops_tsig" ]] || return 0
  ops_tsig=$tsig
  # いちばん新しい出来事が変わったら,それを1文字ずつ打ち出し直す
  if [[ ${ops_log[-1]:-} != "$ops_newest" ]]; then
    ops_newest=${ops_log[-1]:-} ops_newest_at=$now
  fi
  __ops_cache_log
  return 0
}

# 色の指定を除いた見えている幅(全角は2)
__vis() {
  setopt localoptions extendedglob
  local p=${1//$'\e'\[[0-9;]#[mG]/}
  REPLY=${(m)#p}
}
# 色の指定の無い文字列を,見えている幅 $2 に切り詰める
__clip() {
  local s=$1
  if (( ${(m)#s} <= $2 )); then
    REPLY=$s
    return 0
  fi
  s=${s[1,$2]}
  while (( ${(m)#s} > $2 - 1 )); do s=${s[1,-2]}; done
  REPLY=$s…
}

# 作業ログの1行(いちばん新しいものから数えた $2 番目ほど暗くする,$3=1 なら打ち出す途中に使う色の無い文字列)
__ops_log_line() { # $1=出来事 $2=新しい順の位置(0が最新) $3=色の無い文字列にするか → REPLY
  local ts verb obj extra name label tc col
  local -a p
  integer iw=$(( pane_cols - 2 )) lw rw ow
  p=("${(@ps:\t:)1}")
  strftime -s ts '%H:%M:%S' ${p[1]%.*}
  __repo_name "${ag_root[${p[2]}]:--}"; name=$REPLY
  label=${target_of[${p[2]}]:-${p[2]}}
  verb=${p[3]} obj=${p[4]} extra=${p[5]}
  lw=$(( ops_label_w )) rw=16
  __clip "$label" $lw; label=$REPLY
  __clip "$name" $rw; name=$REPLY
  ow=$(( iw - 1 - 8 - 2 - lw - 2 - rw - 2 - 6 - 2 - (${#extra} ? ${#extra} + 2 : 0) ))
  (( ow < 8 )) && ow=8
  __clip "$obj" $ow; obj=$REPLY
  if (( ${3:-0} )); then
    REPLY=" $ts  ${(r:lw:)label}  ${(r:rw:)name}  ${(r:6:)verb}  $obj${extra:+  $extra}"
    return 0
  fi
  tc=${${(s: :):-255 252 249 246 244 242 240}[$(( $2 > 6 ? 7 : $2 + 1 ))]}
  col=${ops_verb_col[$verb]:-245}
  REPLY=$'\e[38;5;242m'" $ts  "$'\e[38;5;244m'"${(r:lw:)label}  "$'\e[38;5;37m'"${(r:rw:)name}  "$'\e[1;38;5;'${col}m"${(r:6:)verb}"$'\e[0;38;5;'${tc}m"  $obj"
  # 補足は,編集の増減(+追加 -削除)なら色を分け,ほか(子エージェントの種類等)はそのまま出す
  if [[ $extra == +<->' '-<-> ]]; then
    REPLY+="  "$'\e[38;5;34m'"${extra%% *}"$'\e[38;5;160m'" ${extra##* }"
  elif [[ -n $extra ]]; then
    REPLY+="  "$'\e[38;5;245m'"$extra"
  fi
  return 0
}

# 作業ログの行は読み直した時に作っておき,コマごとには最新の1行だけ作り直す
# 出せるのは多くてもペインの高さまでなので,新しい方からその分だけ作る
__ops_cache_log() {
  local label
  integer i n=${#ops_log} from
  ops_cache_cols=$pane_cols
  ops_cache_rows=$pane_rows
  # TARGETの列は出ているAIの名前の長さに合わせる(長すぎる名前は21桁で切る)
  ops_label_w=4
  for label in ${(v)target_of}; do (( ${(m)#label} > ops_label_w )) && ops_label_w=${(m)#label}; done
  (( ops_label_w > 21 )) && ops_label_w=21
  ops_cached=()
  from=$(( n - pane_rows > 1 ? n - pane_rows : 1 ))
  for (( i = from; i < n; i++ )); do
    __ops_log_line "${ops_log[i]}" $(( n - i )) 0
    ops_cached+=("$REPLY")
  done
  return 0
}

# 枠(色の指定を除いた見えている幅で右端をそろえる)
__ops_frame_top() {
  integer fill=$(( pane_cols - 8 - ${#1} - ${(m)#2} ))
  (( fill < 0 )) && fill=0
  REPLY=$'\e[38;5;30m╭─\e[1;38;5;51m'" $1 "$'\e[0;38;5;30m'"${(l:fill::─:):-}"$'\e[38;5;242m'" $2 "$'\e[38;5;30m─╮\e[0m'
}
__ops_frame_mid() {
  integer fill=$(( pane_cols - 8 - ${#1} - ${(m)#2} ))
  (( fill < 0 )) && fill=0
  REPLY=$'\e[38;5;30m├─\e[1;38;5;51m'" $1 "$'\e[0;38;5;30m'"${(l:fill::─:):-}"$'\e[38;5;242m'" $2 "$'\e[38;5;30m─┤\e[0m'
}
__ops_frame_line() {
  local body=$1
  integer pad iw=$(( pane_cols - 2 ))
  __vis "$body"
  # 狭いペインで中身が枠の内側より長い時だけ,色の指定は残して見えている幅で切る
  if (( REPLY > iw )); then
    __vis_cut "$body" $iw
    body=$REPLY
    __vis "$body"
  fi
  pad=$(( iw - REPLY ))
  REPLY=$'\e[38;5;30m│\e[0m'"$body"$'\e[0m'"${(l:pad:: :):-}"$'\e[38;5;30m│\e[0m'
}
# 色の指定はそのまま残し,見えている幅 $2 までで切る
__vis_cut() { # $1=文字列 $2=幅 → REPLY
  setopt localoptions extendedglob
  local s=$1 out='' ch
  integer w=0 cw
  while [[ -n $s ]]; do
    if [[ ${s[1]} == $'\e' ]]; then
      ch=${(M)s##$'\e'\[[0-9;]#[mG]}
      if [[ -n $ch ]]; then
        out+=$ch
        s=${s:${#ch}}
        continue
      fi
    fi
    ch=${s[1]}
    cw=${(m)#ch}
    (( w + cw > $2 )) && break
    out+=$ch
    w=$(( w + cw ))
    s=${s:1}
  done
  REPLY=$out
}
__ops_frame_bottom() { REPLY=$'\e[38;5;30m╰'"${(l:$(( pane_cols - 2 ))::─:):-}"$'╯\e[0m' }

# AIの名前(TARGET)と状態の記号(作業中は回し,判断待ちは脈打たせる)
__ops_badge() { # $1=キー $2=コマ → REPLY
  local label=${target_of[$1]:-$1}
  case ${agent_prio[$1]:-} in
    0) REPLY=$'\e[1;38;5;214m'"$label ${pulse[$2 / 2 % 8 + 1]}" ;;
    1) REPLY=$'\e[1;38;5;203m'"$label ●" ;;
    2) REPLY=$'\e[1;38;5;46m'"$label ${spin[$2 % 8 + 1]}" ;;
    *) REPLY=$'\e[38;5;242m'"$label ●" ;;
  esac
}

# WORKSPACE: リポジトリごとに,そこで動くAIと今のターンで触ったファイル・実行中のコマンド
__ops_ws() { # $1=使ってよい行数 $2=コマ → ops_ws 配列
  local root name k f line bar col dur relp agents key
  local -a roots files v picked sorted
  local -A last_of block_of
  integer i lvl shown working upto gap pw first max=$1 iw=$(( pane_cols - 2 ))
  float age now=$EPOCHREALTIME
  ops_ws=()
  # リポジトリを,AIの作業ディレクトリと触ったファイルから集め,入りきらない時に残すものは新しく動いた順に選ぶ
  for key in ${(k)ag_root}; do root=${ag_root[$key]}; (( ${ag_last[$key]:-0} > ${last_of[$root]:-0} )) && last_of[$root]=${ag_last[$key]}; done
  for k in ${(k)ops_files}; do root=${k%%$'\t'*}; [[ -n $root ]] || continue; v=(${=ops_files[$k]}); (( v[5] > ${last_of[$root]:-0} )) && last_of[$root]=${v[5]}; done
  for root in ${(k)last_of}; do roots+=("${last_of[$root]}"$'\t'"$root"); done
  roots=("${(@On)roots}")
  ops_repo_count=${#roots}
  for line in $roots; do
    (( ${#ops_ws} < max )) || break
    root=${line#*$'\t'}
    __repo_name "$root"; name=$REPLY
    working=0 agents='' first=$(( ${#ops_ws} + 1 ))
    for key in $agent_keys; do
      [[ ${ag_root[$key]:-} == "$root" ]] || continue
      [[ ${agent_prio[$key]:-} == 2 ]] && working=1
      __ops_badge $key $2; agents+="  $REPLY"
      # 承認待ちは一覧の状態が判断待ちの時だけ出す(拒否や中断では作業ログに終わりが残らないため)
      if [[ -n ${ag_wait[$key]:-} && ${agent_prio[$key]:-} == 0 ]]; then
        __clip "${ag_wait[$key]}" 30; agents+=$'\e[0;38;5;214m'" AWAIT $REPLY"
      elif [[ -n ${ag_task[$key]:-} ]]; then
        __clip "${ag_task[$key]}" 28
        # 新しい指示が来た瞬間は1文字ずつ打ち出す
        age=$(( now - ag_task_t[$key] ))
        if (( age < 3 )); then
          upto=$(( age * 20 + 1 ))
          agents+=$'\e[0;38;5;195m'" 「${REPLY[1,upto]}"$'\e[1;38;5;51m█'
        else
          agents+=$'\e[0;38;5;245m'" 「$REPLY」"
        fi
      fi
      # ターンが終わってから10分は,かかった時間を添える(始まりが分からない時は印だけ)
      if [[ -n ${ag_end[$key]:-} && ${agent_prio[$key]:-} == [13] ]] && (( now - ag_end[$key] < 600 )); then
        if [[ -n ${ag_turn_t[$key]:-} ]]; then
          __fmt_dur $(( ag_end[$key] - ag_turn_t[$key] )); agents+=$'\e[0;38;5;71m'" ✓ $REPLY"
        else
          agents+=$'\e[0;38;5;71m'" ✓"
        fi
      fi
      # コミット・プッシュの直後は金色の札を点滅させる
      if [[ -n ${ag_mark[$key]:-} ]] && (( now - ag_mark_t[$key] < 8 && $2 / 3 % 2 )); then
        if [[ ${ag_mark[$key]} == COMMIT ]]; then agents+=$'\e[1;38;5;220m  ◆ COMMIT'; else agents+=$'\e[1;38;5;220m  ▲ PUSH'; fi
      fi
    done
    # リポジトリの札: そこで作業中のAIがいれば光が脈打つ
    if (( working )); then col=${${(s: :):-51 45 38 31 38 45}[$(( $2 / 2 % 6 + 1 ))]}; else col=244; fi
    ops_ws+=(" "$'\e[1;38;5;'${col}m"▣ "$'\e[1;38;5;255m'"$name"$'\e[0;38;5;23m'" ─"$agents)
    # そのリポジトリで今のターンに触ったファイル(新しい順に3つまで)
    files=()
    for k in ${(k)ops_files}; do [[ ${k%%$'\t'*} == "$root" ]] || continue; v=(${=ops_files[$k]}); files+=("${v[5]}"$'\t'"$k"); done
    files=("${(@On)files}")
    shown=0
    for f in $files; do
      (( shown < 3 && ${#ops_ws} < max )) || break
      k=${f#*$'\t'}; v=(${=ops_files[$k]})
      age=$(( now - v[5] ))
      # 熱量: 触ってから時間が経つほど短く暗くなる
      if (( age < 30 )); then lvl=6; elif (( age < 120 )); then lvl=5; elif (( age < 300 )); then lvl=4; elif (( age < 600 )); then lvl=3; elif (( age < 1200 )); then lvl=2; else lvl=1; fi
      bar=''
      for (( i = 1; i <= 6; i++ )); do
        if (( i <= lvl )); then bar+=$'\e[38;5;'${${(s: :):-22 28 34 40 46 120}[i]}m'▮'; else bar+=$'\e[38;5;236m▯'; fi
      done
      __fmt_dur $age; dur=$REPLY
      pw=$(( iw - 48 - ops_label_w )); (( pw < 8 )) && pw=8
      __clip "${${k#*$'\t'}%$'\t'*}" $pw; relp=$REPLY
      # 書き込んだ瞬間はその行を白く光らせる
      if (( age < 1.5 )); then line="   "$'\e[1;38;5;231m'"✎ $relp"; else line="   "$'\e[38;5;48m'"✎ "$'\e[38;5;252m'"$relp"; fi
      __vis "$line"
      gap=$(( iw - 38 - ops_label_w - REPLY )); (( gap < 1 )) && gap=1
      ops_ws+=("$line${(l:gap:: :):-}  $bar"$'\e[0;38;5;34m'" +${v[2]}"$'\e[38;5;160m'" -${v[3]}"$'\e[38;5;242m'"  ×${v[4]}  ${(l:6:: :)dur}  "$'\e[38;5;244m'"${target_of[${v[1]}]:-${v[1]}}")
      (( ++shown ))
    done
    # そのリポジトリで動いているAIの,実行中のコマンド
    # (中断・拒否では作業ログに終わりが残らないため,一覧の状態が作業中の時だけ出す)
    for key in $agent_keys; do
      [[ ${ag_root[$key]:-} == "$root" && -n ${ag_run[$key]:-} && ${agent_prio[$key]:-} == 2 ]] || continue
      (( ${#ops_ws} < max )) || break
      __fmt_dur $(( now - ag_run_t[$key] )); dur=$REPLY
      pw=$(( iw - 34 - ops_label_w )); (( pw < 8 )) && pw=8
      __clip "${ag_run[$key]}" $pw
      ops_ws+=("   "$'\e[38;5;51m▶ \e[38;5;250m'"$REPLY  "$'\e[38;5;51m'"${spin[$2 % 8 + 1]}"$'\e[38;5;245m'" $dur  "$'\e[38;5;244m'"${target_of[$key]:-$key}")
    done
    block_of[$root]="$first ${#ops_ws}"
    picked+=("$name"$'\t'"$root")
  done
  # 並びは名前の順にして,AIが動くたびにリポジトリの行が入れ替わらないようにする
  for line in ${(o)picked}; do
    v=(${=block_of[${line#*$'\t'}]})
    sorted+=("${(@)ops_ws[v[1],v[2]]}")
  done
  ops_ws=("${sorted[@]}")
  return 0
}

# 作業ログ: 有益な出来事だけを新しいものを下に出す(いちばん新しい行は1文字ずつ打ち出し,判断待ちの間の承認待ちは脈打たせる)
__ops_log_lines() { # $1=行数 $2=コマ → ops_lg 配列
  local plain
  local -a p
  integer n=${#ops_log} c=${#ops_cached} take typed
  float now=$EPOCHREALTIME
  ops_lg=()
  (( n )) || return 0
  take=$(( $1 - 1 )); (( take > c )) && take=$c
  (( take > 0 )) && ops_lg=("${(@)ops_cached[c-take+1,c]}")
  typed=$(( (now - ops_newest_at) * 80 ))
  __ops_log_line "${ops_log[n]}" 0 1; plain=$REPLY
  if (( typed < ${#plain} )); then
    ops_lg+=($'\e[38;5;195m'"${plain[1,typed]}"$'\e[1;38;5;51m█')
  else
    __ops_log_line "${ops_log[n]}" 0 0
    p=("${(@ps:\t:)ops_log[n]}")
    [[ ${p[3]} == AWAIT && ${agent_prio[${p[2]}]:-} == 0 ]] && (( $2 / 3 % 2 )) && REPLY=${REPLY//$'\e[1;38;5;214m'/$'\e[1;38;5;94m'}
    ops_lg+=("$REPLY")
  fi
}

# SYSTEM の1つを,名前・バー・使用率の1行と補足の1行にして幅 $5 に収める
# バーは使った分を指標の色,残りを暗い灰色で引き,8割を超えたら使用率の数字を赤くして気づかせる
__ops_sys_cell() { # $1=色 $2=名前 $3=使用率(測れていなければ -) $4=補足 $5=幅 → reply=(1行目 2行目)
  local label sub
  integer bw=$(( $5 - 12 > 4 ? $5 - 12 : 4 )) filled pc
  if [[ $3 == <-> ]]; then
    filled=$(( ($3 * bw + 50) / 100 < bw ? ($3 * bw + 50) / 100 : bw ))
    pc=$(( $3 >= 80 ? 203 : 255 ))
    label=$3%
  else
    filled=0 pc=255 label=-
  fi
  __vis "$4"
  if (( REPLY > $5 - 7 )); then
    __vis_cut "$4" $(( $5 - 7 ))
    sub=$REPLY
  else
    sub=$4
  fi
  reply=(
    $'\e[38;5;'$1$'m■ \e[1;38;5;255m'"${(r:4:)2} "$'\e[0;38;5;'$1'm'"${(l:filled::━:):-}"$'\e[38;5;237m'"${(l:bw-filled::━:):-}"$'\e[1;38;5;'$pc'm'"${(l:5:)label}"$'\e[0m'
    $'\e[38;5;245m       '"$sub"$'\e[0m'
  )
}

# SYSTEM の2つを横に並べた2行を ops_sys に足す
__ops_sys_row() { # $1..$4=左の色・名前・使用率・補足 $5..$8=右の同じもの
  local lt ls
  integer cw=$(( (pane_cols - 2 - 4) / 2 ))
  __ops_sys_cell $1 $2 $3 "$4" $cw
  lt=${reply[1]} ls=${reply[2]}
  __vis "$lt"; lt+="${(l:cw-REPLY:: :):-}"
  __vis "$ls"; ls+="${(l:cw-REPLY:: :):-}"
  __ops_sys_cell $5 $6 $7 "$8" $cw
  __ops_frame_line " $lt   ${reply[1]}"; ops_sys+=("$REPLY")
  __ops_frame_line " $ls   ${reply[2]}"; ops_sys+=("$REPLY")
}

# SYSTEM(負荷を添えた区切りの1行と,CPU・GPU・メモリ・ストレージを2つずつ並べた4行)を ops_sys に作る
__ops_sys() {
  ops_sys=()
  __ops_frame_mid 'SYSTEM' "LOAD ${sys[load]:--}"; ops_sys+=("$REPLY")
  __ops_sys_row 80 CPU "${sys[cpu]:--}" "${sys[cpu_sub]:--}" 141 GPU "${sys[gpu]:--}" "${sys[gpu_sub]:--}"
  __ops_sys_row 108 MEM "${sys[mem]:--}" "${sys[mem_sub]:--}" 179 DISK "${sys[disk]:--}" "${sys[disk_sub]:--}"
}

# 余白 $1 行に収まる枠を ops_panel に作る(ワークスペースは要る分だけ,多くても半分まで,残りを作業ログに使う)
# 最下部の SYSTEM(5行)は,それを除いても今までの最小の枠(6行)が残る時だけ出す
__ops_panel() { # $1=行数 $2=コマ
  local -a out
  integer h=$1 sh=$(( $1 >= 11 ? 5 : 0 )) wh lh i agents_n=0
  local key
  # ペインの幅が変わった・作っておいたより高くなったら,作業ログの行を今の大きさで作り直す
  (( ops_cache_cols == pane_cols && ops_cache_rows >= pane_rows )) || __ops_cache_log
  for key in $agent_keys; do [[ -n ${ag_last[$key]:-} ]] && (( ++agents_n )); done
  __ops_ws $(( (h - sh - 3) / 2 )) $2
  wh=${#ops_ws}
  lh=$(( h - sh - 2 - (wh ? wh + 1 : 0) ))
  if (( wh )); then
    __ops_frame_top 'WORKSPACE' "$ops_repo_count REPOS / $agents_n GHOSTS"; out=("$REPLY")
    for (( i = 1; i <= wh; i++ )); do __ops_frame_line "${ops_ws[i]}"; out+=("$REPLY"); done
    __ops_frame_mid 'OPS.LOG' "${#ops_log} EVENTS / 1h"; out+=("$REPLY")
  else
    __ops_frame_top 'OPS.LOG' "${#ops_log} EVENTS / 1h"; out=("$REPLY")
  fi
  __ops_log_lines $lh $2
  for (( i = 1; i <= lh - ${#ops_lg}; i++ )); do __ops_frame_line ''; out+=("$REPLY"); done
  for (( i = 1; i <= ${#ops_lg}; i++ )); do __ops_frame_line "${ops_lg[i]}"; out+=("$REPLY"); done
  if (( sh )); then
    # SYSTEM の値が変わるのは裏の一覧を取り込んだ時だけなので,その時とペインの幅が変わった時だけ作り直す
    if [[ $ops_sys_key != "$pane_cols $render_seq" ]]; then
      __ops_sys
      ops_sys_key="$pane_cols $render_seq"
    fi
    out+=("${ops_sys[@]}")
  fi
  __ops_frame_bottom; out+=("$REPLY")
  ops_panel=("${out[@]}")
}

# 描画済みの内容(lines)をペインに収めて出す(作業中の行は回し,判断待ちの行は脈打たせる)
# 1秒10コマで呼ぶため,ペインの高さは大きさが変わり得る時(size_stale: WINCH・手元で配置を変えた時と,
# WINCHを取りこぼしても直るよう裏の一覧を取り込むたび(約1秒ごと))だけ聞き直す
__draw() {
  local size
  integer f top nl

  if (( size_stale )); then
    # 端末の縦幅はtmuxが続けてペインの大きさを変えると最大0.25秒遅れて届き,古い縦幅で描くと溢れた分だけ
    # 表示が上にずれるため,tmuxの中では大きさを変えた時点で変わるペインの高さを使う
    [[ -z ${TMUX_PANE:-} ]] || size=$(tmux display -p -t "$TMUX_PANE" '#{pane_height} #{pane_width}' 2>/dev/null || true)
    # tput lines はstdoutもstderrも端末でないと実際の縦幅が取れず既定の24を返すため,端末に直接聞く
    [[ -n $size ]] || size=$(stty size </dev/tty 2>/dev/null || print '24 80')
    pane_rows=${size%% *}
    pane_cols=${size##* }
    size_stale=0
  fi
  # 閃光: 状態が変わってから0.4秒,STATUSを反転させて2度点滅させる(このコマだけなので一覧の写しに付ける)
  local -a lines=("${lines[@]}")
  local id
  integer age i
  # 一括終了・一括再起動の確かめを出している間は,見出しを確かめの文に差し替える
  [[ -z $confirm_action ]] || lines[1]=$confirm_prompt
  for id in ${(k)flash_at}; do
    age=$(( (EPOCHREALTIME - flash_at[$id]) * 10 ))
    if (( age >= 4 )); then
      unset "flash_at[$id]"
      continue
    fi
    i=${line_of[$id]:-0}
    (( i && age != 2 )) || continue
    if [[ ${lines[i]} == *'● '* ]]; then
      lines[i]=${lines[i]/● /$'\e[7m'● }
    else
      lines[i]=${lines[i]/○ /$'\e[7m'○ }
    fi
  done
  __compose_screen "$pane_rows"
  # コマは時刻から決め,キーを押して描き直しが増えても速さが変わらないようにする
  f=$(( EPOCHREALTIME * 10 ))
  out=${out//● Working/${spin[f % ${#spin} + 1]} Working}
  out=${out//● Input/${pulse[f / 2 % ${#pulse} + 1]} Input}
  # Space で出している間,一覧が収まって下に7行以上(空行1行と枠の6行)余る時は,余白に作業の見える化を出す(下に開いて一覧を縮め,余白が足りない時は出ない)
  # 枠の上端は,一覧の下に空行を1行置いた位置か上から ops_top_pct %の位置の低い方にする(枠の6行は残す)
  if (( show_ops && ${#lines} + 7 <= pane_rows )); then
    top=$(( pane_rows * ops_top_pct / 100 ))
    (( top > ${#lines} )) || top=$(( ${#lines} + 1 ))
    (( top <= pane_rows - 6 )) || top=$(( pane_rows - 6 ))
    __ops_panel $(( pane_rows - top )) $f
    # 一覧の最後の行を終える改行と,枠までの空行の分
    nl=$(( top - ${#lines} + 1 ))
    out+=${(pl:nl::\n:):-}"${(pj:\n:)ops_panel}"
  fi
  # 何も動いていない時に端末へ書き続けないよう,前のコマと大きさも中身も同じなら書き直さない
  [[ "$pane_rows $pane_cols"$'\n'$out != "$drawn" ]] || return 0
  drawn="$pane_rows $pane_cols"$'\n'$out
  # 1コマを書き終えるまでtmuxにペインを出させず,消してから描き直す途中の姿を見せない
  printf '\e[?2026h\e[H\e[J%s\e[?2026l' "$out"
}

# 次(1)/前(-1)の選択できるペインIDを返す(未選択ならC-nは先頭から,C-pは末尾から始める)
__step_selection() {
  local direction current
  integer n idx

  direction=$1
  current=$2
  shift 2
  n=$#

  (( n )) || return 0

  idx=${@[(ie)$current]}
  if (( direction > 0 )); then
    (( idx > n )) && idx=0
    print -r -- "${@[idx % n + 1]}"
  else
    (( idx > n )) && idx=1
    print -r -- "${@[(idx - 2 + n) % n + 1]}"
  fi
}

# d・C-d・Space でAIを起動する先のtmuxセッション(--session で指定,無ければこのai-bridgeがいるセッション)
start_session=''
if [[ ${1:-} == --session ]]; then
  if (( $# < 2 )) || ! tmux has-session -t "=$2" 2>/dev/null; then
    print -r -- "ai-bridge: --session requires an existing tmux session name" 1>&2
    exit 1
  fi
  start_session=$2
fi

if [[ ${1:-} == --once ]]; then
  # データ行は,頭の優先度・キー・TARGETと,後ろに添えたメモを外して出す
  __render | while IFS= read -r line; do print -r -- "${${${${line#*$'\t'}#*$'\t'}#*$'\t'}%%$'\t'*}"; done
  exit 0
fi

# watch表示(一覧は裏で1秒ごとに組み立て,ここでは1秒10コマで描き直す, Escで終了)
# 代替画面を使う(通常バッファに上書きし続けると溢れた分がペインのスクロールになり,
# iTerm2は既定でalternate screenから流れた行をscrollbackへ送るため端末側の表示がずれていく)
# 下に開いたAIを入れ替えたまま残さないよう,終了時(ペインやウィンドウを閉じた時も含む)に元の配置へ戻し,裏の組み立ても止める
# 下に開いたAIから一覧へ戻ったことや,ウィンドウを移ってから一覧へ戻ったことを知るため,フォーカスの出入りも通知させる
# (tmuxのfocus-eventsがonの時だけ届く)
last_swap=()
dir_panes=()
left_window=0
gen=0
need_render=0
size_stale=1
drawn=''
render_seq=''
render_pid=''
quick_gen=''
# 裏で組み立てた一覧(1行目に SYSTEM の値も載せる)と,手元で変えた中身(世代・作業の見える化を出しているか・下に開いたAI)を受け渡す場所
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/ai-bridge.XXXXXX")
render_file=$work_dir/rendered
ctl_file=$work_dir/ctl
# 手元で中身を変えた時に,裏ですぐ組み立てさせた一覧を受け取る場所
quick_file=$work_dir/quick
__write_ctl
# C-y は macOS の端末では遅延サスペンド(dsusp)に割り当てられていて,読んだ時点でこのai-bridgeが止まるため,動いている間だけ外す
stty_saved=$(stty -g 2>/dev/null || true)
stty dsusp undef 2>/dev/null || true
# ペインを閉じた時は描き直しや停止が失敗し得るが,set -e で後片付けが途中で止まらないよう失敗しても続ける
# 拡張キーは止めずに終えると,閉じた後のシェルにも Shift+Enter 等が拡張キーの並びのまま届くため止める
# シェルから起動したペインを閉じた時(x・X が上のai-bridgeを閉じる時も)は,後片付けの途中にもシグナルが届いて rm が止められ,一時ディレクトリが残るため,
# 1つ目のシグナルを受けた時と後片付けの初めに INT・TERM・HUP を無視する(無視は後片付けで起こすコマンドにも引き継がれる)
trap 'trap "" INT TERM HUP; __undo_swap || true; [[ -z $render_pid ]] || kill $render_pid 2>/dev/null || true; rm -rf -- "$work_dir"; [[ -z $stty_saved ]] || stty "$stty_saved" 2>/dev/null || true; printf "\e[?2026l\e[?1004l\e[>4m\e[?7h\e[?25h\e[?1049l"' EXIT
trap 'trap "" INT TERM HUP; exit 0' INT TERM HUP
# ペインの大きさが変わったら,次のコマで高さを聞き直す
trap 'size_stale=1' WINCH
# C-; は普段 ; として届き見分けられないため,tmux に拡張キーのモード1を頼み \e[27;5;59~ で受け取る
# (モード1は C-n 等の決まった並びがあるキーを変えないが,モード2は C-n まで変えてしまう)
printf '\e[?1049h\e[?7l\e[?25l\e[?1004h\e[>4;1m'

# iTerm2のウィンドウをまたいだジャンプはmacOSのAppleScriptで行うため,macOS以外やtmuxの外では選択自体を無効にする
if [[ $OSTYPE == darwin* && -n ${TMUX:-} ]] && (( $+commands[osascript] )); then
  selectable=1
else
  selectable=0
fi
selected_id=''
launched_id=''
scroll_top=1

# 最初の一覧は裏の組み立てを待たずにその場で出す
rendered=("${(@f)$(__render)}")
__split_rendered
__ops_load
__render_loop >/dev/null 2>&1 &
render_pid=$!

while :; do
  # 中身を変えた時にすぐ組み立てさせた一覧は,組み立て終えた後も中身を変えていなければ(世代が今と同じなら)取り込む
  # (裏の1秒ごとの一覧も今の世代で届いていれば,この後でそちらに置き換わる)
  if [[ -n $quick_gen && $quick_gen == "$gen" && -r $quick_file ]] && read -r new_gen < "$quick_file" && [[ $new_gen == "$gen" ]]; then
    rendered=("${(@f)$(<"$quick_file")}")
    rendered[1]=()
    quick_gen=''
    __split_rendered
    __ops_load
  fi
  # 裏で組み立て終えた一覧のうち,手元で最後に中身を変えた後に組み立てたもの(世代が今と同じもの)だけを取り込む
  # (起動直後は裏がまだ一覧を書いていないので,ファイルがある時だけ読む)
  if [[ -r $render_file ]] && read -r new_seq new_gen new_sys < "$render_file" && [[ $new_seq != "$render_seq" && $new_gen == "$gen" ]]; then
    rendered=("${(@f)$(<"$render_file")}")
    rendered[1]=()
    render_seq=$new_seq
    # すぐ組み立てさせた一覧は,この後に届いてもこちらより古いことがあり,状態が一瞬戻るので取り込まない
    quick_gen=''
    # 1行目の世代の後ろに裏が載せた SYSTEM の値(名前=値 のタブ区切り)を写す
    sys=()
    for kv in ${(ps:\t:)new_sys}; do sys[${kv%%=*}]=${kv#*=}; done
    __split_rendered
    __ops_load
    # WINCHを取りこぼしてもペインの大きさが直るよう,取り込むたび(約1秒ごと)に聞き直す
    size_stale=1
  fi
  __draw

  if [[ -t 0 ]]; then
    # 押したキーがエコーされると,カーソルのある画面右下に ^N 等が次の再描画まで残るため -s で抑える
    if read -s -t 0.1 -k 1 key 2>/dev/null; then
      # 終了・再起動の確かめを出している間は,y で実行し,それ以外のキーでは取り消すだけにする
      # (Esc で始まるもの(単独のEsc・フォーカスの出入り等)は下の Esc の扱いで取り消す)
      if [[ -n $confirm_action && $key != $'\e' ]]; then
        if [[ $key == y ]]; then
          case $confirm_action in
            exit)
              # 入れ替えて下に開いているAI(とその相手)は,閉じると入れ替えた相手が元の場所に残るため,先に元へ戻す
              if (( ${#last_swap} )) && (( ${exit_targets[(Ie)${last_swap[1]}]} || ${exit_targets[(Ie)${last_swap[2]}]} )); then
                __undo_swap
              fi
              __exit_and_close_agents "${exit_targets[@]}" &!
              ;;
            restart)
              for id in "${restart_targets[@]}"; do
                __restart_agent "$id" "${restart_command[$id]}" &!
              done
              ;;
            save)
              # 保存するものが無い時に y を押しても,前に保存したものを空で消さない
              (( ! ${#save_lines} )) || __save_agents
              ;;
            restore)
              __restore_agents
              ;;
          esac
        fi
        confirm_action=''
        key=''
      fi
      case $key in
        $'\e')
          was_confirming=$(( ${#confirm_action} > 0 ))
          confirm_action=''
          # 矢印キー等はEscに続く文字と一緒に届くため,単独のEscの時だけ終了する
          # (一括終了・一括再起動の確かめを出していた時の単独のEscは,確かめを取り消すだけで一覧は閉じない)
          if ! read -s -t 0.05 -k 1 rest 2>/dev/null; then
            (( was_confirming )) || break
            continue
          fi
          # ESC [ で始まる列は終端の文字(@〜~)まで読む(直後に届いたキーまで読み捨てないよう終端で止める)
          esc_seq=$rest
          if [[ $rest == '[' ]]; then
            rest=''
            while [[ $rest != [@-~] ]] && read -s -t 0.01 -k 1 rest 2>/dev/null; do
              esc_seq+=$rest
            done
          fi
          # フォーカスが外れた(\e[O)時,この一覧のウィンドウがカレントでなくなっていればウィンドウを移ったと覚えておく
          # (アプリの切り替えではカレントのウィンドウが変わらないので,そこから戻ってもC-lで開いたウィンドウは閉じない)
          if [[ $esc_seq == '[O' ]] && (( ${#dir_panes} )) && [[ $(tmux display -p -t "${TMUX_PANE:-}" '#{window_active}' 2>/dev/null) == 0 ]]; then
            left_window=1
          fi
          # フォーカスが戻った(\e[I)時,直前にいたペインが下に開いたAIなら作業を終えたとみなして C-s で閉じた時と同じく元に戻す
          # 描画中に届いて遅れて処理しても判定がずれないよう,印を持たずにその時点のtmuxの「直前のペイン」で決める
          # (別のウィンドウから入れ替えたAIは入れ替えた時点では履歴に載らないため,ウィンドウやアプリの切り替えから戻っても閉じない)
          if [[ $esc_seq == '[I' ]] && (( ${#last_swap} )) && [[ $(tmux display -p -t "${last_swap[1]}" '#{pane_last}' 2>/dev/null) == 1 ]]; then
            __undo_swap
          fi
          # ウィンドウを移ってから戻った時は,C-lで開いたウィンドウのうちシェルに戻っているものを閉じる
          if [[ $esc_seq == '[I' ]]; then
            (( ! left_window )) || __close_dir_window
            left_window=0
          fi
          # C-; は C-k と同じものを開き,最後の返答が画面の上へ流れていればその冒頭から読めるようにする
          # (一括終了・一括再起動の確かめを出していた時は,ほかのキーと同じく確かめを取り消すだけにする)
          if [[ $esc_seq == '[27;5;59~' ]] && (( ! was_confirming )); then
            open_id=${selected_id:-$attention_id}
            if (( selectable )) && [[ -n $open_id ]]; then
              __open_and_focus_below "$open_id" --last-reply
            fi
          fi
          ;;
        $'\x0e' | $'\x10') # Ctrl+n / Ctrl+p
          # 選択を1つ動かす(C-s で下に開いている間は,動かした先も下に開いて開いたまま移る)
          if (( selectable )); then
            if [[ $key == $'\x0e' ]]; then step=1; else step=-1; fi
            selected_id=$(__step_selection $step "$selected_id" "${jump_ids[@]}")
            if (( ${#last_swap} )) && [[ -n $selected_id ]]; then
              # 下に開くAIを替える(tmuxを10回ほど呼ぶ)より先に,選択の表示を動かして見せる
              __split_rendered
              __draw
              __open_below "$selected_id"
              __mark_below_seen
            fi
          fi
          ;;
        $'\x13') # Ctrl+s
          # 下に開いていれば閉じて元に戻し,閉じていれば選んでいるAIを下に開く
          # 開いた時は C-k と同じく見たとみなして完了を待機へ戻す(判断待ちは戻さない)
          if (( selectable )); then
            if (( ${#last_swap} )); then
              __undo_swap
            elif [[ -n $selected_id ]]; then
              browse_order=("${agent_keys[@]}")
              __open_below "$selected_id"
              __mark_below_seen
            fi
          fi
          ;;
        $'\x0b') # Ctrl+k
          # 未選択なら判断待ち,無ければ完了のうち一番上を開く(選択は変えないので,次も一番上から選び直す)
          open_id=${selected_id:-$attention_id}
          if (( selectable )) && [[ -n $open_id ]]; then
            __open_and_focus_below "$open_id"
          fi
          ;;
        [1-9])
          if (( selectable && key <= ${#jump_ids} )); then
            selected_id=${jump_ids[key]}
            __open_and_focus_below "$selected_id"
          fi
          ;;
        $'\n' | $'\r')
          if (( selectable )) && [[ -n $selected_id ]]; then
            # 下に開いているAIや,それと入れ替わったAIは元の位置へ戻してから移る
            if [[ $selected_id == "${last_swap[1]:-}" || $selected_id == "${last_swap[2]:-}" ]]; then
              __undo_swap
            fi
            __jump "$selected_id"
          fi
          ;;
        $'\x0c') # Ctrl+l
          if (( selectable )) && [[ -n $selected_id ]]; then
            __open_dir_window "$selected_id"
          fi
          ;;
        $'\x19') # Ctrl+y
          if (( selectable )) && [[ -n $selected_id ]]; then
            __copy_target "$selected_id"
          fi
          ;;
        g)
          if (( selectable )) && [[ -n $selected_id ]]; then
            __run_in_repo "$selected_id" __browse_repo
          fi
          ;;
        $'\x07') # Ctrl+g
          if (( selectable )) && [[ -n $selected_id ]]; then
            __run_in_repo "$selected_id" __open_pr
          fi
          ;;
        m)
          if (( selectable )) && [[ -n $selected_id ]]; then
            __move_window "$selected_id"
          fi
          ;;
        i)
          # MODEL から後ろの列と,+ で書いたメモ(INFO)を切り替える(一覧の中身は変えないので,この後の __split_rendered で作り直すだけ)
          if (( selectable )); then
            info_view=$(( ! info_view ))
          fi
          ;;
        +)
          if (( selectable )) && [[ -n $selected_id ]]; then
            __edit_info "$selected_id"
          fi
          ;;
        -)
          if (( selectable )) && [[ -n $selected_id ]]; then
            __remove_info "$selected_id"
          fi
          ;;
        $'\x15') # Ctrl+u
          selected_id=''
          ;;
        '?')
          # 見出しを,いつものもの(時刻つき)と key_help の3つのキーの説明の順に切り替える
          if (( selectable )); then
            show_keys=$(( (show_keys + 1) % (${#key_help} + 1) ))
          fi
          ;;
        a)
          # 作業の見える化(WORKSPACE・OPS.LOG・SYSTEM)を出す・消す
          # 裏が出している間だけ SYSTEM の値を測るよう伝える(一覧の中身は変えないので世代は上げない)
          show_ops=$(( ! show_ops ))
          __write_ctl
          ;;
        d)
          # zsh の C-d と同じく,メインのAI(AI_AGENT_WITH_OPT)を,ghq のリポジトリを選んでそこで起動する(選ぶ画面は小窓に出し,このペインからは動かない)
          if (( selectable )); then
            __start_agent_in_repo "${AI_AGENT_WITH_OPT:-claude}"
          fi
          ;;
        $'\x04') # Ctrl+d
          # zsh の C-s,C-d と同じく,サブのAI(AI_SUB_AGENT_WITH_OPT)を,ghq のリポジトリを選んでそこで起動する
          if (( selectable )); then
            __start_agent_in_repo "${AI_SUB_AGENT_WITH_OPT:-codex}"
          fi
          ;;
        ' ')
          # zsh の C-s,Space と同じく,保存済みのセッションを選んで起動する(選ぶ画面は小窓に出し,このペインからは動かない)
          if (( selectable )); then
            __start_saved_agent
          fi
          ;;
        '\')
          # zsh の C-s,\ と同じく,保存済みのセッションを選んで一覧のファイルを編集する(選ぶ画面もエディタも小窓に出し,このペインからは動かない)
          if (( selectable )); then
            __edit_saved_session
          fi
          ;;
        X)
          # 一覧に出ているtmux内のAIを一括で終了させる前に,対象と作業中と対象外(tmux外で送れない)の数を見出しに出して確かめる
          # 作業中のAIは実行中のコマンドごと中断されるため,その数も出す
          if (( ${#jump_ids} )); then
            exit_targets=("${jump_ids[@]}")
            exit_working=0
            __priority_for working
            for id in "${exit_targets[@]}"; do
              [[ ${agent_prio[$id]:-} != "$REPLY" ]] || exit_working+=1
            done
            confirm_prompt=$'\e[1;97;41m'"AI Bridge  Exit ${#exit_targets} AI(s) with Ctrl-C ($exit_working working, $(( ${#agent_keys} - ${#exit_targets} )) outside tmux skipped)? y/N"$'\e[0m'
            confirm_action=exit
          fi
          ;;
        x)
          # 選んでいるtmux内のAIを1つ終了させる前に,対象と,作業中ならそのこと(実行中のコマンドごと中断される)を見出しに出して確かめる
          if (( selectable )) && [[ -n $selected_id ]]; then
            exit_targets=("$selected_id")
            exit_note=''
            __priority_for working
            [[ ${agent_prio[$selected_id]:-} != "$REPLY" ]] || exit_note=' (working)'
            confirm_prompt=$'\e[1;97;41m'"AI Bridge  Exit ${target_of[$selected_id]:-$selected_id} with Ctrl-C${exit_note}? y/N"$'\e[0m'
            confirm_action=exit
          fi
          ;;
        E)
          # 一覧に出ているtmux内のAIのうち,再起動してよいと確かめられたものだけを選び,対象と飛ばした数(理由ごと)を見出しに出して確かめる
          if (( ${#jump_ids} )); then
            __plan_restart all
            confirm_action=restart
          fi
          ;;
        e)
          # 選んでいるtmux内のAIを1つ,E と同じく再起動してよいと確かめられた時だけ再起動する(できない時は理由を見出しに出す)
          if (( selectable )) && [[ -n $selected_id ]]; then
            __plan_restart one
            confirm_action=restart
          fi
          ;;
        O)
          # tmux-resurrect の保存のように,一覧に出ているtmux内のAIを R で開き直せるよう保存する前に,数と飛ばした数を見出しに出して確かめる
          if (( selectable )); then
            __plan_save
            confirm_action=save
          fi
          ;;
        R)
          # O で保存したAIを $TMUX_AI_SESSION のセッション(無ければ作る)に開き直す前に,数と飛ばした数を見出しに出して確かめる
          if (( selectable )); then
            __plan_restore
            confirm_action=restore
          fi
          ;;
      esac
      # 下に開いた等で中身が変わった時は,裏の1秒ごとの組み立てを待たずにすぐ組み立てさせ,選択の表示はその場で作り直す
      if (( need_render )); then
        __render_soon
        need_render=0
      fi
      __split_rendered
      __ops_load
    fi
  else
    sleep 1
  fi
done
