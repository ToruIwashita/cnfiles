{
  "description": "Codexのセッション状態をai-agent-list用に記録する。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "/usr/bin/printf '%s\\n' \"シェルコマンドは原則として zsh -lc '<command>' でログインzsh内から実行し,すでにログインzsh内の場合は二重にラップせず,zsh以外のシェルが明示的に必要な場合はその指定を優先する\"",
            "statusMessage": "Loading zsh shell instructions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex PostToolUse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex PermissionRequest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-agent-state codex SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
