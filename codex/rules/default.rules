# Claudeのsandbox.excludedCommandsを移植。競合時は下記のforbiddenが優先される。
# 文字列ワイルドカードではなく、コマンド名・サブコマンド単位で一致させる。
prefix_rule(
    pattern = [["tmux", "bundle", "ps", "top", "gis", "gpr", "gh", "pbcopy"]],
    decision = "allow",
    match = [
        "tmux list-sessions",
        "tmux send-keys -t session:1.1 text Enter",
        "bundle exec ruby -v",
        "ps aux",
        "top -l 1",
        "gis --help",
        "gpr --help",
        "gh pr view 123",
        "pbcopy",
    ],
    not_match = ["bundler exec ruby -v", "pbcopy-other"],
)

prefix_rule(
    pattern = ["git", ["fetch", "pull", "status", "commit", "rebase"]],
    decision = "allow",
    match = ["git fetch origin", "git pull --ff-only", "git status --short", "git commit -m message", "git rebase --autosquash main"],
    not_match = ["git push origin main", "git fetch-other"],
)

# e2e-queue の運用用の clone は sandbox から読めない場所に置くため,依頼側の2つだけを sandbox の外で動かす（実行係は人が起動する）
prefix_rule(
    pattern = [["e2e-request", "e2e-wait"]],
    decision = "allow",
    match = ["e2e-request -s 01_login", "e2e-wait 20261014-101500-12345"],
    not_match = ["e2e-requester", "e2e-worker"],
)

prefix_rule(
    pattern = [["sudo", "rm", "rmdir"]],
    decision = "forbidden",
    justification = "These commands are denied by the shared local safety policy.",
    match = [
        "sudo true",
        "rm file.txt",
        "rmdir empty-directory",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "Pull request merges are denied by the shared local safety policy.",
    match = ["gh pr merge 123"],
)

prefix_rule(
    pattern = ["git", ["-C", "push"]],
    decision = "forbidden",
    justification = "These Git operations are denied by the shared local safety policy.",
    match = [
        "git -C /tmp/repository status",
        "git push origin main",
    ],
    not_match = [
        "git status",
        "git pull",
        "git rm file.txt",
        "git rebase main",
    ],
)

# pre-push フック(git-protect-push)を飛ばす push を止める
# 先頭からの一致しか書けないため,--no-verify を後ろに置いた形は上の git push の禁止だけが止める
prefix_rule(
    pattern = ["git", "push", "--no-verify"],
    decision = "forbidden",
    justification = "Pushing without the pre-push hooks is denied by the shared local safety policy.",
    match = ["git push --no-verify origin main"],
    not_match = ["git pull --no-verify"],
)

# gsh は --no-verify で push するシェル関数のため使わせない
prefix_rule(
    pattern = ["gsh"],
    decision = "forbidden",
    justification = "gsh pushes without the pre-push hooks and is denied by the shared local safety policy.",
    match = ["gsh", "gsh -f"],
    not_match = ["gsh-tags"],
)

prefix_rule(
    pattern = [["curl", "wget", "nc", "ncat", "socat", "ssh", "scp", "sftp", "rsync", "ftp", "telnet", "dig", "nslookup", "host"]],
    decision = "forbidden",
    justification = "Direct network commands are denied by the shared local safety policy.",
    match = [
        "curl https://example.com",
        "ssh example.com",
        "dig example.com",
    ],
)

prefix_rule(
    pattern = [["security", "env", "printenv"]],
    decision = "forbidden",
    justification = "Credential and environment inspection commands are denied by the shared local safety policy.",
    match = [
        "security find-generic-password -s example",
        "env",
        "printenv PATH",
    ],
)
