[user]
  name = ToruIwashita
  email = toru.iwashita@gmail.com

[core]
  editor = vim
  quotepath = false
  attributesfile = ~/.gitattributes
  excludesfile = ~/.gitignore

[init]
  defaultBranch = main

[status]
  short = true

[fetch]
  prune = true

[rebase]
  autostash = true

[push]
  default = simple

[hook "protect-push"]
  event = pre-push
  command = ~/local/bin/git-protect-push

[diff]
  compactionheuristic = true

[ghq]
  root = ~/repos

[include]
  path = ~/.gitconfig.local
